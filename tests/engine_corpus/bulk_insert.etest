# BULK INSERT — engine surface, not SQL semantics.
#
# The SQLite corpus contains zero BULK INSERT statements and always will: it is a
# conformance corpus for a database, and a load from a file is not SQL. Two defects
# landed here in v0.18.0 with nothing to catch them, both of the same shape — the
# load accepted the data and produced a wrong table rather than an error.
#
# Behaviour recorded here is what the engine does today. Where that is a trap rather
# than a decision, the record says so.

file staff.csv
ID,Name,Dept
1,Ann,Engineering
2,Bob,Operations
3,Cy,Support
----

statement ok
CREATE TABLE #staff (id INT, name VARCHAR(50), dept VARCHAR(50));

statement ok
BULK INSERT #staff FROM '${dir}\staff.csv' WITH (FIELDTERMINATOR = ',', FIRSTROW = 2);

query
SELECT id, name, dept FROM #staff ORDER BY id;
----
1|Ann|Engineering
2|Bob|Operations
3|Cy|Support

# FIRSTROW is how a header is skipped, matching T-SQL. Omitting it loads the header as
# data. Whether that is caught depends entirely on the target's type: against an INT
# column the header text fails conversion and the load stops, which is the good case
# and worth pinning — the value and the column are both named.

statement ok
CREATE TABLE #staff_noskip (id INT, name VARCHAR(50), dept VARCHAR(50));

statement error cannot be converted to target type INT
BULK INSERT #staff_noskip FROM '${dir}\staff.csv' WITH (FIELDTERMINATOR = ',');

# Against text columns nothing is out of range, so the same mistake is silent: three
# rows become four and the extra one is the header. Type checking is the only thing
# standing between a forgotten FIRSTROW and a quietly wrong table.

statement ok
CREATE TABLE #staff_text (id VARCHAR(10), name VARCHAR(50), dept VARCHAR(50));

statement ok
BULK INSERT #staff_text FROM '${dir}\staff.csv' WITH (FIELDTERMINATOR = ',');

query
SELECT COUNT(*) FROM #staff_text;
----
4

query
SELECT id FROM #staff_text ORDER BY id;
----
1
2
3
ID

# When the file has a header, columns pair by NAME. A file whose columns are in a
# different order than the target therefore lands correctly, where positional pairing
# would have loaded it transposed with no error whenever the types were compatible.
#
# This diverges from T-SQL, which pairs strictly by ordinal and needs a format file to
# do anything else. It matches SqlBulkCopyColumnMapping, which pairs by name or ordinal
# — the same vendor's convention one layer up, and the right one for a tool whose input
# usually has a header.

file wrong_order.csv
Dept,Name,ID
Engineering,Ann,1
----

statement ok
CREATE TABLE #reordered (id VARCHAR(20), name VARCHAR(50), dept VARCHAR(50));

statement ok
BULK INSERT #reordered FROM '${dir}\wrong_order.csv' WITH (FIELDTERMINATOR = ',', FIRSTROW = 2);

query
SELECT id, name, dept FROM #reordered;
----
1|Ann|Engineering

# MAPPING = 'POSITION' restores T-SQL's ordinal pairing for ported scripts. Same file,
# same target, transposed result — which is what positional pairing means here.

statement ok
CREATE TABLE #forced_positional (id VARCHAR(20), name VARCHAR(50), dept VARCHAR(50));

statement ok
BULK INSERT #forced_positional FROM '${dir}\wrong_order.csv'
WITH (FIELDTERMINATOR = ',', FIRSTROW = 2, MAPPING = 'POSITION');

query
SELECT id, name, dept FROM #forced_positional;
----
Engineering|Ann|1

# Fewer source columns than targets leaves the remainder NULL. This one is deliberate
# and has its own unit test asserting it; recorded so a change to it is visible here too.

file short.csv
1,Ann
----

statement ok
CREATE TABLE #short (id INT, name VARCHAR(50), dept VARCHAR(50));

statement ok
BULK INSERT #short FROM '${dir}\short.csv' WITH (FIELDTERMINATOR = ',');

query
SELECT id, name, dept FROM #short;
----
1|Ann|NULL

# More source columns than targets drops the surplus, equally silently.

file wide.csv
1,Ann,Engineering,extra,more
----

statement ok
CREATE TABLE #narrow (id INT, name VARCHAR(50));

statement ok
BULK INSERT #narrow FROM '${dir}\wide.csv' WITH (FIELDTERMINATOR = ',');

query
SELECT id, name FROM #narrow;
----
1|Ann

# Non-comma terminators.

file pipes.txt
1|Ann|Engineering
2|Bob|Operations
----

statement ok
CREATE TABLE #piped (id INT, name VARCHAR(50), dept VARCHAR(50));

statement ok
BULK INSERT #piped FROM '${dir}\pipes.txt' WITH (FIELDTERMINATOR = '|');

query
SELECT id, name, dept FROM #piped ORDER BY id;
----
1|Ann|Engineering
2|Bob|Operations

# A blank or empty field is NULL, whatever the target type. This is T-SQL's KEEPNULLS
# promoted from opt-in to default: a blank field in an extract means "no value", and
# leaving it as '' both hides it from IS NULL and still fails conversion to any numeric
# column. Previously the same two commas produced an empty string against text and a
# hard error against a number — identical bytes, two different outcomes.

file blanks.csv
1,,Engineering
----

statement ok
CREATE TABLE #blanks (id INT, name VARCHAR(50), dept VARCHAR(50));

statement ok
BULK INSERT #blanks FROM '${dir}\blanks.csv' WITH (FIELDTERMINATOR = ',');

query
SELECT id, name, dept FROM #blanks;
----
1|NULL|Engineering

query
SELECT COUNT(*) FROM #blanks WHERE name IS NULL;
----
1

file blank_number.csv
1,,Engineering
----

statement ok
CREATE TABLE #blank_number (id INT, score INT, dept VARCHAR(50));

statement ok
BULK INSERT #blank_number FROM '${dir}\blank_number.csv' WITH (FIELDTERMINATOR = ',');

query
SELECT id, score, dept FROM #blank_number;
----
1|NULL|Engineering

# Whitespace-only counts as blank too: a padded export must not produce a value that is
# neither NULL nor meaningfully present.

file padded.csv
1,   ,Engineering
----

statement ok
CREATE TABLE #padded (id INT, score INT, dept VARCHAR(50));

statement ok
BULK INSERT #padded FROM '${dir}\padded.csv' WITH (FIELDTERMINATOR = ',');

query
SELECT COUNT(*) FROM #padded WHERE score IS NULL;
----
1

# A missing file is an error, not an empty load.

statement ok
CREATE TABLE #absent (id INT);

statement error
BULK INSERT #absent FROM '${dir}\does_not_exist.csv' WITH (FIELDTERMINATOR = ',');
