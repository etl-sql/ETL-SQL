-- Named datasets, including one the report never binds a visual to.
CREATE DATASET &sales AS (
  SELECT region, amount FROM pg.sales
);

CREATE DATASET &unused_reference AS (
  SELECT category, margin FROM pg.products
);

-- A name that does not start with a letter. Generation would write this as &v___private, so the
-- round trip must recognise the two as the same dataset and leave the author's spelling alone.
CREATE DATASET &_private AS (
  SELECT sku, cost FROM pg.inventory
);

CREATE VISUAL v_sales AS TABLE (
    TITLE = 'Sales',
    SOURCE = &sales
);

CREATE PAGE [Data] AS DASHBOARD (
    LAYOUT (STRUCTURE = 'A', MAP ('A' = v_sales))
);
