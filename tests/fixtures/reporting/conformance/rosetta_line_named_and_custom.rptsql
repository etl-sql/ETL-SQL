SELECT '2026-01-01' AS SessionDay, 42 AS Visits INTO #rosetta_line
UNION ALL SELECT '2026-01-02', 55
UNION ALL SELECT '2026-01-03', 48
UNION ALL SELECT '2026-01-04', 61;

-- The same chart authored twice: once as a named visual, once in the CHART grammar.
CREATE VISUAL RosettaLineNamed AS LINE (
  TITLE = 'Daily visits',
  SOURCE = #rosetta_line,
  MAPPINGS (X = SessionDay, Y = Visits),
  OPTIONS (AXIS_SORT = SOURCE)
);

CREATE VISUAL RosettaLineCustom AS CUSTOM (
  TITLE = 'Daily visits',
  SOURCE = #rosetta_line,
  CHART (
    COORDINATE (TYPE = CARTESIAN),
    SCALES (
      days = BAND (CHANNEL = X, INCLUDE_ZERO = OFF, ORDER = SOURCE),
      visits = LINEAR (CHANNEL = Y, INCLUDE_ZERO = ON)
    ),
    LAYERS (
      trend = LINE (
        ENCODINGS (
          X = SessionDay (TYPE = NOMINAL, SCALE = days),
          Y = Visits (TYPE = QUANTITATIVE, SCALE = visits)
        )
      )
    )
  )
);

CREATE PAGE Main AS DASHBOARD (STRUCTURE = 'A B', MAP ('A' = RosettaLineNamed, 'B' = RosettaLineCustom));
