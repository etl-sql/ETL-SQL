-- Payload Crossover Fixture: Temporal Events
-- High-frequency timestamped logging and event intervals

SET REPORT TITLE = 'Payload Crossover: Temporal Event Log';

SELECT
    '2026-02-01 08:00:00' AS EventTimestamp,
    'srv-cluster-node-01' AS Hostname,
    'HTTP_REQUEST' AS EventType,
    14.285 AS LatencyMs,
    200 AS HttpStatusCode
INTO #temporal_events
FROM (SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5) a
CROSS JOIN (SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5) b
CROSS JOIN (SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4) c;

CREATE VISUAL EventLogTable AS TABLE (
    TITLE = 'Cluster Server Request Log',
    SOURCE = #temporal_events
);

CREATE PAGE TemporalDashboard AS DASHBOARD (
    LAYOUT (
        STRUCTURE = 'A',
        MAP ('A' = EventLogTable)
    )
);
