# Deterministic standard-library boundaries and cross-dialect aliases.
# Keep volatile clock/random functions out of this exact-result corpus.

# Math: negative boundaries, midpoint rounding, powers, and safe division.
query IIII
SELECT CEILING(-1.2), FLOOR(-1.2), SIGN(-99), SIGN(0);
----
-1
-2
-1
0

query RRRR
SELECT ROUND(2.55, 1), SQRT(81), POWER(2, 10), MOD(-17, 5);
----
2.600
9.000
1024.000
-2.000

query III
SELECT SAFE_DIVIDE(9, 3), SAFE_DIVIDE(9, 0), SAFE_DIVIDE(9, 0, -1);
----
3
0
-1

query IIII
SELECT BITAND(6, 3), BITOR(4, 1), BITXOR(7, 3), BITSHIFTLEFT(3, 2);
----
2
5
4
12

# Date: leap year, month-end clamping, boundary crossing, and aliases.
query IIII
SELECT
  DATEPART(day, DATEADD(day, 1, '2024-02-28')),
  DATEPART(day, DATEADD(month, 1, '2024-01-31')),
  DATEDIFF(day, '2024-02-28', '2024-03-01'),
  DATE_PART(month, '2024-12-31');
----
29
29
2
12

query III
SELECT
  DATEPART(day, EOMONTH('2024-02-01')),
  DATEPART(month, START_OF_QUARTER('2024-05-19')),
  DATEPART(month, END_OF_QUARTER('2024-05-19'));
----
29
4
6

query III
SELECT YEAR('2000-02-29'), MONTH('2000-02-29'), DAY('2000-02-29');
----
2000
2
29

# String: empty, Unicode byte length, one-based indexing, padding, and aliases.
query III
SELECT CHARACTER_LENGTH(''), CHARACTER_LENGTH('é'), OCTET_LENGTH('é');
----
0
1
2

query TTTT
SELECT SUBSTRING('abcdef', 2, 3), SUBSTR('abcdef', 2, 3), LEFT('abcdef', 2), RIGHT('abcdef', 2);
----
bcd
bcd
ab
ef

query TT
SELECT LPAD('7', 3, '0'), RPAD('7', 3, '0');
----
007
700

query II
SELECT CHARINDEX('bc', 'abcd'), INSTR('abcd', 'bc');
----
2
2

# Logic/type aliases from MSSQL, Oracle, SQLite/Postgres-style surfaces agree in engine context.
query TTTT
SELECT ISNULL(NULL, 'x'), NVL(NULL, 'x'), IFNULL(NULL, 'x'), COALESCE(NULL, NULL, 'x');
----
x
x
x
x

query III
SELECT GREATEST(3, NULL, 8, 5), LEAST(3, NULL, 8, 5), NULLIF(4, 4) IS NULL;
----
8
3
1

query IT
SELECT TRY_CAST('42' AS INT), TRY_CAST('not-a-number' AS INT);
----
42
NULL

# Regex and JSON exact results, including missing-value behavior.
query ITI
SELECT REGEXP_LIKE('AbC123', '^[a-z]+[0-9]+$', 'i'),
       REGEXP_SUBSTR('a1 b22 c333', '[0-9]+', 1, 2),
       REGEXP_COUNT('a1 b22 c333', '[0-9]+');
----
1
22
3

query TTT
SELECT JSON_VALUE('{"a":{"b":7}}', '$.a.b'),
       JSON_VALUE('{"a":1}', '$.missing'),
       JSON_QUERY('{"a":[1,2]}', '$.a');
----
7
NULL
[1,2]

# Representative engine-dialect row limiting forms.
statement ok
CREATE TABLE dialect_rows(id INT);

statement ok
INSERT INTO dialect_rows VALUES (3), (1), (2);

query I
SELECT TOP 1 id FROM dialect_rows ORDER BY id DESC;
----
3

query I
SELECT id FROM dialect_rows ORDER BY id LIMIT 1;
----
1

# Bit shifts are lexer/parser/runtime operators, not two adjacent comparisons.
query II
SELECT 4 << 1, 4 >> 1;
----
8
2
