# MATCH_RECOGNIZE patterns

statement ok
CREATE TABLE stock_ticker(symbol STRING, tstamp INT, price DECIMAL(10,2));

statement ok
INSERT INTO stock_ticker VALUES
  ('AAPL', 1, 100.00),
  ('AAPL', 2, 99.00),
  ('AAPL', 3, 98.00),
  ('AAPL', 4, 102.00),
  ('AAPL', 5, 105.00),
  ('MSFT', 1, 50.00),
  ('MSFT', 2, 55.00);

# V-Shape Pattern Match
query TI
SELECT * FROM stock_ticker
MATCH_RECOGNIZE (
  PARTITION BY symbol
  ORDER BY tstamp
  MEASURES
    A.tstamp AS start_tstamp,
    LAST(DOWN.tstamp) AS bottom_tstamp,
    LAST(UP.tstamp) AS end_tstamp
  ONE ROW PER MATCH
  PATTERN (A DOWN+ UP+)
  DEFINE
    DOWN AS DOWN.price < PREV(DOWN.price),
    UP AS UP.price > PREV(UP.price)
) AS T ORDER BY symbol;
----
AAPL
1
3
5
