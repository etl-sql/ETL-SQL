# Type coercion and CAST behavior

# Integer literal division truncates (both operands have scale 0)
query I
SELECT 7 / 2;
----
3

# Decimal literal division returns real (7.0 has scale 1, so decimal division applies)
query R
SELECT 7.0 / 2;
----
3.500

# Integer division — negative truncates toward zero
query I
SELECT -7 / 2;
----
-3

# CAST integer to decimal
query R
SELECT CAST(7 AS DECIMAL) / 2;
----
3.500

# CAST string to integer
query I
SELECT CAST('42' AS INT);
----
42

# CAST string to decimal
query R
SELECT CAST('3.14' AS DECIMAL);
----
3.140

# CAST integer to string
query T
SELECT CAST(42 AS STRING);
----
42

# CAST string integer to INT — engine stores as decimal, formats without fraction
query I
SELECT CAST('3' AS INT);
----
3

# CAST decimal to INT truncates toward zero (does not round)
query I
SELECT CAST(3.9 AS INT);
----
3

query I
SELECT CAST(3.1 AS INT);
----
3

query I
SELECT CAST(-3.9 AS INT);
----
-3

# CAST to BIGINT also truncates
query I
SELECT CAST(9.7 AS BIGINT);
----
9

# Implicit string-to-number in arithmetic (numeric context)
query I
SELECT 10 + CAST('5' AS INT);
----
15

# Decimal precision — addition
query R
SELECT 1.1 + 2.2;
----
3.300

# Decimal precision — multiplication
query R
SELECT 0.1 * 3;
----
0.300

# NULL CAST returns NULL
query T
SELECT CAST(NULL AS INT);
----
NULL

# Boolean-like: 1 = 1 is TRUE (1), 1 = 2 is FALSE (0)
query I
SELECT CASE WHEN 1 = 1 THEN 1 ELSE 0 END;
----
1

query I
SELECT CASE WHEN 1 = 2 THEN 1 ELSE 0 END;
----
0

# String comparison is case-insensitive (SQL Server-style collation, default OFF)
query I
SELECT CASE WHEN 'abc' = 'ABC' THEN 1 ELSE 0 END;
----
1

# SET CASE_SENSITIVE = ON makes string equality case-sensitive
statement ok
SET CASE_SENSITIVE = ON;

query I
SELECT CASE WHEN 'abc' = 'ABC' THEN 1 ELSE 0 END;
----
0

query I
SELECT CASE WHEN 'abc' = 'abc' THEN 1 ELSE 0 END;
----
1

# Restore default — subsequent tests in other files are not affected
statement ok
SET CASE_SENSITIVE = OFF;
