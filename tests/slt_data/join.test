# Joins and Aliases
statement ok
CREATE TABLE users(id INT, name STRING);

statement ok
CREATE TABLE orders(id INT, user_id INT, amount INT);

statement ok
INSERT INTO users VALUES(1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO orders VALUES(10, 1, 100), (11, 1, 50), (12, 2, 200), (13, 4, 300);

query ITI
SELECT u.id, u.name, o.amount
FROM users u
JOIN orders o ON u.id = o.user_id
ORDER BY u.id, o.amount;
----
1
Alice
50
1
Alice
100
2
Bob
200

# LEFT JOIN (if supported)
query ITI
SELECT u.id, u.name, o.amount
FROM users u
LEFT JOIN orders o ON u.id = o.user_id
ORDER BY u.id, o.amount;
----
1
Alice
50
1
Alice
100
2
Bob
200
3
Charlie
NULL

# Cross Join
query II
SELECT a.id AS id1, b.id AS id2 FROM users a CROSS JOIN users b WHERE a.id < b.id ORDER BY a.id, b.id;
----
1
2
1
3
2
3

# Comma join (SQL-89 implicit CROSS JOIN filtered by WHERE)
query ITI
SELECT u.id, u.name, o.amount FROM users u, orders o WHERE u.id = o.user_id ORDER BY u.id, o.amount;
----
1
Alice
50
1
Alice
100
2
Bob
200

# Three-table comma join
statement ok
CREATE TABLE categories(cat_id INT, label STRING);

statement ok
INSERT INTO categories VALUES(1, 'Premium'), (2, 'Standard');

statement ok
CREATE TABLE user_categories(user_id INT, cat_id INT);

statement ok
INSERT INTO user_categories VALUES(1, 1), (2, 2);

query ITTI
SELECT u.id, u.name, c.label, o.amount
FROM users u, user_categories uc, categories c, orders o
WHERE u.id = uc.user_id AND uc.cat_id = c.cat_id AND u.id = o.user_id
ORDER BY u.id, o.amount;
----
1
Alice
Premium
50
1
Alice
Premium
100
2
Bob
Standard
200

# Five-table chain comma join (exercises predicate pushdown through a chain of FK relationships)
statement ok
CREATE TABLE locs(loc_id INT, city STRING);

statement ok
CREATE TABLE mgrs(mgr_id INT, loc_id INT);

statement ok
CREATE TABLE projs(proj_id INT, mgr_id INT);

statement ok
CREATE TABLE emps(emp_id INT, proj_id INT, dept_id INT);

statement ok
CREATE TABLE depts(dept_id INT, dept_name STRING);

statement ok
INSERT INTO locs VALUES(10, 'NYC'), (20, 'LA'), (30, 'CHI');

statement ok
INSERT INTO mgrs VALUES(100, 10), (200, 20), (300, 30);

statement ok
INSERT INTO projs VALUES(1000, 100), (2000, 200), (3000, 300);

statement ok
INSERT INTO emps VALUES(1, 1000, 1), (2, 2000, 2), (3, 3000, 3);

statement ok
INSERT INTO depts VALUES(1, 'Eng'), (2, 'Sales'), (3, 'Ops');

query TT
SELECT depts.dept_name, locs.city
FROM depts, emps, projs, mgrs, locs
WHERE depts.dept_id = emps.dept_id
  AND emps.proj_id = projs.proj_id
  AND projs.mgr_id = mgrs.mgr_id
  AND mgrs.loc_id = locs.loc_id
ORDER BY depts.dept_name;
----
Eng
NYC
Ops
CHI
Sales
LA
