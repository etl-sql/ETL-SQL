# Common Table Expressions (WITH ... AS)

statement ok
CREATE TABLE emp(id INT, name STRING, dept STRING, salary INT, mgr_id INT);

statement ok
INSERT INTO emp VALUES
  (1, 'Alice', 'Eng', 90, NULL),
  (2, 'Bob',   'Eng', 80, 1),
  (3, 'Carol', 'HR',  70, NULL),
  (4, 'Dave',  'HR',  75, 3),
  (5, 'Eve',   'Eng', 85, 1);

# Simple CTE
query TI
WITH eng AS (
    SELECT name, salary FROM emp WHERE dept = 'Eng'
)
SELECT name, salary FROM eng ORDER BY salary;
----
Bob
80
Eve
85
Alice
90

# Chained CTEs (multiple WITH clauses)
query TI
WITH by_dept AS (
    SELECT dept, SUM(salary) AS total FROM emp GROUP BY dept
),
ranked AS (
    SELECT dept, total FROM by_dept WHERE total > 200
)
SELECT dept, total FROM ranked ORDER BY dept;
----
Eng
255

# CTE used in WHERE subquery
query T
WITH hi AS (
    SELECT AVG(salary) AS avg_sal FROM emp
)
SELECT name FROM emp WHERE salary > (SELECT avg_sal FROM hi) ORDER BY name;
----
Alice
Eve

# CTE with aggregate — verify scalar value
query I
WITH totals AS (
    SELECT SUM(salary) AS grand FROM emp
)
SELECT grand FROM totals;
----
400

# CTE with LIMIT
query T
WITH sorted AS (
    SELECT name FROM emp ORDER BY salary DESC
)
SELECT name FROM sorted LIMIT 2;
----
Alice
Eve
