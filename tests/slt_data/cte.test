# Common Table Expressions (WITH ... AS)

statement ok
CREATE TABLE emp(id INT, name STRING, dept STRING, salary INT, mgr_id INT);

statement ok
INSERT INTO emp VALUES
  (1, 'Alice', 'Eng', 90, NULL),
  (2, 'Bob',   'Eng', 80, 1),
  (3, 'Carol', 'HR',  70, NULL),
  (4, 'Dave',  'HR',  75, 3),
  (5, 'Eve',   'Eng', 85, 1);

# Simple CTE
query TI
WITH eng AS (
    SELECT name, salary FROM emp WHERE dept = 'Eng'
)
SELECT name, salary FROM eng ORDER BY salary;
----
Bob
80
Eve
85
Alice
90

# Chained CTEs (multiple WITH clauses)
query TI
WITH by_dept AS (
    SELECT dept, SUM(salary) AS total FROM emp GROUP BY dept
),
ranked AS (
    SELECT dept, total FROM by_dept WHERE total > 200
)
SELECT dept, total FROM ranked ORDER BY dept;
----
Eng
255

# CTE used in WHERE subquery
query T
WITH hi AS (
    SELECT AVG(salary) AS avg_sal FROM emp
)
SELECT name FROM emp WHERE salary > (SELECT avg_sal FROM hi) ORDER BY name;
----
Alice
Eve

# CTE with aggregate — verify scalar value
query I
WITH totals AS (
    SELECT SUM(salary) AS grand FROM emp
)
SELECT grand FROM totals;
----
400

# CTE with LIMIT
query T
WITH sorted AS (
    SELECT name FROM emp ORDER BY salary DESC
)
SELECT name FROM sorted LIMIT 2;
----
Alice
Eve

# WITH RECURSIVE (hierarchical traversal)
statement ok
CREATE TABLE tree(id INT, parent_id INT);

statement ok
INSERT INTO tree VALUES (1, NULL), (2, 1), (3, 1), (4, 2);

query II
WITH RECURSIVE paths(id, level) AS (
    SELECT id, 0 FROM tree WHERE parent_id IS NULL
    UNION ALL
    SELECT t.id, p.level + 1 FROM tree t JOIN paths p ON t.parent_id = p.id
)
SELECT id, level FROM paths ORDER BY id;
----
1
0
2
1
3
1
4
2
# Multiple evaluations of the same CTE (self-join on CTE)
query I
WITH double_emp AS (
    SELECT salary FROM emp
)
SELECT a.salary + b.salary FROM double_emp a JOIN double_emp b ON a.salary = b.salary ORDER BY 1 LIMIT 1;
----
140

# CTE with variable bindings (if parameters are supported in context)
# Since SLT doesn't easily set variables, we skip variable binding tests here unless we can use an expression
query I
WITH var_cte AS (
    SELECT 100 AS val
)
SELECT val FROM var_cte;
----
100
