# JSON and XML processing tests

statement ok
CREATE TABLE docs(id INT, payload STRING);

statement ok
INSERT INTO docs VALUES
  (1, '{"name": "Alice", "age": 30, "address": {"city": "Seattle"}}'),
  (2, '{"name": "Bob", "tags": ["developer", "sql"]}'),
  (3, 'invalid json');

# ISJSON
query I
SELECT ISJSON(payload) FROM docs ORDER BY id;
----
1
1
0

# JSON_VALUE - extract scalar
query T
SELECT JSON_VALUE(payload, '$.name') FROM docs WHERE ISJSON(payload) = 1 ORDER BY id;
----
Alice
Bob

# JSON_VALUE - nested
query T
SELECT JSON_VALUE(payload, '$.address.city') FROM docs WHERE id = 1;
----
Seattle

# JSON_VALUE - missing key should return NULL
query T
SELECT JSON_VALUE(payload, '$.missing') FROM docs WHERE id = 1;
----
NULL

# JSON_QUERY - extract object/array
query T
SELECT JSON_QUERY(payload, '$.address') FROM docs WHERE id = 1;
----
{"city": "Seattle"}

query T
SELECT JSON_QUERY(payload, '$.tags') FROM docs WHERE id = 2;
----
["developer", "sql"]

# XML
statement ok
CREATE TABLE xml_docs(id INT, doc STRING);

statement ok
INSERT INTO xml_docs VALUES
  (1, '<root><item id="1">First</item><item id="2">Second</item></root>');

# XMLVALUE
query T
SELECT XMLVALUE(doc, '/root/item[@id="1"]') FROM xml_docs;
----
First

statement ok
CREATE TABLE users_for_format(id INT, name STRING);

statement ok
INSERT INTO users_for_format VALUES (1, 'Alice'), (2, 'Bob');

# FOR JSON PATH
query T
SELECT id, name FROM users_for_format WHERE id <= 2 ORDER BY id FOR JSON PATH, ROOT('Users');
----
1 values hashing to 39ec8e19050b0ac4c86d6b89dd560e06

# FOR XML PATH
query T
SELECT id, name FROM users_for_format WHERE id <= 2 ORDER BY id FOR XML PATH, ROOT('Users');
----
1 values hashing to e8b597f45ee2f4e4ef176b48d72da616

# JSON_TABLE
query T
SELECT * FROM JSON_TABLE('["A","B"]', '$') ORDER BY Value;
----
A
B

# OPENJSON
query TT
SELECT "key", "value" FROM OPENJSON('{"name":"Alice","age":30}') ORDER BY "key";
----
age
30
name
Alice

# XMLTABLE
query T
SELECT * FROM XMLTABLE('<catalog><book>A</book><book>B</book></catalog>', '/catalog/book') ORDER BY Value;
----
A
B

