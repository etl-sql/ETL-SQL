# Star Exclude, Replace, and Rename combined
query ITIT
SELECT * EXCLUDE (price) REPLACE (quantity * 10 AS quantity) RENAME (name AS item_name) FROM items ORDER BY id;
----
1
Notebook
100
Stationery
2
Pen
500
Stationery
3
Backpack
50
Gear
4
Marker
300
Stationery
5
Water Bottle
150
Gear

# USING SAMPLE row count checks (robust & deterministic)
query I
SELECT COUNT(*) FROM (SELECT * FROM items USING SAMPLE 3 ROWS) AS s;
----
3

query I
SELECT COUNT(*) FROM (SELECT * FROM items USING SAMPLE 100 PERCENT) AS s;
----
5

query I
SELECT COUNT(*) FROM (SELECT * FROM items USING SAMPLE 0 PERCENT) AS s;
----
0

# USING SAMPLE with seed (repeatable check)
query I
SELECT id FROM items ORDER BY id USING SAMPLE 2 ROWS REPEATABLE (42);
----
5
2
