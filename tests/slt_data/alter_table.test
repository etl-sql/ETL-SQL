# ALTER TABLE and INDEX tests for ETL-SQL

# Create a temporary table
statement ok
CREATE TABLE #temp_alter (id INT, name STRING);

# Insert some initial data
statement ok
INSERT INTO #temp_alter VALUES (1, 'Alice'), (2, 'Bob');

# ALTER TABLE ADD COLUMN
statement ok
ALTER TABLE #temp_alter ADD age INT;

# Verify age column is present and defaults to NULL
query II
SELECT id, age FROM #temp_alter ORDER BY id;
----
1
NULL
2
NULL

# Update the new column
statement ok
UPDATE #temp_alter SET age = 30 WHERE id = 1;

statement ok
UPDATE #temp_alter SET age = 25 WHERE id = 2;

query ITI
SELECT id, name, age FROM #temp_alter ORDER BY id;
----
1
Alice
30
2
Bob
25

# ALTER TABLE RENAME COLUMN
statement ok
ALTER TABLE #temp_alter RENAME COLUMN age TO years;

# Verify old name is not queryable (should fail)
statement error
SELECT age FROM #temp_alter;

# Verify renamed column is queryable
query ITI
SELECT id, name, years FROM #temp_alter ORDER BY id;
----
1
Alice
30
2
Bob
25

# ALTER TABLE DROP COLUMN
statement ok
ALTER TABLE #temp_alter DROP COLUMN years;

# Verify dropped column is not queryable
statement error
SELECT years FROM #temp_alter;

# Verify other columns still work
query IT
SELECT id, name FROM #temp_alter ORDER BY id;
----
1
Alice
2
Bob

# CREATE INDEX and UNIQUE INDEX tests
statement ok
CREATE UNIQUE INDEX idx_id ON #temp_alter(id);

# Try inserting a duplicate id - should fail due to unique index
statement error
INSERT INTO #temp_alter VALUES (1, 'Charlie');

# CREATE non-unique index
statement ok
CREATE INDEX idx_name ON #temp_alter(name);

# Drop index with table-less drop index syntax
statement ok
DROP INDEX idx_name;

# Drop index with ON table syntax
statement ok
DROP INDEX idx_id ON #temp_alter;
