# Obscure SQL Features: SEMI JOIN, ANTI JOIN, and QUALIFY

# Setup tables for JOIN tests
statement ok
CREATE TABLE t1(id INT, name STRING);

statement ok
CREATE TABLE t2(id INT, category STRING);

statement ok
INSERT INTO t1 VALUES(1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO t2 VALUES(1, 'Category A'), (2, 'Category B');

# SEMI JOIN — returns rows from the left table where there is a matching row in the right table
query IT
SELECT t1.id, t1.name FROM t1 SEMI JOIN t2 ON t1.id = t2.id ORDER BY t1.id;
----
1
Alice
2
Bob

# LEFT SEMI JOIN — synonym/variant of SEMI JOIN
query IT
SELECT t1.id, t1.name FROM t1 LEFT SEMI JOIN t2 ON t1.id = t2.id ORDER BY t1.id;
----
1
Alice
2
Bob

# ANTI JOIN — returns rows from the left table where there is NO matching row in the right table
query IT
SELECT t1.id, t1.name FROM t1 ANTI JOIN t2 ON t1.id = t2.id ORDER BY t1.id;
----
3
Charlie

# LEFT ANTI JOIN — synonym/variant of ANTI JOIN
query IT
SELECT t1.id, t1.name FROM t1 LEFT ANTI JOIN t2 ON t1.id = t2.id ORDER BY t1.id;
----
3
Charlie

# Setup tables for QUALIFY tests
statement ok
CREATE TABLE sales(id INT, region STRING, amount INT);

statement ok
INSERT INTO sales VALUES(1, 'East', 100), (2, 'East', 150), (3, 'West', 200), (4, 'West', 180);

# QUALIFY clause with ROW_NUMBER()
query ITI
SELECT id, region, amount, ROW_NUMBER() OVER (PARTITION BY region ORDER BY amount DESC) as rn
FROM sales
QUALIFY rn = 1
ORDER BY id;
----
2
East
150
1
3
West
200
1

# QUALIFY clause referencing rank alias
query ITI
SELECT id, region, amount, RANK() OVER (PARTITION BY region ORDER BY amount DESC) as rnk
FROM sales
QUALIFY rnk = 1
ORDER BY id;
----
2
East
150
1
3
West
200
1
