# Table valued generators and string splitting

# GENERATE_SERIES
query I
SELECT value FROM GENERATE_SERIES(1, 5) ORDER BY value;
----
1
2
3
4
5

query I
SELECT value FROM GENERATE_SERIES(10, 0, -2) ORDER BY value;
----
0
2
4
6
8
10

# STRING_SPLIT
query T
SELECT value FROM STRING_SPLIT('apple,banana,cherry', ',') ORDER BY value;
----
apple
banana
cherry

# NGRAMS
query T
SELECT value FROM NGRAMS('hello', 3) ORDER BY value;
----
ell
hel
llo

# Cross Apply with generated series
statement ok
CREATE TABLE events(id INT, num_tickets INT);

statement ok
INSERT INTO events VALUES (1, 3), (2, 2);

query II
SELECT e.id, s.value
FROM events e
CROSS APPLY GENERATE_SERIES(1, e.num_tickets) s
ORDER BY e.id, s.value;
----
1
1
1
2
1
3
2
1
2
2

# Outer Apply with generated series (returns NULL for unmatched right)
query II
SELECT e.id, s.value
FROM events e
OUTER APPLY (SELECT value FROM GENERATE_SERIES(1, e.num_tickets) WHERE value > 2) s
ORDER BY e.id, s.value;
----
1
3
2
NULL

# GENERATE statement
statement ok
CREATE TABLE #gen_data (id INT, label STRING);

statement ok
GENERATE 3 ROWS INTO #gen_data
WITH (SEED = 42)
AS (
  id = 'SEQUENCE(1, 1)',
  label = 'RANDOM(A, B)'
);

query II
SELECT id, CASE WHEN label IN ('A', 'B') THEN 1 ELSE 0 END FROM #gen_data ORDER BY id;
----
1
1
2
1
3
1

