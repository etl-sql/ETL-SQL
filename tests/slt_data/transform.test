# TRANSFORM Statement and Algorithms Tests

# 1. FILL_DATES
statement ok
CREATE TABLE #t_fd (Grp STRING, Dt DATE, Val INT);

statement ok
INSERT INTO #t_fd VALUES
  ('A', '2026-01-01', 10),
  ('A', '2026-01-03', 30),
  ('B', '2026-01-02', 20),
  ('B', '2026-01-04', 40);

statement ok
TRANSFORM #fd_out
FROM #t_fd
USING FILL_DATES (
  DATE_COL = 'Dt',
  BY_GROUP = 'Grp',
  GAPS_FILL = -1
);

query TTI
SELECT Grp, CAST(Dt AS STRING), Val FROM #fd_out ORDER BY Grp, Dt;
----
A
1/1/2026 12:00:00 AM
10
A
1/2/2026 12:00:00 AM
-1
A
1/3/2026 12:00:00 AM
30
B
1/2/2026 12:00:00 AM
20
B
1/3/2026 12:00:00 AM
-1
B
1/4/2026 12:00:00 AM
40


# 2. INTERPOLATE (Linear, Forward, NOCB, Nulls at boundary)
statement ok
CREATE TABLE #t_interp (Seq INT, Val INT);

statement ok
INSERT INTO #t_interp VALUES
  (1, 10),
  (2, NULL),
  (3, NULL),
  (4, 40);

statement ok
TRANSFORM #interp_linear
FROM #t_interp
USING INTERPOLATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  METHOD = 'LINEAR'
);

query II
SELECT Seq, Val FROM #interp_linear ORDER BY Seq;
----
1
10
2
20
3
30
4
40

statement ok
TRANSFORM #interp_ff
FROM #t_interp
USING INTERPOLATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  METHOD = 'FORWARD'
);

query II
SELECT Seq, Val FROM #interp_ff ORDER BY Seq;
----
1
10
2
10
3
10
4
40

statement ok
TRANSFORM #interp_bf
FROM #t_interp
USING INTERPOLATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  METHOD = 'BACKWARD'
);

query II
SELECT Seq, Val FROM #interp_bf ORDER BY Seq;
----
1
10
2
40
3
40
4
40


# 3. DEDUPLICATE (Keep FIRST vs LAST, sorting ASC/DESC)
statement ok
CREATE TABLE #t_dedup (Id INT, Name STRING, Val INT);

statement ok
INSERT INTO #t_dedup VALUES
  (1, 'A', 10),
  (1, 'A', 20),
  (2, 'B', 30),
  (2, 'B', 15);

statement ok
TRANSFORM #dedup_first
FROM #t_dedup
USING DEDUPLICATE (
  KEY_COLS = 'Id,Name',
  ORDER_BY = 'Val ASC',
  KEEP = 'FIRST'
);

query ITI
SELECT Id, Name, Val FROM #dedup_first ORDER BY Id;
----
1
A
10
2
B
15

statement ok
TRANSFORM #dedup_last
FROM #t_dedup
USING DEDUPLICATE (
  KEY_COLS = 'Id,Name',
  ORDER_BY = 'Val ASC',
  KEEP = 'LAST'
);

query ITI
SELECT Id, Name, Val FROM #dedup_last ORDER BY Id;
----
1
A
20
2
B
30


# 4. PIVOT (Row Fields, Pivot Field, Value Field, Aggregate)
statement ok
CREATE TABLE #t_pivot (Region STRING, Year INT, Sales INT);

statement ok
INSERT INTO #t_pivot VALUES
  ('East', 2024, 100),
  ('East', 2025, 150),
  ('West', 2024, 200);

statement ok
TRANSFORM #pivot_out
FROM #t_pivot
USING PIVOT (
  ROW_FIELDS = 'Region',
  PIVOT_FIELD = 'Year',
  VALUE_FIELD = 'Sales',
  AGGREGATE = 'SUM'
);

query TII
SELECT Region, "2024", "2025" FROM #pivot_out ORDER BY Region;
----
East
100
150
West
200
NULL


# 5. TOP_N_OTHERS (Happy path, custom label, BY_GROUP)
statement ok
CREATE TABLE #t_topn (Cat STRING, Val INT);

statement ok
INSERT INTO #t_topn VALUES
  ('A', 10),
  ('B', 20),
  ('C', 5),
  ('D', 2),
  ('E', 1);

statement ok
TRANSFORM #topn_out
FROM #t_topn
USING TOP_N_OTHERS (
  N = 2,
  VALUE_COL = 'Val',
  CATEGORY_COL = 'Cat',
  OTHERS_LABEL = 'All Others'
);

query TI
SELECT Cat, Val FROM #topn_out ORDER BY Val DESC;
----
B
20
A
10
All Others
8


# 6. PERIOD_COMPARISON (DoD, MoM, YoY difference and pct)
statement ok
CREATE TABLE #t_pc (Dt DATE, Val INT);

statement ok
INSERT INTO #t_pc VALUES
  ('2026-01-01', 100),
  ('2026-01-02', 150),
  ('2026-01-03', 120);

statement ok
TRANSFORM #pc_out
FROM #t_pc
USING PERIOD_COMPARISON (
  DATE_COL = 'Dt',
  VALUE_COL = 'Val',
  PERIOD = 'DAY'
);

query TIII
SELECT CAST(Dt AS STRING), Val, Val_Diff, Val_Pct FROM #pc_out ORDER BY Dt;
----
1/1/2026 12:00:00 AM
100
NULL
NULL
1/2/2026 12:00:00 AM
150
50
50
1/3/2026 12:00:00 AM
120
-30
-20


# 7. SHARE_OF_TOTAL (Grand total shares, group partition shares)
statement ok
CREATE TABLE #t_share (Item STRING, Val INT);

statement ok
INSERT INTO #t_share VALUES
  ('A', 10),
  ('B', 30);

statement ok
TRANSFORM #share_out
FROM #t_share
USING SHARE_OF_TOTAL (
  VALUE_COL = 'Val'
);

query TIR
SELECT Item, Val, Val_Share FROM #share_out ORDER BY Item;
----
A
10
0.250
B
30
0.750


# 8. NORMALIZE (Min-Max, Z-score, zero ranges, zero standard deviation)
statement ok
CREATE TABLE #t_norm (Id INT, Val INT);

statement ok
INSERT INTO #t_norm VALUES
  (1, 10),
  (2, 20),
  (3, 30);

statement ok
TRANSFORM #norm_out
FROM #t_norm
USING NORMALIZE (
  VALUE_COL = 'Val',
  METHOD = 'MIN_MAX'
);

query IIR
SELECT Id, Val, Val_Normalized FROM #norm_out ORDER BY Id;
----
1
10
0.000
2
20
0.500
3
30
1.000

statement ok
CREATE TABLE #t_ident (Id INT, Val INT);

statement ok
INSERT INTO #t_ident VALUES
  (1, 10),
  (2, 10);

statement ok
TRANSFORM #ident_norm
FROM #t_ident
USING NORMALIZE (
  VALUE_COL = 'Val',
  METHOD = 'MIN_MAX'
);

query IIR
SELECT Id, Val, Val_Normalized FROM #ident_norm ORDER BY Id;
----
1
10
0.000
2
10
0.000

statement ok
TRANSFORM #ident_z
FROM #t_ident
USING NORMALIZE (
  VALUE_COL = 'Val',
  METHOD = 'Z_SCORE'
);

query IIR
SELECT Id, Val, Val_Normalized FROM #ident_z ORDER BY Id;
----
1
10
0.000
2
10
0.000


# 9. ROLLING_AGGREGATE (Happy path, empty set fallback)
statement ok
CREATE TABLE #t_roll (Seq INT, Val INT);

statement ok
INSERT INTO #t_roll VALUES
  (1, 10),
  (2, 20),
  (3, 30);

statement ok
TRANSFORM #roll_out
FROM #t_roll
USING ROLLING_AGGREGATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  WINDOW_SIZE = 2,
  AGGREGATE = 'AVG'
);

query IIR
SELECT Seq, Val, Val_Rolling FROM #roll_out ORDER BY Seq;
----
1
10
10.000
2
20
15.000
3
30
25.000

statement ok
CREATE TABLE #t_empty (Seq INT, Val INT);

statement ok
TRANSFORM #empty_roll
FROM #t_empty
USING ROLLING_AGGREGATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  WINDOW_SIZE = 2,
  AGGREGATE = 'AVG'
);

query II
SELECT * FROM #empty_roll;
----
