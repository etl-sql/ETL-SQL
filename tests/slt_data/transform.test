----
1
10.000
0.000
2
NULL
NULL
3
30.000
1.000

statement ok
TRANSFORM #t_null_norm
USING SHARE_OF_TOTAL (
  VALUE_COL = 'Val'
);

query IRR
SELECT Id, Val, Val_Share FROM #t_null_norm ORDER BY Id;
----
1
10.000
0.250
2
NULL
NULL
3
30.000
0.750

