1
10
0.000
2
10
0.000


# 9. ROLLING_AGGREGATE (Happy path, empty set fallback)
statement ok
CREATE TABLE #t_roll (Seq INT, Val INT);

statement ok
INSERT INTO #t_roll VALUES
  (1, 10),
  (2, 20),
  (3, 30);

statement ok
TRANSFORM #roll_out
FROM #t_roll
USING ROLLING_AGGREGATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  WINDOW_SIZE = 2,
  AGGREGATE = 'AVG'
);

query IIR
SELECT Seq, Val, Val_Rolling FROM #roll_out ORDER BY Seq;
----
1
10
10.000
2
20
15.000
3
30
25.000

statement ok
CREATE TABLE #t_empty (Seq INT, Val INT);

statement ok
TRANSFORM #empty_roll
FROM #t_empty
USING ROLLING_AGGREGATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  WINDOW_SIZE = 2,
  AGGREGATE = 'AVG'
);

query II
SELECT * FROM #empty_roll;
----


# 10. TR01/TR02 Regressions: NULL handling, duplicate dates, month-end, in-place, grain
statement ok
CREATE TABLE #t_null_norm (Id INT, Val DECIMAL(18, 2));

statement ok
INSERT INTO #t_null_norm VALUES (1, 10), (2, NULL), (3, 30);

statement ok
TRANSFORM #null_norm_out
FROM #t_null_norm
USING NORMALIZE (
  VALUE_COL = 'Val',
  METHOD = 'MIN_MAX'
);

query IRR
