statement error
TRANSFORM #err_opt
FROM #t_null_norm
USING NORMALIZE (
  VALUE_COL = 'Val',
  UNKNOWN_OPTION = 'X'
);

statement error
TRANSFORM #err_grp
FROM #t_null_norm
USING SHARE_OF_TOTAL (
  VALUE_COL = 'Val',
  BY_GROUP = 'NoSuchCol'
);

statement error
TRANSFORM #err_win
FROM #t_roll
USING ROLLING_AGGREGATE (
  VALUE_COL = 'Val',
  ORDER_COL = 'Seq',
  WINDOW_SIZE = 0
);

# 10. UNPIVOT / MELT
statement ok
CREATE TABLE #t_wide (Id INT, Region STRING, Q1 INT, Q2 INT, Q3 INT);

statement ok
INSERT INTO #t_wide VALUES
  (1, 'North', 10, NULL, 30),
  (2, 'South', 20, 25, NULL);

statement ok
TRANSFORM #t_unpivot_default
FROM #t_wide
USING UNPIVOT (
  ID_COLS = 'Id, Region',
  VALUE_COLS = 'Q1, Q2, Q3',
  NAME_COL = 'Quarter',
  VALUE_COL = 'Sales'
);

query ITTI
SELECT Id, Region, Quarter, Sales FROM #t_unpivot_default ORDER BY Id, Quarter;
----
1
North
Q1
10
1
North
Q3
30
2
South
Q1
20
2
South
Q2
25

statement ok
TRANSFORM #t_melt_nulls
FROM #t_wide
USING MELT (
  ID_COLS = 'Id',
  VALUE_COLS = 'Q1, Q2',
  NAME_COL = 'Quarter',
  VALUE_COL = 'Sales',
  INCLUDE_NULLS = ON
);

query ITT
SELECT Id, Quarter, COALESCE(CAST(Sales AS STRING), 'NULL') FROM #t_melt_nulls ORDER BY Id, Quarter;
----
1
Q1
10
1
Q2
NULL
2
Q1
20
2
Q2
25

statement error
TRANSFORM #err_unpivot_opt
FROM #t_wide
USING UNPIVOT (
  ID_COLS = 'Id',
  VALUE_COLS = 'Q1, Q2',
  INCLUDE_NULLS = 'BAD'
);

statement error
TRANSFORM #err_unpivot_col
FROM #t_wide
USING UNPIVOT (
  ID_COLS = 'Id',
  VALUE_COLS = 'Q1, MissingCol'
);


# 11. CLEAN_TEXT / STANDARDIZE in SELECT and TRANSFORM ... USING CLEAN (TR05)
statement ok
CREATE TABLE #t_clean_src (Id INT, Name STRING, Email STRING, Phone STRING, Postal STRING);

statement ok
INSERT INTO #t_clean_src VALUES
  (1, '  alice   smith  ', '  ALICE@Example.COM ', '(555) 123-4567', '123456789'),
  (2, '   ', NULL, '+1 (555) 987-6543', 'k1a0b1');

query TTTT
SELECT
  CLEAN_TEXT(Name, 'TRIM, COLLAPSE_WHITESPACE, TITLE'),
  STANDARDIZE(Email, 'EMAIL'),
  STANDARDIZE(Phone, 'PHONE'),
  STANDARDIZE(Postal, 'POSTAL_CODE')
FROM #t_clean_src
WHERE Id = 1;
----
Alice Smith
alice@example.com
555-123-4567
12345-6789

statement ok
TRANSFORM #t_clean_out
FROM #t_clean_src
USING CLEAN (
  COLS = '*',
  RULES = 'STRIP_CONTROL, COLLAPSE_WHITESPACE, TRIM, NULL_IF_EMPTY'
);

statement ok
TRANSFORM #t_clean_out
USING CLEAN (
  COLS = 'Email',
  RULES = 'EMAIL'
);

statement ok
TRANSFORM #t_clean_out
USING CLEAN (
  COLS = 'Phone',
  RULES = 'PHONE'
);

statement ok
TRANSFORM #t_clean_out
USING CLEAN (
  COLS = 'Postal',
  RULES = 'POSTAL_CODE'
);

query ITTTT
SELECT
  Id,
  COALESCE(Name, 'NULL'),
  COALESCE(Email, 'NULL'),
  Phone,
  Postal
FROM #t_clean_out
ORDER BY Id;
----
1
alice smith
alice@example.com
555-123-4567
12345-6789
2
NULL
NULL
+1-555-987-6543
K1A 0B1

statement error
SELECT CLEAN_TEXT('abc', 'UNKNOWN_RULE');

statement error
SELECT STANDARDIZE('abc', 'UNKNOWN_FORMAT');

statement error
TRANSFORM #err_clean_col
FROM #t_clean_src
USING CLEAN (
  COLS = 'DoesNotExist',
  RULES = 'TRIM'
);

# 12. TRANSFORM ... USING BIN / BUCKETIZE and OUTLIERS (TR07)
statement ok
CREATE TABLE #t_bin_src (Id INT, Val DECIMAL(18, 2));

statement ok
INSERT INTO #t_bin_src VALUES
  (1, 0),
  (2, 25),
  (3, 50),
  (4, 100),
  (5, NULL);

statement ok
TRANSFORM #t_bin_ew
FROM #t_bin_src
USING BIN (
  VALUE_COL = 'Val',
  METHOD = 'EQUAL_WIDTH',
  BINS = 2
);

query ITT rowsort
SELECT Id, COALESCE(CAST(Bin_Start AS STRING), 'NULL'), COALESCE(Bin_Label, 'NULL')
FROM #t_bin_ew;
----
1
0.0
[0, 50)
2
0.0
[0, 50)
3
50.0
[50, 100]
4
50.0
[50, 100]
5
NULL
NULL

statement ok
TRANSFORM #t_bin_thresh
FROM #t_bin_src
USING BUCKETIZE (
  VALUE_COL = 'Val',
  METHOD = 'THRESHOLDS',
  THRESHOLDS = '0, 50, 100'
);

query IT rowsort
SELECT Id, COALESCE(Bin_Label, 'NULL')
FROM #t_bin_thresh;
----
1
[0, 50)
2
[0, 50)
3
[50, 100]
4
[50, 100]
5
NULL

statement ok
CREATE TABLE #t_out_src (Id INT, Val DECIMAL(18, 2));

statement ok
INSERT INTO #t_out_src VALUES
  (1, 10),
  (2, 11),
  (3, 12),
  (4, 13),
  (5, 100),
  (6, NULL);

statement ok
TRANSFORM #t_out_flag
FROM #t_out_src
USING OUTLIERS (
  VALUE_COL = 'Val',
  METHOD = 'IQR',
  ACTION = 'FLAG'
);

query IT rowsort
SELECT Id, COALESCE(CAST(Val_IsOutlier AS STRING), 'NULL')
FROM #t_out_flag;
----
1
0
2
0
3
0
4
0
5
1
6
NULL

statement ok
TRANSFORM #t_out_filter
FROM #t_out_src
USING OUTLIERS (
  VALUE_COL = 'Val',
  METHOD = 'IQR',
  ACTION = 'FILTER'
);

query I rowsort
SELECT Id FROM #t_out_filter;
----
1
2
3
4
6

statement error
TRANSFORM #err_bin_method
FROM #t_bin_src
USING BIN (
  VALUE_COL = 'Val',
  METHOD = 'NO_SUCH_METHOD'
);

statement error
TRANSFORM #err_out_action
FROM #t_out_src
USING OUTLIERS (
  VALUE_COL = 'Val',
  ACTION = 'NO_SUCH_ACTION'
);

# 13. TRANSFORM ... USING IMPUTE and SPLIT / EXPLODE (TR08)
statement ok
CREATE TABLE #t_imp_src (Id INT, Grp STRING, Val DECIMAL(18, 2), Cat STRING);

statement ok
INSERT INTO #t_imp_src VALUES
  (1, 'A', 10, 'x'),
  (2, 'A', NULL, 'x'),
  (3, 'A', 30, NULL),
  (4, 'B', NULL, 'y'),
  (5, 'B', 50, 'y');

statement ok
TRANSFORM #t_imp_mean
FROM #t_imp_src
USING IMPUTE (
  COLS = 'Val',
  METHOD = 'MEAN',
  BY_GROUP = 'Grp'
);

query IR rowsort
SELECT Id, Val FROM #t_imp_mean;
----
1
10.000
2
20.000
3
30.000
4
50.000
5
50.000

statement ok
TRANSFORM #t_imp_mode
FROM #t_imp_src
USING IMPUTE (
  COLS = 'Cat',
  METHOD = 'MODE',
  BY_GROUP = 'Grp'
);

query IT rowsort
SELECT Id, Cat FROM #t_imp_mode;
----
1
x
2
x
3
x
4
y
5
y

statement ok
CREATE TABLE #t_split_src (Id INT, Colors STRING);

statement ok
INSERT INTO #t_split_src VALUES
  (1, 'red, blue'),
  (2, NULL);

statement ok
TRANSFORM #t_split_rows
FROM #t_split_src
USING SPLIT (
  SOURCE_COL = 'Colors',
  MODE = 'ROWS',
  DELIMITER = ',',
  OUTPUT_COL = 'Color',
  INDEX_COL = 'Idx',
  TRIM = 'ON'
);

query ITT rowsort
SELECT Id, COALESCE(CAST(Idx AS STRING), 'NULL'), COALESCE(Color, 'NULL')
FROM #t_split_rows;
----
1
1
red
1
2
blue
2
NULL
NULL

statement ok
TRANSFORM #t_split_cols
FROM #t_split_src
USING SPLIT (
  SOURCE_COL = 'Colors',
  MODE = 'COLUMNS',
  DELIMITER = ',',
  PREFIX = 'T',
  MAX_PARTS = 2,
  TRIM = 'ON'
);

query ITT rowsort
SELECT Id, COALESCE(T1, 'NULL'), COALESCE(T2, 'NULL')
FROM #t_split_cols;
----
1
red
blue
2
NULL
NULL

statement ok
CREATE TABLE #t_json_src (OrderId INT, Payload STRING);

statement ok
INSERT INTO #t_json_src VALUES
  (10, '{"items":[{"sku":"A1","qty":2},{"sku":"B2","qty":5}]}');

statement ok
TRANSFORM #t_json_flat
FROM #t_json_src
USING EXPLODE (
  SOURCE_COL = 'Payload',
  MODE = 'ROWS',
  JSON_PATH = '$.items',
  INDEX_COL = 'LineNo'
);

query IITI rowsort
SELECT OrderId, LineNo, sku, qty FROM #t_json_flat;
----
10
1
A1
2
10
2
B2
5

statement error
TRANSFORM #err_imp_const
FROM #t_imp_src
USING IMPUTE (
  COLS = 'Val',
  METHOD = 'CONSTANT'
);

statement error
TRANSFORM #err_split_both
FROM #t_split_src
USING SPLIT (
  SOURCE_COL = 'Colors',
  DELIMITER = ',',
  JSON_PATH = '$.items'
);
