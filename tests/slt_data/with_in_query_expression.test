# Query-level WITH in every query expression position (CTE body, derived table,
# scalar subquery, IN, EXISTS, parenthesized set-operation branches), plus shadowing,
# WITH RECURSIVE, and correlated subqueries.

statement ok
CREATE TABLE #items(id INT, grp INT, val INT);

statement ok
INSERT INTO #items VALUES (1, 10, 100), (2, 10, 200), (3, 20, 300);

# 1. CTE body containing its own WITH
query I rowsort
WITH outer_cte AS (
    WITH inner_cte AS (SELECT id, val FROM #items WHERE grp = 10)
    SELECT id FROM inner_cte WHERE val >= 200
)
SELECT id FROM outer_cte;
----
2

# 2. Derived table in FROM / JOIN with WITH
query II rowsort
SELECT sub.id, sub.val
FROM (
    WITH filtered AS (SELECT id, val FROM #items WHERE val >= 200)
    SELECT id, val FROM filtered
) sub;
----
2
200
3
300

# 3. Scalar subquery in SELECT list with WITH
query I
SELECT (
    WITH s AS (SELECT SUM(val) AS total FROM #items)
    SELECT total FROM s
);
----
600

# 4. IN (...) subquery with WITH and parenthesized set-operation branches
query I rowsort
SELECT id
FROM #items
WHERE id IN (
    (WITH a AS (SELECT 1 AS k) SELECT k FROM a)
    UNION ALL
    (WITH b AS (SELECT 3 AS k) SELECT k FROM b)
)
ORDER BY id;
----
1
3

# 5. EXISTS (...) / NOT EXISTS (...) with WITH
query I rowsort
SELECT id
FROM #items i
WHERE EXISTS (
    WITH m AS (SELECT grp FROM #items WHERE val = 300)
    SELECT 1 FROM m WHERE m.grp = i.grp
);
----
3

# 6. Parenthesized set-operation branches with independent WITH clauses
query I rowsort
(WITH a AS (SELECT 10 AS x) SELECT x FROM a)
UNION
(WITH b AS (SELECT 20 AS x) SELECT x FROM b);
----
10
20

# 7. Shadowing outer CTE and #temp table only inside the subquery
query III
WITH c AS (SELECT 100 AS v)
SELECT
    (SELECT v FROM c) AS before_sub,
    (WITH c AS (SELECT 999 AS v) SELECT v FROM c) AS inner_c,
    (WITH #items AS (SELECT 777 AS id) SELECT id FROM #items) AS inner_tmp;
----
100
999
777

# Outer #items table remains intact after subquery shadows it
query I
SELECT COUNT(*) FROM #items;
----
3

# Nested CTE names do not leak after statement completes
statement error
SELECT x FROM inner_cte;

# 8. WITH RECURSIVE in derived table
query I rowsort
SELECT n
FROM (
    WITH RECURSIVE seq(n) AS (
        SELECT 1
        UNION ALL
        SELECT n + 1 FROM seq WHERE n < 4
    )
    SELECT n FROM seq
) r;
----
1
2
3
4

# 9. Correlated scalar subquery with nested WITH evaluates per outer row
query II rowsort
SELECT i.id, (
    WITH bonus AS (SELECT i.val + 1 AS adjusted)
    SELECT adjusted FROM bonus
) AS adjusted
FROM #items i
ORDER BY i.id;
----
1
101
2
201
3
301
