-- Verification for FW-18: AT TIME ZONE
-- Verification for FW-17: Advanced Statistical Functions

-- 1. Test AT TIME ZONE
PRINT 'Test 1: AT TIME ZONE';
DECLARE @utc = '2026-04-07 12:00:00'; -- UTC
DECLARE @est = @utc AT TIME ZONE 'Eastern Standard Time';
DECLARE @pst = @utc AT TIME ZONE 'Pacific Standard Time';
PRINT 'UTC: ' + @utc;
PRINT 'EST: ' + @est;
PRINT 'PST: ' + @pst;

-- 2. Test Statistical Functions (Variance, StDev)
PRINT 'Test 2: VAR, STDEV';
CREATE TABLE #Stats (val DECIMAL);
INSERT INTO #Stats (val) VALUES (2), (4), (4), (4), (5), (5), (7), (9);

SELECT 
    VAR(val) AS SampleVar, 
    VARP(val) AS PopVar,
    STDEV(val) AS SampleStDev,
    STDEVP(val) AS PopStDev
FROM #Stats;

-- 3. Test Covariance and Correlation
PRINT 'Test 3: COVAR, CORR';
CREATE TABLE #Pairs (x DECIMAL, y DECIMAL);
INSERT INTO #Pairs (x, y) VALUES (1, 2), (2, 4), (3, 6), (4, 8), (5, 10); -- Perfect correlation (1.0)

SELECT 
    COVAR_POP(x, y) AS CovarPop,
    COVAR_SAMP(x, y) AS CovarSamp,
    CORR(x, y) AS Correlation
FROM #Pairs;

-- 4. Test NULL Handling in Stats
PRINT 'Test 4: Stats with NULLs';
INSERT INTO #Pairs (x, y) VALUES (6, NULL), (NULL, 12), (7, 14);

SELECT 
    COUNT(*) AS TotalRows,
    CORR(x, y) AS CorrelationWithNulls -- Should still be 1.0 because it ignores NULL pairs
FROM #Pairs;
