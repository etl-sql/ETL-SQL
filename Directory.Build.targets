<Project>
  <PropertyGroup>
    <BrowserAssetRoot>$(MSBuildThisFileDirectory)</BrowserAssetRoot>
    <BrowserAssetManifest>$(BrowserAssetRoot)artifacts/browser-assets.props</BrowserAssetManifest>
    <RequiresBrowserAssets Condition="'$(MSBuildProjectName)' == 'ETL-SQL.Reporting' Or '$(MSBuildProjectName)' == 'ETL-SQL.ReportRuntime' Or '$(MSBuildProjectName)' == 'ETL-SQL.ReportPlayer' Or '$(MSBuildProjectName)' == 'ETL-SQL.WorkstationEditor' Or '$(MSBuildProjectName)' == 'ETL-SQL.Portal'">true</RequiresBrowserAssets>
  </PropertyGroup>

  <Import Project="$(BrowserAssetManifest)" Condition="'$(RequiresBrowserAssets)' == 'true' And Exists('$(BrowserAssetManifest)')" />

  <Target Name="RejectBrowserContractBootstrapPublishing" BeforeTargets="Publish"
          Condition="'$(BootstrapBrowserContracts)' == 'true'">
    <Error Text="Browser contract bootstrap assemblies cannot be published. Prepare browser assets and build without BootstrapBrowserContracts." />
  </Target>

  <!-- Preparation runs before invoking MSBuild, so the SDK discovers every generated static file.
       Builds only verify: no network access, Node invocation, or competing writes across projects. -->
  <Target Name="VerifyPreparedBrowserAssets" BeforeTargets="PrepareForBuild" Condition="'$(RequiresBrowserAssets)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <Error Condition="Exists('$(BrowserAssetRoot)artifacts/browser-contracts-transaction.json')"
           Text="Browser contracts need recovery. Run node scripts/generate-browser-contracts.mjs --recover before building." />
    <Error Condition="Exists('$(BrowserAssetRoot).browser-assets.lock')"
           Text="Browser asset preparation is still running. Wait for it to finish before building." />
    <Error Condition="!Exists('$(BrowserAssetManifest)') Or '@(_BrowserPreparedAsset)' == ''"
           Text="Browser assets are not prepared. Run npm ci --prefix scripts/typecheck, then node scripts/sync-assets.js before dotnet build or publish." />
    <Error Condition="!Exists('%(_BrowserPreparedAsset.Identity)')"
           Text="Prepared browser asset is missing: %(_BrowserPreparedAsset.Identity). Run node scripts/sync-assets.js before building." />
    <ItemGroup>
      <_BrowserCurrentSource Include="$(BrowserAssetRoot)src/ETL-SQL.ReportRuntime/Resources/TypeScript/**/*;
                                     $(BrowserAssetRoot)src/ETL-SQL.Portal/BrowserSources/**/*;
                                     $(BrowserAssetRoot)types/**/*;
                                     $(BrowserAssetRoot)src/ETL-SQL.ReportRuntime/Resources/Shared/**/*;
                                     $(BrowserAssetRoot)src/ETL-SQL.Portal/wwwroot/**/*;
                                     $(BrowserAssetRoot)scripts/lib/**/*.cjs;$(BrowserAssetRoot)scripts/lib/**/*.mjs;
                                     $(BrowserAssetRoot)scripts/lib/**/*.js;$(BrowserAssetRoot)scripts/lib/**/*.json;
                                     $(BrowserAssetRoot)src/ETL-SQL.Portal/BrowserContracts/**/*.json;
                                     $(BrowserAssetRoot)tests/ETL-SQL.Portal.Tests/*BrowserContractsGenerator.cs;
                                     $(BrowserAssetRoot)tests/ETL-SQL.Portal.Tests/*BrowserContractsGeneratorTests.cs"
                             Exclude="$(BrowserAssetRoot)**/*.__test-*.mjs" />
      <_BrowserInputConfiguration Include="$(BrowserAssetRoot)scripts/compile-browser.mjs;
                                          $(BrowserAssetRoot)scripts/sync-assets.js;
                                          $(BrowserAssetRoot)scripts/generate-portal-browser-contract.mjs;
                                          $(BrowserAssetRoot)scripts/generate-browser-contracts.mjs;
                                          $(BrowserAssetRoot)tsconfig.browser-build.json;
                                          $(BrowserAssetRoot)scripts/typecheck/package.json;
                                          $(BrowserAssetRoot)scripts/typecheck/package-lock.json;
                                          $(BrowserAssetRoot)scripts/typecheck/.npmrc;
                                          $(BrowserAssetRoot)Directory.Build.props;$(BrowserAssetRoot)Directory.Build.targets;
                                          $(BrowserAssetRoot)src/ETL-SQL.Reporting/ETL-SQL.Reporting.csproj;
                                          $(BrowserAssetRoot)src/ETL-SQL.ReportRuntime/ETL-SQL.ReportRuntime.csproj;
                                          $(BrowserAssetRoot)src/ETL-SQL.ReportPlayer/ETL-SQL.ReportPlayer.csproj;
                                          $(BrowserAssetRoot)src/ETL-SQL.WorkstationEditor/ETL-SQL.WorkstationEditor.csproj;
                                          $(BrowserAssetRoot)src/ETL-SQL.Portal/ETL-SQL.Portal.csproj;
                                          $(BrowserAssetRoot)src/etl-sql-vscode/.vscodeignore;
                                          $(BrowserAssetRoot)src/etl-sql-vscode/package.json;
                                          $(BrowserAssetRoot)src/etl-sql-vscode/ui/package.json;
                                          $(BrowserAssetRoot)src/etl-sql-vscode/ui/vite.config.ts" />
      <_BrowserCurrentSource Include="@(_BrowserInputConfiguration)" Condition="Exists('%(_BrowserInputConfiguration.Identity)')" />
      <_BrowserUnpreparedSource Include="@(_BrowserCurrentSource)" Exclude="@(_BrowserPreparedAsset)" />
    </ItemGroup>
    <Error Condition="'@(_BrowserUnpreparedSource)' != ''"
           Text="Browser sources have not been prepared: @(_BrowserUnpreparedSource). Run node scripts/sync-assets.js before building." />
    <GetFileHash Files="@(_BrowserPreparedAsset)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_VerifiedBrowserAsset" />
    </GetFileHash>
    <Error Condition="'%(_VerifiedBrowserAsset.FileHash)' != '%(_VerifiedBrowserAsset.ExpectedHash)'"
           Text="Prepared browser asset is stale: %(_VerifiedBrowserAsset.Identity). Run node scripts/sync-assets.js before building." />
  </Target>

  <!-- Publishing or running without a build skips PrepareForBuild, and with it every check above.
       Reused binaries must have been built from the preparation that is on disk now. This runs
       whether or not a build came first: dotnet run does not set NoBuild when it is given
       no-build, and after a real build the record is current, so the check costs nothing. -->
  <Target Name="VerifyBuiltBrowserAssets" BeforeTargets="Publish;ComputeRunArguments"
          Condition="'$(RequiresBrowserAssets)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BrowserBuiltRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_BrowserBuiltRuntime>
      <_BrowserBuiltRuntime Condition="'$(RuntimeIdentifier)' == ''">any</_BrowserBuiltRuntime>
      <_BrowserBuiltStamp>$(BrowserAssetRoot)artifacts/browser-assets-built/$(MSBuildProjectName).$(Configuration).$(_BrowserBuiltRuntime).sha256</_BrowserBuiltStamp>
    </PropertyGroup>
    <Error Condition="!Exists('$(BrowserAssetManifest)')"
           Text="Browser assets are not prepared. Run node scripts/sync-assets.js, then build without --no-build." />
    <Error Condition="!Exists('$(_BrowserBuiltStamp)')"
           Text="$(MSBuildProjectName) has no build recorded for the prepared browser assets. Build without --no-build." />
    <GetFileHash Files="$(BrowserAssetManifest)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_BrowserCurrentManifest" />
    </GetFileHash>
    <ReadLinesFromFile File="$(_BrowserBuiltStamp)">
      <Output TaskParameter="Lines" PropertyName="_BrowserBuiltHash" />
    </ReadLinesFromFile>
    <Error Condition="'%(_BrowserCurrentManifest.FileHash)' != '$(_BrowserBuiltHash)'"
           Text="$(MSBuildProjectName) was built from an older browser asset preparation. Build without --no-build." />
  </Target>

  <!-- A test project is not an asset consumer itself, but it runs the hosts it references. With
       dotnet test no-build those hosts are whatever was built last, so each referenced host's build
       record is compared with the preparation on disk. dotnet test builds inside the VSTest target,
       after this hook, so the check is limited to runs that skip the build (VSTestNoBuild). -->
  <Target Name="VerifyBuiltBrowserAssetsForTests" BeforeTargets="VSTest"
          Condition="'$(IsTestProject)' == 'true' And '$(VSTestNoBuild)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_BrowserHostReference Include="@(ProjectReference->'%(Filename)')"
                             Condition="'%(Filename)' == 'ETL-SQL.Reporting' Or '%(Filename)' == 'ETL-SQL.ReportRuntime' Or '%(Filename)' == 'ETL-SQL.ReportPlayer' Or '%(Filename)' == 'ETL-SQL.WorkstationEditor' Or '%(Filename)' == 'ETL-SQL.Portal'" />
      <_BrowserHostStamp Include="@(_BrowserHostReference->'$(BrowserAssetRoot)artifacts/browser-assets-built/%(Identity).$(Configuration).any.sha256')" />
    </ItemGroup>
    <Error Condition="'@(_BrowserHostStamp)' != '' And !Exists('$(BrowserAssetManifest)')"
           Text="Browser assets are not prepared. Run node scripts/sync-assets.js, then build without --no-build." />
    <Error Condition="'@(_BrowserHostStamp)' != '' And !Exists('%(_BrowserHostStamp.Identity)')"
           Text="$(MSBuildProjectName) would test a host with no build recorded for the prepared browser assets (%(_BrowserHostStamp.Filename)). Build without --no-build." />
    <GetFileHash Files="$(BrowserAssetManifest)" Algorithm="SHA256" Condition="'@(_BrowserHostStamp)' != ''">
      <Output TaskParameter="Items" ItemName="_BrowserTestManifest" />
    </GetFileHash>
    <ReadLinesFromFile File="%(_BrowserHostStamp.Identity)" Condition="'@(_BrowserHostStamp)' != ''">
      <Output TaskParameter="Lines" ItemName="_BrowserHostBuiltHash" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_BrowserTestManifestHash>@(_BrowserTestManifest->'%(FileHash)')</_BrowserTestManifestHash>
    </PropertyGroup>
    <Error Condition="'@(_BrowserHostBuiltHash)' != '' And '%(_BrowserHostBuiltHash.Identity)' != '$(_BrowserTestManifestHash)'"
           Text="$(MSBuildProjectName) would test a host built from an older browser asset preparation. Build without --no-build." />
  </Target>

  <!-- Records which preparation each build consumed. Entry points that skip the build compare this
       with the current manifest, so assemblies and copied assets from an older preparation cannot
       be tested or accepted as the candidate. See scripts/check-built-browser-assets.mjs. -->
  <Target Name="StampBuiltBrowserAssets" AfterTargets="Build"
          Condition="'$(RequiresBrowserAssets)' == 'true' And '$(DesignTimeBuild)' != 'true' And Exists('$(BrowserAssetManifest)')">
    <PropertyGroup>
      <_BrowserBuiltRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_BrowserBuiltRuntime>
      <_BrowserBuiltRuntime Condition="'$(RuntimeIdentifier)' == ''">any</_BrowserBuiltRuntime>
      <_BrowserBuiltStamp>$(BrowserAssetRoot)artifacts/browser-assets-built/$(MSBuildProjectName).$(Configuration).$(_BrowserBuiltRuntime).sha256</_BrowserBuiltStamp>
    </PropertyGroup>
    <GetFileHash Files="$(BrowserAssetManifest)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_BrowserBuiltManifest" />
    </GetFileHash>
    <WriteLinesToFile File="$(_BrowserBuiltStamp)" Lines="@(_BrowserBuiltManifest->'%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- A cleaned project has no binaries for the record to describe. -->
  <Target Name="RemoveBuiltBrowserAssetStamp" AfterTargets="Clean" Condition="'$(RequiresBrowserAssets)' == 'true'">
    <PropertyGroup>
      <_BrowserBuiltRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_BrowserBuiltRuntime>
      <_BrowserBuiltRuntime Condition="'$(RuntimeIdentifier)' == ''">any</_BrowserBuiltRuntime>
    </PropertyGroup>
    <Delete Files="$(BrowserAssetRoot)artifacts/browser-assets-built/$(MSBuildProjectName).$(Configuration).$(_BrowserBuiltRuntime).sha256" />
  </Target>
</Project>
