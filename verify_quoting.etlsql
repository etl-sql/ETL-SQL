-- Verification: CR-S2 (SQL Identifier Quoting)
-- We use a table name with spaces to trigger the quoting logic.

CREATE CONNECTION mock_dest ON MOCKDB() WITH(DIALECT='MSSQL');

SET WHAT_IF ON;

-- This should produce [Schema].[Table With Space]
SELECT * INTO mock_dest.dbo."Table With Space" FROM (SELECT 1 AS ID) AS src;

-- This should produce a MERGE with [dbo].[Target Table]
MERGE INTO mock_dest.dbo."Target Table" AS T
USING (SELECT 1 AS ID) AS S ON T.ID = S.ID
WHEN NOT MATCHED THEN INSERT (ID) VALUES (S.ID);

SET WHAT_IF OFF;
