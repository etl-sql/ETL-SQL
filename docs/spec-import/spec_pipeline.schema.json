{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etl-sql.local/schemas/spec_pipeline.schema.json",
  "title": "ETL-SQL Specification Pipeline Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipeline_name", "metadata"],
  "oneOf": [
    {
      "required": ["destination", "schema"],
      "not": { "required": ["datasets"] }
    },
    {
      "required": ["datasets"],
      "not": {
        "anyOf": [
          { "required": ["destination"] },
          { "required": ["schema"] },
          { "required": ["source"] }
        ]
      }
    }
  ],
  "properties": {
    "pipeline_name": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "source_evidence": {
      "$ref": "#/$defs/source_evidence"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "destination": {
      "$ref": "#/$defs/destination"
    },
    "schema": {
      "$ref": "#/$defs/schema"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "destination", "schema"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "source_evidence": {
            "$ref": "#/$defs/source_evidence"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "destination": {
            "$ref": "#/$defs/destination"
          },
          "schema": {
            "$ref": "#/$defs/schema"
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "classification", "owner"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["text"] },
        { "required": ["section"] },
        { "required": ["original_field_name"] }
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "original_field_name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_evidence": {
          "$ref": "#/$defs/source_evidence"
        },
        "connector_type": {
          "type": "string",
          "enum": ["FLATFILE", "MSSQL", "POSTGRES", "MYSQL", "ORACLE", "SNOWFLAKE", "BIGQUERY"]
        },
        "format": {
          "type": "string",
          "enum": ["CSV", "TSV", "PIPE", "EXCEL", "JSON", "XML", "PARQUET", "AVRO", "DB_TABLE"]
        },
        "path": {
          "type": "string"
        },
        "delimiter": {
          "type": "string",
          "enum": ["comma", "tab", "pipe", "none"]
        },
        "text_qualifier": {
          "type": "string",
          "enum": ["doublequote", "singlequote", "none"]
        },
        "encoding": {
          "type": "string",
          "enum": ["UTF8", "ANSI", "ASCII", "UNICODE"]
        },
        "has_header": {
          "type": "boolean"
        },
        "header_rows": {
          "type": "integer",
          "minimum": 0
        },
        "skip_rows": {
          "type": "integer",
          "minimum": 0
        },
        "sheet_name": {
          "type": "string"
        },
        "record_terminator": {
          "type": "string"
        },
        "null_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duplicate_policy": {
          "type": "string",
          "enum": ["allow", "first_wins", "last_wins", "reject"]
        },
        "reject_policy": {
          "type": "string",
          "enum": ["fail_batch", "quarantine", "warn"]
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_type", "format", "path"],
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_evidence": {
          "$ref": "#/$defs/source_evidence"
        },
        "connector_type": {
          "type": "string",
          "enum": ["FLATFILE", "MSSQL", "POSTGRES", "MYSQL", "ORACLE", "SNOWFLAKE", "BIGQUERY"]
        },
        "format": {
          "type": "string",
          "enum": ["CSV", "TSV", "PIPE", "EXCEL", "JSON", "XML", "PARQUET", "AVRO", "DB_TABLE"]
        },
        "delimiter": {
          "type": "string",
          "enum": ["comma", "tab", "pipe", "none"]
        },
        "text_qualifier": {
          "type": "string",
          "enum": ["doublequote", "singlequote", "none"]
        },
        "encoding": {
          "type": "string",
          "enum": ["UTF8", "ANSI", "ASCII", "UNICODE"]
        },
        "naming_pattern": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "has_header": {
          "type": "boolean"
        }
      }
    },
    "schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_name", "type_family", "nullable"],
      "properties": {
        "column_name": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_evidence": {
          "$ref": "#/$defs/source_evidence"
        },
        "source_name": {
          "type": "string"
        },
        "start_position": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "type_family": {
          "type": "string",
          "enum": ["INT", "DECIMAL", "VARCHAR", "DATE", "DATETIME", "BIT"]
        },
        "max_length": {
          "type": "integer",
          "minimum": 1
        },
        "precision": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "nullable": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "validation_regex": {
          "type": "string"
        },
        "date_format": {
          "type": "string"
        },
        "null_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "is_key": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fail_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fail_action": {
          "type": "string",
          "enum": ["THROW", "WARN", "QUARANTINE"]
        },
        "mapping_type": {
          "type": "string",
          "enum": ["lookup", "aggregation", "constant", "flat"]
        },
        "mapping_rule": {
          "type": "string"
        }
      }
    }
  }
}
