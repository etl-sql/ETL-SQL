{
  // Browser-side type gate.
  //
  // The shipped browser code stays plain `.js` and is served verbatim — nothing here emits,
  // bundles or rewrites a single file. This config only points a checker at the sources that
  // already exist, so the same class of defect the suite cannot see (a name that is not in
  // scope, a field that is not on the object) fails a gate instead of a page.
  //
  // Two rules keep the file list honest:
  //   1. Only canonical sources are listed. Host copies under a wwwroot are generated by
  //      `node scripts/sync-assets.js`, which stamps `// @ts-nocheck` into their banner, so a
  //      copy pulled in by an import is not checked twice under a second path.
  //   2. Vendored bundles are not ours to fix. They carry `// @ts-nocheck` for the same reason.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Deliberately not `strict`. The goal of step 1 is a gate that passes today and catches
    // real scope and shape errors; turning on `strictNullChecks` over ~29k lines of existing
    // browser code would bury those under thousands of "possibly undefined" findings and the
    // gate would never be switched on. Tighten in a later pass, one flag at a time.
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/ETL-SQL.ReportRuntime/Resources/Shared/**/*.js",
    "src/ETL-SQL.Portal/wwwroot/js/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/bin",
    "**/obj",
    ".worktrees",
    "**/*.min.js",

    // Generated host copies of the canonical shared assets. See scripts/sync-assets.js.
    "src/ETL-SQL.Portal/wwwroot/js/report-runtime.js",
    "src/ETL-SQL.Portal/wwwroot/js/feedback.js"
  ]
}
