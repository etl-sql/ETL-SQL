<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>0.22.0</VersionPrefix>
    <Authors>Charles Clemens</Authors>
    <Company>ETL-SQL</Company>
    <Product>ETL-SQL Engine</Product>
    <Description>A hybrid ETL engine for SQL, NoSQL, and FlatFiles.</Description>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) Charles Clemens</Copyright>
    <RepositoryUrl>https://github.com/etl-sql/ETL-SQL.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/etl-sql/ETL-SQL</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Consumer tests use temporary module siblings; they are never product assets. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.__test-*.mjs</DefaultItemExcludes>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build/signing/etl-sql.snk</AssemblyOriginatorKeyFile>
    <AssemblyPublicKey></AssemblyPublicKey>
    
    <!-- Portability & Single-File Config (Only active when an RID is provided) -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">false</SelfContained>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <!-- Single-file ReadyToRun defaults to a composite image, which recompiles the whole .NET and
         ASP.NET Core framework into every host (8 per platform). Non-composite compiles only our
         assemblies and keeps the runtime pack's precompiled framework: about half the publish
         time on 4 cores (ETL-SQL.App 79 s -> 41 s), a 74 MB smaller App, ~10 ms slower warm start.
         Owner decision 2026-11-09, after osx-x64 native publishing outgrew its 75-minute budget. -->
    <PublishReadyToRunComposite Condition="'$(PublishReadyToRunComposite)' == ''">false</PublishReadyToRunComposite>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
