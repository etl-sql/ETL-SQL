# ETL-SQL HA deployment settings. Copy to ha.env and edit every CHANGE_ME value.
#   docker compose -f docker-compose.ha.yml --env-file ha.env up -d

# Image tag (pin to a release in production, e.g. v0.12.0).
ETLSQL_IMAGE_TAG=latest

# Replica counts (override at runtime with --scale portal=N --scale orchestrator=N).
PORTAL_REPLICAS=3
ORCH_REPLICAS=2

# Public HTTP port the Traefik load balancer publishes for the Portal.
PORTAL_HTTP_PORT=8080

# PostgreSQL (shared state for all replicas).
PG_USER=etlsql
PG_PASSWORD=CHANGE_ME_strong_password
PG_DB_PORTAL=portal
PG_DB_ORCH=orch

# Keys — identical across all replicas of the same environment; generate strong values.
#   ETL-SQL config setup-jwt   /   openssl rand -base64 32
PORTAL_JWT_SECRET=CHANGE_ME_unique_32char_minimum_secret_value
PORTAL_DATASET_KEY=CHANGE_ME_base64_32_byte_key
ORCH_API_KEY=CHANGE_ME_unique_orchestrator_api_key
