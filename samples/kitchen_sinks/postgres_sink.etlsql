-- POSTGRES Kitchen Sink
SET WHAT_IF OFF;
PRINT 'Starting Postgres container...';
USE DOCKER('postgres:15-alpine') AS pg;
CREATE CONNECTION db ON POSTGRES(pg.CONNECTION_STRING);

-- 1. Basic DDL & DML
PRINT 'Testing Postgres basic operations...';
EXECUTE db BEGIN
    CREATE TABLE kitchen_sink (
        id SERIAL PRIMARY KEY,
        val VARCHAR(100),
        ts TIMESTAMP DEFAULT NOW()
    );
END;

SELECT 1 AS id, 'Hello' AS val INTO #push;
INSERT INTO db.kitchen_sink SELECT * FROM #push;

PRINT 'Querying Postgres...';
SELECT * FROM db.kitchen_sink;

CLOSE DOCKER pg;
