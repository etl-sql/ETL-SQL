-- DRILL_IN hierarchy demo
-- Click a bar to drill down from Year → Quarter → Month.
-- Click a breadcrumb segment to drill back up.

SELECT 2023 AS Year, 1 AS Quarter, 1 AS Month, 120000.00 AS Revenue INTO #sales_raw
UNION ALL SELECT 2023, 1, 2, 135000
UNION ALL SELECT 2023, 1, 3, 98000
UNION ALL SELECT 2023, 2, 4, 142000
UNION ALL SELECT 2023, 2, 5, 160000
UNION ALL SELECT 2023, 2, 6, 175000
UNION ALL SELECT 2023, 3, 7, 130000
UNION ALL SELECT 2023, 3, 8, 145000
UNION ALL SELECT 2023, 3, 9, 155000
UNION ALL SELECT 2023, 4, 10, 190000
UNION ALL SELECT 2023, 4, 11, 210000
UNION ALL SELECT 2023, 4, 12, 225000
UNION ALL SELECT 2024, 1, 1, 140000
UNION ALL SELECT 2024, 1, 2, 158000
UNION ALL SELECT 2024, 1, 3, 112000
UNION ALL SELECT 2024, 2, 4, 168000
UNION ALL SELECT 2024, 2, 5, 182000
UNION ALL SELECT 2024, 2, 6, 195000
UNION ALL SELECT 2024, 3, 7, 152000
UNION ALL SELECT 2024, 3, 8, 171000
UNION ALL SELECT 2024, 3, 9, 163000
UNION ALL SELECT 2024, 4, 10, 215000
UNION ALL SELECT 2024, 4, 11, 238000
UNION ALL SELECT 2024, 4, 12, 252000;

SET REPORT TITLE = 'DRILL_IN Hierarchy Demo';
SET REPORT DESCRIPTION = 'Click a bar to drill Year → Quarter → Month. Click breadcrumb to navigate back.';

CREATE VISUAL SalesByPeriod AS BAR (
    SOURCE = (SELECT Year, Quarter, Month, Revenue FROM #sales_raw),
    MAPPINGS (x = Year, y = Revenue),
    OPTIONS (title = 'Revenue by Period (click to drill)'),
    ACTIONS (
        ON_CLICK = DRILL_IN(HIERARCHY = (Year, Quarter, Month))
    )
);

CREATE PAGE Demo AS DASHBOARD (
    STRUCTURE = 'A',
    MAP ('A' = SalesByPeriod)
);
