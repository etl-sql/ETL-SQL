-- Drawer & Pinnable Container Verification
-- This script tests the DRAWER container type with ICON and PINNABLE layout.

CREATE CONNECTION mock ON MOCKDB();

SELECT 'John' as name, 100 as sales, 'East' as region
INTO #data;

CREATE VISUAL SalesTable AS TABLE (
    SOURCE = (SELECT * FROM #data)
);

CREATE VISUAL RegionFilter AS SLICER (
    SOURCE = (SELECT DISTINCT region FROM #data),
    MAPPINGS (VALUE = region),
    ACTIONS (ON_CHANGE = SET_PARAMETER(@region, region))
);

-- Define a drawer container for filters
CREATE CONTAINER FilterPanel AS DRAWER (
    TITLE = 'Filters',
    ICON = 'FILTER',
    LAYOUT (
        STRUCTURE = 'A',
        MAP ('A' = RegionFilter),
        PINNABLE = ON
    )
);

-- Page layout: A is the collapsible filter, B is the main content
CREATE PAGE MainView AS DASHBOARD (
    STRUCTURE = 'A B',
    MAP (
        'A' = FilterPanel,
        'B' = SalesTable
    )
);

SET REPORT TITLE = 'Collapsible Container Test';
