-- @requires: portal
-- Consumes datasets the producer script deployed to the portal, so it needs portal
-- execution for the registry, folders, identity and ACLs. Parser coverage is in
-- DatasetExampleDeckTests; the CLI sample gate skips it.
-- Expected result: USE DATASET fails without revealing whether the private
-- dataset exists. Run as a non-owner who has no explicit dataset grant.

USE DATASET &sales_private;

-- This statement must not execute.
SELECT * FROM &sales_private;
