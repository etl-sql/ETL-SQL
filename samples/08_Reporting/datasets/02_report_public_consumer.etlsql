-- @requires: portal
-- Consumes datasets the producer script deployed to the portal, so it needs portal
-- execution for the registry, folders, identity and ACLs. Parser coverage is in
-- DatasetExampleDeckTests; the CLI sample gate skips it.
-- Deploy this consumer to /Dataset Deck/Consumers, not the producer folder.
-- Run as a user who can read the producer folder.

USE DATASET &sales_public;

SELECT sale_id, region, amount
FROM &sales_public
ORDER BY sale_id;
