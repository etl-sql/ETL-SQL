-- Main Orchestration: HR Data Conversion (30 Entities)
-- Path: samples/09_Conversions/main.etlsql
-- @requires: postgres

SET ALLOW_FILE_OPERATIONS = 10000;

DECLARE @InputDir   PATH = 'extract_staging/';
DECLARE @OutputDir  PATH = 'output/';
DECLARE @KeyDir     PATH = 'keys/';
DECLARE @ZipFile    PATH = 'hr_migration.zip';

-- 2. Define System A Connection
CREATE CONNECTION system_a AS POSTGRES(HOST='localhost', PORT=5432, DATABASE='postgres', USER='postgres', PASSWORD='postgres');

DECLARE @entities LIST = (
    'hr_01_employees', 'hr_02_demographics', 'hr_03_salary_history', 'hr_04_job_history', 
    'hr_05_w4_info', 'hr_06_dependents', 'hr_07_performance', 'hr_08_training', 
    'hr_09_benefits', 'hr_10_contacts', 'hr_11_leave_req', 'hr_12_time_entries', 
    'hr_13_stock_grants', 'hr_14_skills', 'hr_15_equipment', 'hr_16_locations', 
    'hr_17_cost_centers', 'hr_18_budgets', 'hr_19_projects', 'hr_20_time_off', 
    'hr_21_grievances', 'hr_22_health', 'hr_23_background', 'hr_24_visa', 
    'hr_25_education', 'hr_26_employers', 'hr_27_interviews', 'hr_28_onboarding', 
    'hr_29_offboarding', 'hr_30_access_logs'
);

BEGIN TRY
    PRINT 'Starting Conversion of 30 HR Entities...';

    -- Ensure schemas are initialized
    RUN SCRIPT 'system_a/setup_db.etlsql';
    RUN SCRIPT 'system_b/setup_sys_b.etlsql';

    IF NOT DIRECTORY_EXISTS(@InputDir)
        CREATE DIRECTORY @InputDir;
    IF NOT DIRECTORY_EXISTS(@OutputDir)
        CREATE DIRECTORY @OutputDir;
    IF NOT DIRECTORY_EXISTS(@KeyDir)
        CREATE DIRECTORY @KeyDir;

    DECLARE @pubKey PATH = @KeyDir + 'public.asc';
    IF NOT FILE_EXISTS(@pubKey)
    BEGIN
        PRINT 'Generating PGP Key Pair...';
        CREATE PGP_KEY_PAIR @KeyDir 
            WITH(IDENTITY='HR-Migration <hr@company.com>', PASSPHRASE='hr-secret');
    END

    -- 3. Extract and Clean each entity
    FOREACH @entity IN @entities
    BEGIN
        PRINT 'Processing Topic: ' + @entity;
        
        -- RUN SCRIPT handles specialized enforcement for each topic
        RUN SCRIPT 'system_a/export_entity.etlsql' 
            WITH (@Topic = @entity);
            
        -- Data is staged in #ExportSet by the sub-script
        DECLARE @targetPath = @InputDir + @entity + '.csv';
        CREATE CONNECTION temp_csv AS FLATFILE(PATH = @targetPath, DELIMITER = PIPE, HEADER = ON, ENCODING = 'UTF8');
        INSERT INTO temp_csv.FILE SELECT * FROM #ExportSet;
        DROP CONNECTION temp_csv;
        DROP TABLE #ExportSet;
        
        -- 4. Secure the data (Encrypt)
        DECLARE @pgpPath = @targetPath + '.pgp';
        ENCRYPT FILE @targetPath TO @pgpPath PGP_KEY @pubKey;
            
        DELETE FILE @targetPath;
    END

    -- 5. Bundle for transport
    PRINT 'Compressing migration package...';
    COMPRESS DIRECTORY @InputDir TO @ZipFile WITH(OVERWRITE=ON);
    DELETE DIRECTORY_CONTENTS @InputDir WITH(RECURSIVE=ON);
    DELETE DIRECTORY @InputDir;

    -- 6. Hand off to System B
    PRINT 'Handing off to System B...';
    RUN SCRIPT 'system_b/import_main.etlsql';

    IF FILE_EXISTS(@ZipFile)
        DELETE FILE @ZipFile;
    IF DIRECTORY_EXISTS(@OutputDir)
    BEGIN
        DELETE DIRECTORY_CONTENTS @OutputDir WITH(RECURSIVE=ON);
        DELETE DIRECTORY @OutputDir;
    END

    IF DIRECTORY_EXISTS(@KeyDir)
    BEGIN
        DELETE DIRECTORY_CONTENTS @KeyDir WITH(RECURSIVE=ON);
        DELETE DIRECTORY @KeyDir;
    END

    PRINT 'Conversion Complete.';

END TRY
BEGIN CATCH
    PRINT 'Conversion failed: ' + ERROR_MESSAGE();
    THROW;
END CATCH
