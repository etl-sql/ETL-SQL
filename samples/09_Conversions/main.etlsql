-- Main Orchestration: HR Data Conversion (30 Entities)
-- Path: samples/09_Conversions/main.etlsql
-- @requires: postgres

-- 1. Setup Environment
DECLARE @InputDir   PATH = 'c:\Users\chuck\scratch\ETL-SQL\samples\09_Conversions\extract_staging\';
DECLARE @OutputDir  PATH = 'c:\Users\chuck\scratch\ETL-SQL\samples\09_Conversions\output\';
DECLARE @ZipFile    PATH = 'c:\Users\chuck\scratch\ETL-SQL\samples\09_Conversions\hr_migration.zip';

-- 2. Define System A Connection
CREATE CONNECTION system_a ON POSTGRES() 
    WITH(HOST='localhost', PORT=5432, DATABASE='postgres', USER='postgres', PASSWORD='postgres');

DECLARE @entities LIST = (
    'hr_01_employees', 'hr_02_demographics', 'hr_03_salary_history', 'hr_04_job_history', 
    'hr_05_w4_info', 'hr_06_dependents', 'hr_07_performance', 'hr_08_training', 
    'hr_09_benefits', 'hr_10_contacts', 'hr_11_leave_req', 'hr_12_time_entries', 
    'hr_13_stock_grants', 'hr_14_skills', 'hr_15_equipment', 'hr_16_locations', 
    'hr_17_cost_centers', 'hr_18_budgets', 'hr_19_projects', 'hr_20_time_off', 
    'hr_21_grievances', 'hr_22_health', 'hr_23_background', 'hr_24_visa', 
    'hr_25_education', 'hr_26_employers', 'hr_27_interviews', 'hr_28_onboarding', 
    'hr_29_offboarding', 'hr_30_access_logs'
);

BEGIN TRY
    PRINT 'Starting Conversion of 30 HR Entities...';

    -- 3. Extract and Clean each entity
    FOREACH @entity IN @entities
    BEGIN
        PRINT 'Processing Topic: ' + @entity;
        
        -- RUN SCRIPT handles specialized enforcement for each topic
        RUN SCRIPT 'samples/09_Conversions/system_a/export_entity.etlsql' 
            WITH (@Topic = @entity);
            
        -- Data is staged in #ExportSet by the sub-script
        DECLARE @targetPath = @InputDir + @entity + '.csv';
        SELECT * INTO FLATFILE(@targetPath) FROM #ExportSet;
        
        -- 4. Secure the data (Encrypt)
        DECLARE @pgpPath = @targetPath + '.pgp';
        ENCRYPT FILE @targetPath TO @pgpPath 
            PGP_KEY 'samples/09_Conversions/keys/public.asc';
            
        DELETE FILE @targetPath;
    END

    -- 5. Bundle for transport
    PRINT 'Compressing migration package...';
    COMPRESS DIRECTORY @InputDir TO @ZipFile;

    -- 6. Hand off to System B
    PRINT 'Handing off to System B...';
    RUN SCRIPT 'samples/09_Conversions/system_b/import_main.etlsql';

    PRINT 'Conversion Complete. 30 files generated in ' + @OutputDir;

END TRY
BEGIN CATCH
    PRINT 'Conversion failed: ' + ERROR_MESSAGE();
    THROW;
END CATCH
