-- Transform: TRANSFORM USING NORMALIZE
-- Demonstrates: Min-Max scaling and Z-Score normalization for machine learning features
-- and comparative analytics across partitioned categories.

-- 1. Mock exam scores across multiple classes
SELECT 'Class A' AS ClassName, 'Student 1' AS Student, 65.0 AS Score INTO #exam_scores
UNION ALL SELECT 'Class A', 'Student 2', 82.0
UNION ALL SELECT 'Class A', 'Student 3', 95.0
UNION ALL SELECT 'Class A', 'Student 4', 74.0
UNION ALL SELECT 'Class B', 'Student 5', 40.0
UNION ALL SELECT 'Class B', 'Student 6', 70.0
UNION ALL SELECT 'Class B', 'Student 7', 100.0;

-- 2. Execute declarative NORMALIZE transform (Min-Max Scaling 0.0 - 1.0 within class)
TRANSFORM #normalized_scores
FROM #exam_scores
USING NORMALIZE (
    VALUE_COL = 'Score',
    METHOD    = 'MIN_MAX',
    BY_GROUP  = 'ClassName',
    NORM_COL  = 'ScaledScore'
);

PRINT '=== Min-Max Normalized Scores (0.0 to 1.0 within Class) ===';
SELECT ClassName, Student, Score, ScaledScore
FROM #normalized_scores
ORDER BY ClassName, Student;
