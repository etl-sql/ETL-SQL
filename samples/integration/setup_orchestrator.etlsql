USE PASSWORD PROMPT;
-- ==============================================================================
-- setup_orchestrator.etlsql
-- Registers the Orchestrator jobs and publishes the report dataset.
-- @requires: orchestrator
-- ==============================================================================

-- 1. Create connection to the Orchestrator Service
DROP CONNECTION IF EXISTS orch;
CREATE CONNECTION orch AS ORCHESTRATOR(HOST='localhost', PORT=5001, API_KEY='ENC:AXllqv7L+qj6c3UFQlHUjypkqRtvA6ufSt6XIX9G2yYGfwAtrw8GNJlpnYkDGL90J3mtIpVtZNMeTQBuK4I108w=');
SHOW JOBS AT orch;
SHOW JOB HISTORY AT orch;


EXECUTE orch
BEGIN
    -- 2. Publish the integration scripts into the remote Orchestrator lockbox.
    --    Unversioned orch:// paths below are pinned to the latest published version
    --    when the scheduled jobs are created or updated.
    PUBLISH BUNDLE 'manufacturing-integration'
        FROM '/samples/integration'
        ENTRY 'generate_manufacturing.etlsql';

    -- 3. Schedule Job 1: Generate Data (Top of the hour)
    CREATE OR ALTER JOB GenerateManufacturingData ON SCHEDULE EVERY 1 HOUR AS
        RUN SCRIPT 'orch://manufacturing-integration/generate_manufacturing.etlsql';

    -- 4. Schedule Job 2: Append to Parquet (5 minutes past the hour)
    CREATE OR ALTER JOB AppendToParquet ON SCHEDULE EVERY 1 HOUR AT '00:05' AS
        RUN SCRIPT 'orch://manufacturing-integration/append_to_parquet.etlsql';
END;

PRINT 'Orchestrator Jobs created successfully.';

-- 5. Publish the Report and Dataset to the Portal
-- The dataset definition is embedded in the report, so publishing the report registers the dataset.
CREATE CONNECTION portal AS REPORTPORTAL(HOST='localhost', PORT=5000, USER='admin', PASSWORD='ENC:AV1QYOWmcD/pmLkaT5Xpa0RZtNh40ndG3TUJY1LRjXm3iNoOtCR3+pmtfyAZ1Zzp9MWyI1F+GEfMfHr/oWBWQlA=');

EXECUTE portal 
BEGIN
    PUBLISH REPORT 'Manufacturing Analytics' 
        FROM '/app/Reports/integration/manufacturing_report.rptsql'
        IN FOLDER '/Finance';
END;

PRINT 'Report published successfully.';
