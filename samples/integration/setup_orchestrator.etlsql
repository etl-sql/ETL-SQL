-- ==============================================================================
-- setup_orchestrator.etlsql
-- Registers the Orchestrator jobs and publishes the report dataset.
-- @requires: orchestrator
-- ==============================================================================

-- 1. Create connection to the Orchestrator Service
DROP CONNECTION IF EXISTS orch;
CREATE CONNECTION orch AS ORCHESTRATOR(HOST='localhost', PORT=5001, API_KEY='LocalDevApiKey_32CharsMinimumRequiredForSecurity!');


EXECUTE orch
BEGIN
    -- 2. Publish the integration scripts into the remote Orchestrator lockbox.
    --    Unversioned orch:// paths below are pinned to the latest published version
    --    when the scheduled jobs are created or updated.
    PUBLISH BUNDLE 'manufacturing-integration'
        FROM '.'
        ENTRY 'generate_manufacturing.etlsql';

    -- 3. Schedule Job 1: Generate Data (top of the hour)
    CREATE OR ALTER SCHEDULE ManufacturingTopOfHour
        ON '0 * * * *'
        AT TIME ZONE 'UTC';
    CREATE OR ALTER JOB GenerateManufacturingData
        FOR SCRIPT 'orch://manufacturing-integration/generate_manufacturing.etlsql';
    ALTER JOB GenerateManufacturingData ADD SCHEDULE ManufacturingTopOfHour;

    -- 4. Schedule Job 2: Append to Parquet (five minutes past the hour)
    CREATE OR ALTER SCHEDULE ManufacturingFivePast
        ON '5 * * * *'
        AT TIME ZONE 'UTC';
    CREATE OR ALTER JOB AppendToParquet
        FOR SCRIPT 'orch://manufacturing-integration/append_to_parquet.etlsql';
    ALTER JOB AppendToParquet ADD SCHEDULE ManufacturingFivePast;
END;

PRINT 'Orchestrator Jobs created successfully.';

-- 5. Publish the Report and Dataset to the Portal
-- The dataset definition is embedded in the report, so publishing the report registers the dataset.
CREATE CONNECTION portal AS PORTAL(HOST='http://localhost:5000', USER='admin', PASSWORD='Admin12345!Password');

EXECUTE portal 
BEGIN
    CREATE FOLDER '/Finance';
    PUBLISH REPORT 'Manufacturing Analytics' 
        FROM 'integration/manufacturing_report.rptsql'
        IN FOLDER '/Finance';
END;

PRINT 'Report published successfully.';
