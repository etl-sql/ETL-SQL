/* @owner: 'Manufacturing Analytics'; @steward: 'Manufacturing Analytics';
   @contact: 'manufacturing-analytics@example.test'; @classification: 'public'; @quality: 'gold'; */

DECLARE @parquet_file PATH = 'data/manufacturing_master.parquet';
IF FILE_EXISTS(@parquet_file)
BEGIN
    CREATE CONNECTION parquet_conn AS PARQUET(PATH=@parquet_file);
    CREATE OR ALTER DATASET &manufacturing_data
        ACCESS PUBLIC
        AS (SELECT * FROM parquet_conn);
END
ELSE
BEGIN
    CREATE OR ALTER DATASET &manufacturing_data
        ACCESS PUBLIC
        AS (
            SELECT 'M-100' AS MachineID, CAST('2026-01-01 00:00:00' AS DATETIME) AS EventTime, 85.5 AS Temperature, 32.1 AS Pressure, 'Running' AS Status
            UNION ALL
            SELECT 'M-101' AS MachineID, CAST('2026-01-01 00:05:00' AS DATETIME) AS EventTime, 92.0 AS Temperature, 35.4 AS Pressure, 'Warning' AS Status
        );
END

USE DATASET &manufacturing_data;
-- ==============================================================================
-- manufacturing_report.rptsql
-- Paginated report consuming the master Parquet dataset.
-- ==============================================================================

SET REPORT TITLE = 'Manufacturing Analytics';
SET REPORT DESCRIPTION = 'Hourly overview of machine telemetry and status.';



-- 2. Define Interactive Parameters
-- Users can filter by Start and End dates to view specific hours.
DECLARE @start_time DATETIME INPUT;
DECLARE @end_time   DATETIME INPUT;

-- 3. Define the paginated table visual
CREATE VISUAL TelemetryTable AS TABLE (
    FETCH = ON_RUN,
    SOURCE = (
        SELECT 
            MachineID,
            EventTime,
            Temperature,
            Pressure,
            Status
        FROM &manufacturing_data
        WHERE (@start_time IS NULL OR EventTime >= @start_time)
          AND (@end_time IS NULL OR EventTime <= @end_time)
        ORDER BY EventTime DESC
    ),
    OPTIONS (
        PAGINATION = ON
    )
);

-- 4. Define Filters
CREATE VISUAL StartTimeFilter AS DATEPICKER (
    TITLE = 'Start Date',
    ACTIONS (ON_CHANGE = SET_PARAMETER(@start_time, value))
);

CREATE VISUAL EndTimeFilter AS DATEPICKER (
    TITLE = 'End Date',
    ACTIONS (ON_CHANGE = SET_PARAMETER(@end_time, value))
);

-- 5. Layout
CREATE PAGE MainLayout AS PAGINATED (
    TITLE = 'Machine Telemetry',
    STRUCTURE = 'A B / C C',
    MAP (
        'A' = StartTimeFilter,
        'B' = EndTimeFilter,
        'C' = TelemetryTable
    ),
    STYLE (THEME = dark)
);
