-- ==============================================================================
-- append_to_parquet.etlsql
-- Reads the CSV generated in the last hour and appends it to a master Parquet file.
-- Intended to be run hourly via Orchestrator at 5 minutes past the top of the hour.
-- ==============================================================================

-- The current time is HH:05. The file from the current hour has the same HH timestamp.
-- Example: At 01:05, FORMAT yields '01'. The file generated at 01:00 also used '01'.
DECLARE @timestamp STRING = FORMAT(GETDATE(), 'yyyyMMdd_HH');
DECLARE @csv_file  STRING = '/app/data/manufacturing_' + @timestamp + '.csv';
DECLARE @parquet_master STRING = '/app/data/manufacturing_master.parquet';

IF NOT FILE_EXISTS(@csv_file)
BEGIN
    PRINT 'Expected CSV file not found: ' + @csv_file;
    RETURN;
END

PRINT 'Reading ' + @csv_file + '...';
CREATE CONNECTION csv_conn AS FLATFILE(@csv_file, HEADER=ON);

PRINT 'Appending to ' + @parquet_master + '...';
CREATE CONNECTION parquet_conn AS PARQUET(PATH=@parquet_master);

-- INSERT INTO appends to the target connection if it exists, or creates it if not.
INSERT INTO parquet_conn SELECT * FROM csv_conn;

PRINT 'Append complete.';


-- 1. Create the dataset from the master Parquet file.
-- This dataset acts as the semantic layer for the report visuals.
CREATE OR ALTER CONNECTION parquet_conn AS PARQUET(PATH='/app/data/manufacturing_master.parquet');

CREATE OR ALTER DATASET &manufacturing_data 
    REFRESH EVERY '1h'
    ACCESS PUBLIC
    AS (
        SELECT * FROM parquet_conn
    )
;
