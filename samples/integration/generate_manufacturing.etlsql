-- ==============================================================================
-- generate_manufacturing.etlsql
-- Generates hourly manufacturing data and saves it to a timestamped CSV.
-- Intended to be run hourly via Orchestrator at the top of the hour.
-- ==============================================================================

SET ALLOW_FILE_OPERATIONS = 2000;

PRINT 'Generating 1000 rows of manufacturing data...';

-- Generate raw data
GENERATE 1000 ROWS INTO #machine_data
WITH (SEED = 1)
AS (
    MachineID    = 'RANDOM(M-100, M-101, M-102, M-103)',
    EventTime    = 'SEQUENCE(2026-01-01, 1, MINUTE)',
    Temperature  = 'RANDOM_DECIMAL(60, 120)',
    Pressure     = 'RANDOM_DECIMAL(10, 50)',
    Status       = 'RANDOM(Running, Running, Running, Warning, Error)'
);

DECLARE @data_dir PATH = 'data/';
IF NOT DIRECTORY_EXISTS(@data_dir)
    CREATE DIRECTORY @data_dir;

-- Calculate output filename: data/manufacturing_yyyyMMdd_HH.csv
DECLARE @timestamp STRING = FORMAT(GETDATE(), 'yyyyMMdd_HH');
DECLARE @filename  PATH   = @data_dir + 'manufacturing_' + @timestamp + '.csv';

PRINT 'Exporting to ' + @filename + '...';

-- Write to CSV
CREATE CONNECTION export_conn AS FLATFILE(PATH=@filename, HEADER=ON);
INSERT INTO export_conn SELECT * FROM #machine_data;
DROP CONNECTION export_conn;

PRINT 'Generation complete.';
