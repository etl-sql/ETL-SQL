-- Sample: Text Qualifiers (Handling Embedded Commas & Quotes)
-- Demonstrates TEXT_QUALIFIER = DOUBLEQUOTE on flat file reading, writing, and cleanup.

-- 1. Read a CSV that has quoted fields (embedded commas, escaped quotes, and tabs)
CREATE CONNECTION src AS FLATFILE('TestData/test_qualified.csv', TEXT_QUALIFIER = DOUBLEQUOTE);

-- 2. Write the data to an output file preserving quotes
CREATE CONNECTION dst AS FLATFILE('TestData/test_qualified_output.csv', TEXT_QUALIFIER = DOUBLEQUOTE);

INSERT INTO dst
SELECT Name, City, Notes FROM src;

-- 3. Read back from output to verify embedded commas parsed and round-tripped correctly
PRINT 'Previewing records with preserved quotes and embedded commas:';
CREATE CONNECTION verify_conn AS FLATFILE('TestData/test_qualified_output.csv', TEXT_QUALIFIER = DOUBLEQUOTE);
SELECT Name, City, Notes FROM verify_conn;

-- 4. Clean up temporary output file
DELETE FILE 'TestData/test_qualified_output.csv';
