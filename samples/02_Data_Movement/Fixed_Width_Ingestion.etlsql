-- Sample: Fixed-Width File Ingestion
-- Demonstrates using a table schema as a layout template for fixed-width flat files.

-- 1. Define the layout via a temporary table
-- Use /* @width: N */ comments or standard types to define field lengths.
CREATE TABLE #Layout (
    EmpId CHAR(5),           -- Implicit width 5
    EmpName VARCHAR(20),     -- Implicit width 20
    Department VARCHAR(10),  -- Implicit width 10
    Salary CHAR(8)           -- Implicit width 8
);

-- 2. Define the fixed-width connection
-- FORMAT='FIXED' instructs the engine to use the TEMPLATE for offsets.
CREATE CONNECTION fw_source AS FLATFILE('TestData/fixed_employees.txt',
    FORMAT = 'FIXED',
    TEMPLATE = #Layout,
    HEADER = OFF,
    TRIM = 'ON'
);

-- 3. Ingestion Logic
-- The engine will slice each line at offsets (0, 5, 25, 35) based on #Layout.
PRINT 'Loading fixed-width data using template-based offsets:';
SELECT EmpId, EmpName, Department, Salary FROM fw_source;
