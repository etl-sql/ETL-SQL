-- Kitchen Sink: HEATMAP Visual
-- This script demonstrates the HEATMAP visual type for 2D density grids and correlation matrices.

SET REPORT TITLE = 'Kitchen Sink: HEATMAP Visual';
SET REPORT DESCRIPTION = 'Demonstration of HEATMAP grid visualization capabilities, including data labels and custom color gradients.';

-- 1. Mock Data Generation (Active Users across Weekday vs Hour)
SELECT 'Mon' AS Day, '08:00' AS Hour, 25 AS ActiveUsers INTO #heat
UNION ALL SELECT 'Mon', '12:00', 65
UNION ALL SELECT 'Mon', '16:00', 50
UNION ALL SELECT 'Mon', '20:00', 15
UNION ALL SELECT 'Tue', '08:00', 30
UNION ALL SELECT 'Tue', '12:00', 70
UNION ALL SELECT 'Tue', '16:00', 55
UNION ALL SELECT 'Tue', '20:00', 18
UNION ALL SELECT 'Wed', '08:00', 35
UNION ALL SELECT 'Wed', '12:00', 85
UNION ALL SELECT 'Wed', '16:00', 60
UNION ALL SELECT 'Wed', '20:00', 20
UNION ALL SELECT 'Thu', '08:00', 28
UNION ALL SELECT 'Thu', '12:00', 75
UNION ALL SELECT 'Thu', '16:00', 58
UNION ALL SELECT 'Thu', '20:00', 22
UNION ALL SELECT 'Fri', '08:00', 20
UNION ALL SELECT 'Fri', '12:00', 50
UNION ALL SELECT 'Fri', '16:00', 40
UNION ALL SELECT 'Fri', '20:00', 10
UNION ALL SELECT 'Sat', '08:00', CAST(NULL AS INT)
UNION ALL SELECT 'Sat', '12:00', 95
UNION ALL SELECT 'Sat', '16:00', 80
UNION ALL SELECT 'Sat', '20:00', CAST(NULL AS INT);

-- 2. Basic Heatmap
CREATE VISUAL BasicHeatmap AS HEATMAP (
    SOURCE = #heat,
    TITLE = 'User Activity Density (Day vs Hour)',
    MAPPINGS (X = Hour, Y = Day, VALUE = ActiveUsers)
);

-- 3. Heatmap with Data Labels
CREATE VISUAL LabeledHeatmap AS HEATMAP (
    SOURCE = #heat,
    TITLE = 'Activity Grid with In-Cell Counts',
    MAPPINGS (X = Hour, Y = Day, VALUE = ActiveUsers),
    OPTIONS (
        DATA_LABELS = ON
    )
);

-- 4. Styled Heatmap (Warm Amber/Red Gradient)
CREATE VISUAL StyledHeatmap AS HEATMAP (
    SOURCE = #heat,
    TITLE = 'High-Intensity Heatmap (Custom Palette)',
    MAPPINGS (X = Hour, Y = Day, VALUE = ActiveUsers),
    OPTIONS (
        COLORS (
            'min' = '#fff7bc',
            'max' = '#d95f0e'
        ),
        DATA_LABELS = ON
    )
);

-- 5. Diverging 3-Color Heatmap with NULL_COLOR
CREATE VISUAL DivergingHeatmap AS HEATMAP (
    SOURCE = #heat,
    TITLE = 'Diverging Palette (Blue-White-Red) & NULL_COLOR',
    MAPPINGS (X = Hour, Y = Day, VALUE = ActiveUsers),
    OPTIONS (
        COLOR_LOW   = '#2563eb',
        COLOR_MID   = '#f8fafc',
        COLOR_HIGH  = '#dc2626',
        MIDPOINT    = 50,
        NULL_COLOR  = '#cbd5e1',
        DATA_LABELS = ON
    )
);

-- 6. Cell Borders & Axis Sorting (X_SORT / Y_SORT)
CREATE VISUAL BorderedSortedHeatmap AS HEATMAP (
    SOURCE = #heat,
    TITLE = 'Cell Borders & Sorting (X_SORT=VALUE_DESC, Y_SORT=ALPHA)',
    MAPPINGS (X = Hour, Y = Day, VALUE = ActiveUsers),
    OPTIONS (
        CELL_BORDER       = ON,
        CELL_BORDER_COLOR = '#1e293b',
        CELL_BORDER_WIDTH = 2,
        X_SORT            = VALUE_DESC,
        Y_SORT            = ALPHA,
        NULL_COLOR        = '#94a3b8'
    )
);

-- 7. Full Legend Suite
CREATE VISUAL LegendHeatmap AS HEATMAP (
    SOURCE = #heat,
    TITLE = 'Continuous Color Scale Legend',
    MAPPINGS (X = Hour, Y = Day, VALUE = ActiveUsers),
    OPTIONS (
        LEGEND             = ON,
        LEGEND_TITLE       = 'Activity Level',
        LEGEND_POSITION    = TOP,
        LEGEND_ORIENTATION = HORIZONTAL,
        COLOR_LOW          = '#e0f2fe',
        COLOR_HIGH         = '#0369a1'
    )
);

-- Page Layout
CREATE PAGE HeatmapKitchenSink AS DASHBOARD (
    STRUCTURE = 'A B / C D / E F',
    MAP (
        'A' = BasicHeatmap,
        'B' = LabeledHeatmap,
        'C' = StyledHeatmap,
        'D' = DivergingHeatmap,
        'E' = BorderedSortedHeatmap,
        'F' = LegendHeatmap
    )
);

CREATE NAVIGATION MainNav AS TAB (DEFAULT = HeatmapKitchenSink, PAGES (HeatmapKitchenSink));

