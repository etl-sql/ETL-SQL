CREATE CONNECTION myDb AS MSSQL('Server=Demo;');

DECLARE @myVar VARCHAR(100) = 'Electronics';
DECLARE @dt1 DATETIME = '20261231';
DECLARE @dt2 DATETIME = '12/31/2026 23:59:59';

SET @myVar = 'Clothing';

SELECT id, category_name, @myVar AS CurrentVar, @dt1 AS EndOfYear, @dt2 AS EoyTimestamp
INTO myDb
FROM myDb
WHERE category_name = @myVar AND created_at < @dt1;
