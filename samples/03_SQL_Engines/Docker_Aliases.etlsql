-- Sample: Multiple Docker Containers with Aliasing
-- @requires: docker
-- This script demonstrates starting two different database containers
-- and managing them using aliases.

-- 1. Spin up SQL Server
USE DOCKER('mcr.microsoft.com/mssql/server:2022-latest') AS dms;
DECLARE @ms_conn varchar(500) = dms.CONNECTION_STRING;
PRINT 'MSSQL container is ready.';

-- 2. Spin up Postgres
USE DOCKER('postgres:15-alpine') AS dpost;
DECLARE @pg_conn varchar(500) = dpost.CONNECTION_STRING;
PRINT 'Postgres container is ready.';

-- 3. Use them (e.g., create connections)
CREATE CONNECTION ms AS MSSQL(@ms_conn);
CREATE CONNECTION pg AS POSTGRES(@pg_conn);

-- 4. Management commands
PAUSE DOCKER dms;   -- Suspend CPU while preserving container state
PRINT('DMS paused');

START DOCKER dms;   -- Resume
PRINT('DMS resumed');

-- 5. Cleanup
CLOSE DOCKER dms;   -- Stop and dispose
CLOSE DOCKER dpost;
PRINT('Containers closed');
