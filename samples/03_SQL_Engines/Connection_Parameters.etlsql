-- Generate a test CSV file using default comma delim
CREATE CONNECTION dummy AS FLATFILE('TestData/dummy.csv');
DROP TABLE IF EXISTS #temp_out;
CREATE TABLE #temp_out (Col1 VARCHAR(50), Col2 VARCHAR(50));
INSERT INTO #temp_out (Col1, Col2) VALUES ('value1', 'value2');
INSERT INTO #temp_out (Col1, Col2) VALUES ('value3', 'value4');

-- Write out pipe delimited no headers
CREATE CONNECTION pipe_out AS FLATFILE('samples/output/pipe.csv', HEADER=OFF, DELIMITER=PIPE);
INSERT INTO pipe_out SELECT * FROM #temp_out;

-- Read from pipe delimited no headers and ensure columns auto generated to Col1, Col2 and values are right
CREATE CONNECTION pipe_in AS FLATFILE('samples/output/pipe.csv', HEADER=OFF, DELIMITER=PIPE);

SELECT * FROM pipe_in;
