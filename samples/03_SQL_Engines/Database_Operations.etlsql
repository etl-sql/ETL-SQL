-- Connect to Mocking Data Sources
CREATE CONNECTION my_oracle AS ORACLE('Server=OracleDemo;');
CREATE CONNECTION my_mssql AS MSSQL('Server=SqlDemo;Database=DemoDb;');

-- Test Standalone Updates
UPDATE my_mssql.DemoDb.dbo.Users
SET UserName = 'New', Email = 'new@example.com'
WHERE UserID = 1;

-- Test Standalone Selects (Should Pushdown and Print)
SELECT
    UPPER(UserName) AS name_uppercase,
    CONCAT(Email, '_processed') AS val_formatted,
    UserID * 10 + 50 AS calculated_metric
FROM my_oracle.hr.Users
WHERE (UserName = 'Test' OR UserName = 'Other') AND UserID >= 50;

-- Test Select -> Insert
INSERT INTO my_mssql.DemoDb.dbo.Users_Log
SELECT * FROM my_mssql.DemoDb.dbo.Users WHERE UserName = 'New';
