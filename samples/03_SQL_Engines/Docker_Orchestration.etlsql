/* 
  -- @requires: docker
  Sample: Docker-based SQL Server Integration
  Demonstrates:
  - USE DOCKER for containerized SQL Server
  - DOCKER.CONNECTION_STRING for dynamic connection definition
  - EXECUTE connection BEGIN...END block form
  - EXECUTE ('sql') AT connection string literal form
*/

-- 1. Spin up a Dockerized SQL Server
USE DOCKER('mcr.microsoft.com/mssql/server:2022-latest');

-- 2. Define a connection using the dynamic connection string
DECLARE @conn varchar(500) = DOCKER.CONNECTION_STRING;
CREATE CONNECTION ds AS MSSQL(@conn);

-- 3. Execute a block of ETL-SQL statements on the remote server
EXECUTE ds
BEGIN
  CREATE TABLE Employee (id INT, employee_name NVARCHAR(100));
  INSERT INTO  Employee(id, employee_name) VALUES (1, 'New Employee');
END;

-- 4. Execute a raw SQL string on the remote server
-- Note: Requires valid target server syntax and escaped quotes
EXECUTE (
  'CREATE TABLE RemoteLog (log_date DATETIME, msg NVARCHAR(MAX));
  INSERT INTO  RemoteLog (log_date, msg) VALUES (GETDATE(), ''Docker Sync Complete'');'
) AT ds;

-- 5. Verify local execution continues
SELECT 1 AS LocalStatus;
