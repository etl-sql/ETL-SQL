/* 
    REAL-WORLD SCENARIO 5: Dynamic Data Masking & JSON Export
    ---------------------------------------------------------
    Self contained mock.
*/

CREATE TABLE #Employees (EmployeeID INT, FirstName VARCHAR(50), LastName VARCHAR(50), Email VARCHAR(100), SSN VARCHAR(20), DeptID INT, IsActive INT);
INSERT INTO #Employees VALUES (1, 'John', 'Doe', 'jdoe@secure.com', '123456789', 100, 1);
INSERT INTO #Employees VALUES (2, 'Jane', 'Smith', 'jane.smith@secure.com', '987654321', 101, 1);

CREATE TABLE #Departments (DeptID INT, DepartmentName VARCHAR(50));
INSERT INTO #Departments VALUES (100, 'Accounting');
INSERT INTO #Departments VALUES (101, 'Engineering');

-- 1. Extract and Apply Dynamic Masking rules natively
SELECT 
    EmployeeID,
    FirstName,
    LastName,
    -- Mask Email: show first two letters, mask middle, show domain
    CONCAT(LEFT(Email, 2), '***@', SUBSTRING(Email, CHARINDEX('@', Email) + 1, LEN(Email))) AS MaskedEmail,
    
    -- Mask SSN: Output only the last 4 digits
    CONCAT('XXX-XX-', RIGHT(SSN, 4)) AS MaskedSSN,
    
    DepartmentName
INTO #MaskedProfiles
FROM #Employees e
INNER JOIN #Departments d ON e.DeptID = d.DeptID
WHERE e.IsActive = 1;

CREATE CONNECTION LocalJsonDump ON FLATFILE('TestData/out/masked_profiles.json');

-- 2. Format to Enterprise JSON Spec
SELECT 
    DepartmentName AS 'Department',
    EmployeeID AS 'Profile.ID',
    FirstName AS 'Profile.FirstName',
    LastName AS 'Profile.LastName',
    MaskedEmail AS 'Profile.Contact',
    MaskedSSN AS 'Profile.GovtID'
INTO LocalJsonDump.Main
FROM #MaskedProfiles
FOR JSON AUTO, ROOT('CorporateDirectory');

PRINT 'Data Masking and Delivery to LocalJsonDump complete!';
