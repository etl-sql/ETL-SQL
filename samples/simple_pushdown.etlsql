CREATE CONNECTION MyDb ON MOCKDB('mock://localhost') WITH (dialect='MSSQL');
PRINT 'Testing pushdown INCORPORATING #TempTable...';
EXECUTE MyDb INTO #RemoteUsers BEGIN SELECT UserID, UserName FROM Users END;
SELECT 'Captured ' + CAST(COUNT(*) AS STR) + ' rows into #RemoteUsers' FROM #RemoteUsers;
SELECT * FROM #RemoteUsers;
