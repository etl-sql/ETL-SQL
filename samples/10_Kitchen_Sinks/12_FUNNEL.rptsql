-- Kitchen Sink: FUNNEL Visual
-- This script demonstrates the FUNNEL visual type for pipeline and conversion drop-off analysis.

SET REPORT TITLE = 'Kitchen Sink: FUNNEL Visual';
SET REPORT DESCRIPTION = 'Demonstration of FUNNEL conversion visualization, stage palettes, and data labels.';

-- 1. Mock Data Generation (Sales Pipeline Stages)
SELECT '1. Prospects' AS Stage, 1000 AS Count INTO #funnel
UNION ALL SELECT '2. Qualified', 600
UNION ALL SELECT '3. Proposal', 300
UNION ALL SELECT '4. Negotiation', 150
UNION ALL SELECT '5. Closed Won', 80;

-- 2. Basic Funnel
CREATE VISUAL BasicFunnel AS FUNNEL (
    SOURCE = (SELECT Stage, Count FROM #funnel ORDER BY Count DESC),
    TITLE = 'Sales Conversion Funnel (Volume by Stage)',
    MAPPINGS (LABEL = Stage, VALUE = Count)
);

-- 3. Funnel with Data Labels and Value Counts
CREATE VISUAL LabeledFunnel AS FUNNEL (
    SOURCE = (SELECT Stage, Count FROM #funnel ORDER BY Count DESC),
    TITLE = 'Conversion Funnel with Explicit Counts',
    MAPPINGS (LABEL = Stage, VALUE = Count),
    OPTIONS (
        DATA_LABELS = ON
    )
);

-- 4. Styled Funnel with Custom Stage Colors
CREATE VISUAL StyledFunnel AS FUNNEL (
    SOURCE = (SELECT Stage, Count FROM #funnel ORDER BY Count DESC),
    TITLE = 'Styled Pipeline (Brand Colors)',
    MAPPINGS (LABEL = Stage, VALUE = Count),
    OPTIONS (
        COLORS (
            '1. Prospects'   = '#4e79a7',
            '2. Qualified'   = '#76b7b2',
            '3. Proposal'    = '#f28e2b',
            '4. Negotiation' = '#e15759',
            '5. Closed Won'  = '#59a14f'
        ),
        DATA_LABELS = ON
    )
);

-- Page Layout
CREATE PAGE FunnelKitchenSink AS DASHBOARD (
    STRUCTURE = 'A B / C .',
    MAP (
        'A' = BasicFunnel,
        'B' = LabeledFunnel,
        'C' = StyledFunnel
    )
);

CREATE NAVIGATION MainNav AS TAB (DEFAULT = FunnelKitchenSink, PAGES (FunnelKitchenSink));
