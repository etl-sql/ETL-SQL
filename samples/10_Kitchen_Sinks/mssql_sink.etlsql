-- MSSQL Kitchen Sink
SET WHAT_IF OFF;
PRINT 'Starting MSSQL container...';
USE DOCKER('mcr.microsoft.com/mssql/server:2022-latest') AS ms;
CREATE CONNECTION db ON MSSQL(ms.CONNECTION_STRING);

PRINT 'Testing MSSQL basic operations...';
EXECUTE db BEGIN
    CREATE TABLE kitchen_sink (
        id INT PRIMARY KEY,
        val NVARCHAR(100),
        ts DATETIME DEFAULT GETDATE()
    );
END;

SELECT 1 AS id, 'MSSQL' AS val INTO #push;
INSERT INTO db.kitchen_sink SELECT * FROM #push;

PRINT 'Querying MSSQL...';
SELECT * FROM db.kitchen_sink;

CLOSE DOCKER ms;
