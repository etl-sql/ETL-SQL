-- Kitchen Sink: Master Index
-- This script provides a central hub for all visual "Kitchen Sink" samples.

SET REPORT TITLE = 'ETL-SQL: Visual Kitchen Sink Index';
SET REPORT DESCRIPTION = 'Click any card to view the detailed demonstration for that visual type.';

-- 1. Create a table of all samples
SELECT 'BAR' AS Visual, '01_BAR.rptsql' AS Path, 'Vertical bars, grouping, stacking, overlays' AS Desc INTO #samples
UNION ALL SELECT 'HBAR', '02_HBAR.rptsql', 'Horizontal bars, grouping, stacking'
UNION ALL SELECT 'LINE', '03_LINE.rptsql', 'Line charts, smoothing, regression trends'
UNION ALL SELECT 'SCATTER', '04_SCATTER.rptsql', 'X/Y plots, linear/poly fits, threshold lines'
UNION ALL SELECT 'PIE', '05_PIE.rptsql', 'Circular part-to-whole, percentage labels'
UNION ALL SELECT 'DONUT', '06_DONUT.rptsql', 'Hollow pie charts, inner radius, custom palettes'
UNION ALL SELECT 'COMBO', '07_COMBO.rptsql', 'Bar + Line combined, dual-axis scaling'
UNION ALL SELECT 'GAUGE', '08_GAUGE.rptsql', 'KPI gauges (Progress, Semi-circle, Ring)'
UNION ALL SELECT 'BOXPLOT', '09_BOXPLOT.rptsql', 'Distribution box-and-whisker stats'
UNION ALL SELECT 'TREEMAP', '10_TREEMAP.rptsql', 'Flat categories and nested hierarchical trees'
UNION ALL SELECT 'HEATMAP', '11_HEATMAP.rptsql', '2D grid-based density, cell labels, gradient palettes'
UNION ALL SELECT 'FUNNEL', '12_FUNNEL.rptsql', 'Pipeline stages, conversion rates, stage colors'
UNION ALL SELECT 'WATERFALL', '13_WATERFALL.rptsql', 'Cumulative cashflow & P&L bridges with totals'
UNION ALL SELECT 'RADAR', '14_RADAR.rptsql', 'Multi-metric spider charts and filled area skill profiles'
UNION ALL SELECT 'CANDLESTICK', '15_CANDLESTICK.rptsql', 'Financial OHLC stock price history'
UNION ALL SELECT 'MAP', '16_MAP.rptsql', 'Choropleth regional maps and geo-coordinate points'
UNION ALL SELECT 'TABLE', '17_TABLE.rptsql', 'Data grids, sparklines, bars, heatmaps, pagination'
UNION ALL SELECT 'CARD', '18_CARD.rptsql', 'Big KPI numbers, goal tracking, progress rings, LAYER stacking'
UNION ALL SELECT 'IMAGE', '19_IMAGE.rptsql', 'Static and dynamic images with fit modes'
UNION ALL SELECT 'TEXT', '20_TEXT.rptsql', 'Markdown content, dynamic greetings, code blocks'
UNION ALL SELECT 'SLICER', '21_SLICER.rptsql', 'Dropdown single-select filters'
UNION ALL SELECT 'MULTISELECT', '22_MULTISELECT.rptsql', 'Checkbox list and dropdown multi-select filters'
UNION ALL SELECT 'DATEPICKER', '23_DATEPICKER.rptsql', 'Calendar date selection controls'
UNION ALL SELECT 'RELDATEPICKER', '24_RELDATEPICKER.rptsql', 'Relative expressions (D-7, M-1, YTD)'
UNION ALL SELECT 'SLIDER', '25_SLIDER.rptsql', 'Numeric range and threshold sliders'
UNION ALL SELECT 'SEARCH', '26_SEARCH.rptsql', 'Free-text search input filters'
UNION ALL SELECT 'CHECKBOX', '27_CHECKBOX.rptsql', 'Toggle boolean inputs and conditional cards'
UNION ALL SELECT 'TEXTBOX', '28_TEXTBOX.rptsql', 'Freeform text input controls and placeholders'
UNION ALL SELECT 'NUMBERBOX', '29_NUMBERBOX.rptsql', 'Numeric precision inputs, steps, and bounds'
UNION ALL SELECT 'INTERACTIONS', '30_INTERACTIONS.rptsql', 'Interactive actions: DRILL_IN, DRILL_DOWN, highlight, filter'
UNION ALL SELECT 'OVERLAYS', '31_OVERLAYS_ADVANCED.rptsql', 'Advanced mathematical regression fits, goal lines, moving averages'
UNION ALL SELECT 'BUBBLE', '32_BUBBLE.rptsql', '3D/4D scatter plots (X, Y, Size, Sector series)'
UNION ALL SELECT 'MATRIX', '33_MATRIX.rptsql', 'Pivot tables: multi-dimension, multi-value, subtotals, AXIS_SORT'
UNION ALL SELECT 'TRELLIS', '34_TRELLIS.rptsql', 'Small multiples (faceted grid panels with shared axes)'
UNION ALL SELECT 'SANKEY', '35_SANKEY.rptsql', 'Multi-stage flow transitions and directional links'
UNION ALL SELECT 'GANTT', '36_GANTT.rptsql', 'Project timelines, task duration bars, scheduling'
UNION ALL SELECT 'SUNBURST', '37_SUNBURST.rptsql', 'Concentric radial rings for multi-tier hierarchies'
UNION ALL SELECT 'NETWORK', '38_NETWORK.rptsql', 'Node-link relationship graphs and collaboration topology'
UNION ALL SELECT 'CUSTOM', '39_CUSTOM_LAYERS.rptsql', 'Direct Grammar of Graphics multi-mark layered compositions'
UNION ALL SELECT 'SHOWCASE', 'report_kitchen_sink.rptsql', 'Comprehensive multi-page showcase dashboard';

-- 2. Visual for the Index
CREATE VISUAL VisualIndex AS TABLE (
    SOURCE = #samples,
    TITLE = 'Visual Type Catalog',
    ACTIONS (
        ON_CLICK = DRILL_REPORT(FILE = Path)
    )
);

-- 3. Page Layout
CREATE PAGE IndexPage AS DASHBOARD (
    STRUCTURE = 'A',
    MAP ('A' = VisualIndex)
);

CREATE NAVIGATION MainNav AS TAB (DEFAULT = IndexPage, PAGES (IndexPage));
