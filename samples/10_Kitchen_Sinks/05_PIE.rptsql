-- Kitchen Sink: PIE Visual
-- This script demonstrates all features of the PIE visual type.

SET REPORT TITLE = 'Kitchen Sink: PIE Visual';
SET REPORT DESCRIPTION = 'Demonstration of PIE chart capabilities, including custom colors and legend positions.';

-- 1. Mock Data Generation
SELECT 'Direct' AS Channel, 450 AS Users INTO #channels
UNION ALL SELECT 'Social', 300
UNION ALL SELECT 'Search', 600
UNION ALL SELECT 'Referral', 150
UNION ALL SELECT 'Email', 200
UNION ALL SELECT 'Affiliate', 20
UNION ALL SELECT 'Display', 15
UNION ALL SELECT 'Partner', 10;

-- 2. Basic Pie Chart
CREATE VISUAL BasicPie AS PIE (
    SOURCE = #channels,
    TITLE = 'Basic Pie Chart',
    MAPPINGS (LABEL = Channel, VALUE = Users)
);

-- 3. Pie with Data Labels and Percentages
CREATE VISUAL PercentPie AS PIE (
    SOURCE = #channels,
    TITLE = 'Pie with Data Labels',
    MAPPINGS (LABEL = Channel, VALUE = Users),
    OPTIONS (
        DATA_LABELS = ON,
        FORMAT = 'P0'
    )
);

-- 4. Styled Rose Pie (Custom Colors, Geometry & Legend)
CREATE VISUAL StyledPie AS PIE (
    SOURCE = #channels,
    TITLE = 'Styled Rose Pie Chart',
    MAPPINGS (LABEL = Channel, VALUE = Users),
    OPTIONS (
        COLORS (
            'Direct' = '#4e79a7',
            'Social' = '#f28e2b',
            'Search' = '#e15759',
            'Referral' = '#76b7b2',
            'Email' = '#59a14f'
        ),
        ROSE_MODE = ON,
        LEGEND_POSITION = RIGHT
    )
);

-- 5. Sorted Pie with Slice Borders & START_ANGLE
CREATE VISUAL SortedBorderedPie AS PIE (
    SOURCE = #channels,
    TITLE = 'Sorted (VALUE_DESC), START_ANGLE=90 & Slice Borders',
    MAPPINGS (LABEL = Channel, VALUE = Users),
    OPTIONS (
        SORT               = VALUE_DESC,
        START_ANGLE        = 90,
        SLICE_BORDER_COLOR = '#ffffff',
        SLICE_BORDER_WIDTH = 2,
        DATA_LABELS        = ON
    )
);

-- 6. Exploded Slice & MIN_SLICE_PCT Threshold
CREATE VISUAL ExplodedThresholdPie AS PIE (
    SOURCE = #channels,
    TITLE = 'EXPLODE Single Slice & MIN_SLICE_PCT Threshold',
    MAPPINGS (LABEL = Channel, VALUE = Users),
    OPTIONS (
        EXPLODE       = 'Search',
        MIN_SLICE_PCT = 5,
        OTHER_LABEL   = 'Other Channels',
        DATA_LABELS   = ON
    )
);

-- 7. EXPLODE_ALL with Distance & Multi-Column Legend
CREATE VISUAL ExplodeAllLegendPie AS PIE (
    SOURCE = #channels,
    TITLE = 'EXPLODE_ALL & Multi-Column Legend',
    MAPPINGS (LABEL = Channel, VALUE = Users),
    OPTIONS (
        EXPLODE_ALL      = ON,
        EXPLODE_DISTANCE = 0.08,
        LEGEND           = ON,
        LEGEND_TITLE     = 'Channels',
        LEGEND_COLUMNS   = 2,
        LEGEND_POSITION  = BOTTOM
    )
);

-- Page Layout
CREATE PAGE PieKitchenSink AS DASHBOARD (
    STRUCTURE = 'A B C / D E F',
    MAP (
        'A' = BasicPie,
        'B' = PercentPie,
        'C' = StyledPie,
        'D' = SortedBorderedPie,
        'E' = ExplodedThresholdPie,
        'F' = ExplodeAllLegendPie
    )
);

CREATE NAVIGATION MainNav AS TAB (DEFAULT = PieKitchenSink, PAGES (PieKitchenSink));

