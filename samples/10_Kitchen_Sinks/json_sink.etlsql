-- JSON Kitchen Sink
SET WHAT_IF OFF;

-- INSERT appends: start each run from fresh files.
DELETE FILE 'samples/output/std.json';
DELETE FILE 'samples/output/data.json.zip';

SELECT 1 AS ID, 'Alice' AS Name, 'HR' AS Dept INTO #sample;
INSERT INTO #sample VALUES (2, 'Bob', 'IT');

-- 1. Standard JSON
PRINT 'Testing Standard JSON...';
CREATE CONNECTION json_std AS JSON('samples/output/std.json');
INSERT INTO json_std.FILE SELECT * FROM #sample;
PRINT 'Inserted into std.json';
SELECT * FROM json_std.FILE;

-- 2. JSON with Root Path (read only: ROOT_PATH picks the nested array; writes through it are refused)
PRINT 'Testing JSON with Root Path...';
CREATE CONNECTION json_root AS JSON('json_nested_orders.json', ROOT_PATH='$.data.orders');
SELECT * FROM json_root.FILE;

-- 3. Compressed JSON (COMPRESS=ON writes a ZIP archive; a path not ending in .zip gets .zip added)
PRINT 'Testing Compressed JSON...';
CREATE CONNECTION json_gz AS JSON('samples/output/data.json.zip', COMPRESS=ON);
INSERT INTO json_gz.FILE SELECT * FROM #sample;
SELECT * FROM json_gz.FILE;
