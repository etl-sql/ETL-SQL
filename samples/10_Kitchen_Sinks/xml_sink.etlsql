-- XML Kitchen Sink
SET WHAT_IF OFF;
SELECT 1 AS ID, 'Alice' AS Name INTO #sample;

-- 1. Standard XML
PRINT 'Testing Standard XML...';
CREATE CONNECTION xml_std AS XML('samples/output/std.xml');
INSERT INTO xml_std.FILE SELECT * FROM #sample;
PRINT 'Inserted into std.xml';
SELECT * FROM xml_std.FILE;

-- 2. XML with Root Path (XPath)
PRINT 'Testing XML with Root Path...';
CREATE CONNECTION xml_root AS XML('samples/output/root.xml', ROOT_PATH='/Data/Rows');
INSERT INTO xml_root.FILE SELECT * FROM #sample;
PRINT 'Inserted into root.xml';
SELECT * FROM xml_root.FILE;

-- 3. Compressed XML
PRINT 'Testing Compressed XML...';
CREATE CONNECTION xml_gz AS XML('samples/output/data.xml.gz', COMPRESS=ON);
INSERT INTO xml_gz.FILE SELECT * FROM #sample;
PRINT 'Inserted into data.xml.gz';
SELECT * FROM xml_gz.FILE;
