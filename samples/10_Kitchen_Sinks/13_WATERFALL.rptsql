-- Kitchen Sink: WATERFALL Visual
-- This script demonstrates the WATERFALL visual type.

SET REPORT TITLE = 'Kitchen Sink: WATERFALL Visual';
SET REPORT DESCRIPTION = 'Demonstration of WATERFALL cumulative change visualization.';

-- 1. Mock Data Generation
SELECT 'Opening Balance' AS Period, 1000 AS Delta INTO #cashflow
UNION ALL SELECT 'Sales', 500
UNION ALL SELECT 'Refunds', -50
UNION ALL SELECT 'Marketing', -200
UNION ALL SELECT 'Payroll', -400
UNION ALL SELECT 'Rent', -150
UNION ALL SELECT 'Closing Balance', 700; -- Note: Waterfall usually calculates the net, but here we provide deltas.

-- 2. Basic Waterfall
CREATE VISUAL BasicWaterfall AS WATERFALL (
    SOURCE = #cashflow,
    TITLE = 'Cash Flow Waterfall',
    MAPPINGS (X = Period, Y = Delta)
);

-- 3. Styled Waterfall (Custom Colors for Positive/Negative)
CREATE VISUAL StyledWaterfall AS WATERFALL (
    SOURCE = #cashflow,
    TITLE = 'Styled Waterfall with Custom Colors',
    MAPPINGS (X = Period, Y = Delta),
    OPTIONS (
        COLORS (
            positive = '#28a745',
            negative = '#dc3545'
        )
    )
);

-- Page Layout
CREATE PAGE WaterfallKitchenSink AS (
    STRUCTURE = 'A / B',
    MAP (
        'A' = BasicWaterfall,
        'B' = StyledWaterfall
    )
);

CREATE NAVIGATION MainNav AS TAB (DEFAULT = WaterfallKitchenSink, PAGES (WaterfallKitchenSink));
