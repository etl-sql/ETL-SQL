SET REPORT TITLE = 'Sales Table';

SET REPORT DESCRIPTION = 'Demonstrate how to
USE input parameters';

DECLARE @start datetime INPUT = '2024-01-01';

CREATE CONNECTION c ON FLATFILE('TestData/test_sales.csv');

SELECT
     c.FILE.region
    ,c.FILE.product
    ,c.FILE.units
    ,c.FILE.revenue
    ,c.FILE.month
    ,c.FILE.date
    ,#sales_table.region
    ,#sales_table.product
    ,#sales_table.units
    ,#sales_table.revenue
    ,#sales_table.month
    ,#sales_table.date
INTO #sales_table
FROM c.FILE;

CREATE VISUAL SalesGrid AS TABLE (
    SOURCE   = (

SELECT
     region
    ,product
    ,units
    ,revenue
    ,month
    ,date
FROM #sales_table
WHERE
    CAST(date AS DATE) >= @start
    ),
    TITLE    = 'Sales Detail'
);

CREATE PAGE Main AS LAYOUT (
    STRUCTURE = 'A',
    MAP ('A' = SalesGrid)
);
-- Diagnostics

DECLARE @cnt INT = (

SELECT
     COUNT(*)
FROM #sales_table
WHERE
    CAST(date AS DATE) >= @start);
PRINT 'Total number of rows: ' + CAST(@cnt AS STRING);
PRINT 'Filter Start: ' + CAST(@start AS STRING);