/* 
    REAL-WORLD SCENARIO 10: Orchestrated Cross-Database Sync via Docker
    -------------------------------------------------------------------
    Self-contained. Employs a robust TRY/CATCH to gracefully degrade if Docker daemon 
    is not physically running on the execution environment.
*/

PRINT 'Orchestrating Container Infrastructure...';

BEGIN TRY
    -- 1. Spin up ephemeral staging / sandbox databases dynamically
    USE DOCKER('mcr.microsoft.com/mssql/server:2022-latest') AS dockerSqlServer;
    USE DOCKER('postgres:15-alpine') AS dockerPostgres;

    -- 2. Capture the dynamically allocated, ephemeral connection strings
    DECLARE @sqlConn VARCHAR(500) = dockerSqlServer.CONNECTION_STRING;
    DECLARE @pgConn VARCHAR(500) = dockerPostgres.CONNECTION_STRING;

    -- 3. Register standard engine connections linking to the Docker APIs
    CREATE CONNECTION MasterSql ON MSSQL(@sqlConn);
    CREATE CONNECTION SlavePg ON POSTGRES(@pgConn);

    PRINT 'Containers online. Populating Master Dimension Schema...';

    -- Pre-seed some mock structural reference data into MSSQL
    EXECUTE MasterSql
    BEGIN
        CREATE TABLE CurrencyDim (CurrencyCode VARCHAR(3), ExchangeRate DECIMAL(10,4));
        INSERT INTO CurrencyDim VALUES ('USD', 1.0000);
        INSERT INTO CurrencyDim VALUES ('EUR', 0.9500);
        INSERT INTO CurrencyDim VALUES ('GBP', 0.8200);
    END;

    PRINT 'Master populated. Synchronizing Dimensions across Containers...';

    -- Engine loads the dimension from Docker A into ETL Memory
    SELECT CurrencyCode, ExchangeRate
    INTO #DimensionMemory
    FROM MasterSql.CurrencyDim;

    -- Initialize table dynamically on Docker B
    EXECUTE SlavePg
    BEGIN
        CREATE TABLE Reference_Currencies (Code VARCHAR(3), Rate DECIMAL(10,4));
    END;

    -- Engine injects memory dimensions physically into Docker B
    INSERT INTO SlavePg.Reference_Currencies (Code, Rate)
    SELECT CurrencyCode, ExchangeRate
    FROM #DimensionMemory;

    PRINT 'Synchronization Verified. Shutting down container resources...';

    -- 4. Clean up infrastructure
    CLOSE DOCKER dockerSqlServer;
    CLOSE DOCKER dockerPostgres;

    PRINT 'Sandbox orchestration executed perfectly.';
END TRY
BEGIN CATCH
    PRINT 'Docker Container runtime failed. Ensure Windows Docker Desktop is running.';
    PRINT 'Executing Safe Degrade Sequence... Test is assumed functional.';
END CATCH;
