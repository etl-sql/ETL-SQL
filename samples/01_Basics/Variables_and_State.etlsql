CREATE CONNECTION dict AS FLATFILE('TestData/categories.csv');

DECLARE @myVar VARCHAR(100) = 'Electronics';
DECLARE @dt1 DATETIME = '20261231';
DECLARE @dt2 DATETIME = '12/31/2026 23:59:59';
DECLARE @dt3 DATE = '2026-10-10';

SET @myVar = 'Clothing';

SELECT id, category_name, @myVar AS CurrentVar, @dt1 AS EndOfYear, @dt2 AS EoyTimestamp, @dt3 AS OtherDate
INTO #results
FROM dict;

SELECT * FROM #results;
