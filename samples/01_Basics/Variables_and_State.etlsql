-- Sample: Variables, Types, and Session State
-- Demonstrates declaring typed session variables, SET mutations, and projecting variables into queries.

CREATE TABLE #dict (
    id INT,
    category_name VARCHAR(50)
);

INSERT INTO #dict VALUES
    (1, 'Electronics'),
    (2, 'Books'),
    (3, 'Apparel');

DECLARE @myVar VARCHAR(100) = 'Electronics';
DECLARE @dt1 DATETIME = '20261231';
DECLARE @dt2 DATETIME = '12/31/2026 23:59:59';
DECLARE @dt3 DATE = '2026-10-10';

SET @myVar = 'Clothing';

SELECT id, category_name, @myVar AS CurrentVar, @dt1 AS EndOfYear, @dt2 AS EoyTimestamp, @dt3 AS OtherDate
INTO #results
FROM #dict;

PRINT 'Projected results with mutated variables:';
SELECT id, category_name, CurrentVar, EndOfYear, EoyTimestamp, OtherDate
FROM #results;
