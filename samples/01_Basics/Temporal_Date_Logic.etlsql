-- Sample: Temporal Features
-- Demonstrates AT TIME ZONE and Date Arithmetic.

-- 1. Date Arithmetic
-- GETDATE() and SYSDATE support shorthand +/- days
PRINT 'Date Arithmetic examples';
DECLARE @now = GETDATE();
DECLARE @tomorrow = @now + 1;
DECLARE @nextWeek = @now + 7;
DECLARE @yesterday = SYSDATE - 1;

PRINT 'Now: ' + @now;
PRINT 'Tomorrow: ' + @tomorrow;
PRINT 'Yesterday: ' + @yesterday;

-- 2. AT TIME ZONE conversion
-- Converts a timestamp between regions using Windows Time Zone IDs.
PRINT 'Time Zone Conversion examples';
DECLARE @utcTime = '2026-04-07 12:00:00'; -- Assume UTC

SELECT 
    @utcTime AS UTC,
    @utcTime AT TIME ZONE 'Eastern Standard Time' AS NewYorkLine,
    @utcTime AT TIME ZONE 'Pacific Standard Time' AS SeattleLine,
    @utcTime AT TIME ZONE 'W. Europe Standard Time' AS BerlinLine;

-- 3. Logical checks
IF SYSDATE + 1 > SYSDATE
BEGIN
    PRINT 'Date comparison logic verified.';
END
