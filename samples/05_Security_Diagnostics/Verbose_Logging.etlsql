-- Create a local temp table
CREATE TABLE #VerboseTest (ID INT, Name VARCHAR(50));

-- Insert some data
INSERT INTO #VerboseTest (ID, Name) VALUES (1, 'Alice');
INSERT INTO #VerboseTest (ID, Name) VALUES (2, 'Bob');

-- Declare and set variables
DECLARE @LoopCounter INT = 1;
WHILE @LoopCounter <= 3
BEGIN
    PRINT('Loop iteration ' + @LoopCounter);
    SET @LoopCounter = @LoopCounter + 1;
END

-- Complex select with metrics
SELECT * INTO #Results FROM #VerboseTest WHERE ID > 0;

-- Drop table
DROP TABLE #VerboseTest;
DROP TABLE #Results;

PRINT('Verbose test complete.');
