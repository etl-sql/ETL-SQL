-- This script demonstrates the ETL-SQL Linter
-- The Linter checks for potential errors and best practices

-- Rule: SafeDeleteUpdate (ERROR if WHERE is missing)
-- DELETE FROM MyTable; -- This would fail if uncommented

-- Rule: AvoidSelectStar (WARNING)
CREATE TABLE #Customers (Id INT, Name VARCHAR(100));
INSERT INTO #Customers VALUES (1, 'Alice'), (2, 'Bob');
SELECT * FROM #Customers;

-- Rule: UndeclaredVariable (ERROR)
-- SET @myVar = 10; -- Error: @myVar not declared if uncommented

DECLARE @id INT = 1;

-- To run the linter on this file from within the editor:
-- LINT 'scripts/sample_linter.etlsql';
