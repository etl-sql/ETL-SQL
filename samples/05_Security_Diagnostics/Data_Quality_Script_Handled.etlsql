-- Script-handled quarantine: fixing bad rows inside the run instead of handing them off.
--
-- The default quarantine mode records durable evidence for a person to review later:
-- a replay manifest, a Portal steward-queue item, a section label marking the re-entry
-- point. That is the right shape when nobody knows yet what the bad rows should be.
--
-- Often the script already knows. WITH (HANDLING = SCRIPT) says so: the rows still leave
-- the main output and still carry their __dq_* context, but nothing is published for a
-- human to act on -- because by the end of this run there is nothing left to act on.
--
-- Run:  dotnet run --project src/ETL-SQL.App -- run samples/05_Security_Diagnostics/Data_Quality_Script_Handled.etlsql

-- ── Reference data the orders must agree with ───────────────────────────────
-- CustomerId is only unique WITHIN a tenant, which is what makes the composite
-- check necessary: customer 7 is real, but only under tenant 1.
CREATE TABLE #dim_customer (TenantId INT, CustomerId INT, Name VARCHAR(100));
INSERT INTO #dim_customer (TenantId, CustomerId, Name) VALUES
    (1, 7, 'Ana Torres'),
    (1, 8, 'Ben Okafor'),
    (2, 9, 'Chidi Vance');

CREATE TABLE #raw_orders (
    TenantId   INT,
    CustomerId INT,
    Status     VARCHAR(20),
    RawAmount  VARCHAR(50),
    PostalCode VARCHAR(20),
    Notes      VARCHAR(200)
);

INSERT INTO #raw_orders (TenantId, CustomerId, Status, RawAmount, PostalCode, Notes) VALUES
    (1, 7, 'Shipped', '129.99', '73301',  'gift wrap'),
    (1, 8, 'Shipped', '10.00',  '73301',  'leave at door'),
    (2, 7, 'Shipped', '55.25',  '73301',  'ok'),              -- customer 7 belongs to tenant 1
    (1, 8, 'UNKNOWN', '18.50',  '73301',  'ok'),              -- placeholder status
    (1, 7, 'Shipped', 'n/a',    '73301',  'ok'),              -- amount will not convert
    (1, 8, 'Shipped', '22.00',  '1',      'ok'),              -- postal code too short
    (1, 7, 'Shipped', '31.00',  '73301',  'hi <script>x</script>'); -- unsafe content

-- ── The load ────────────────────────────────────────────────────────────────
-- No section label, and a #temp capture target, both deliberate: they are the
-- two things HANDLING = SCRIPT stops requiring, because each exists to serve a
-- remediation step that will not happen here.
SELECT
    TenantId   EXPECT EXISTS WITH (TenantId, CustomerId) IN #dim_customer(TenantId, CustomerId) ON FAILURE QUARANTINE,
    CustomerId,
    Status     EXPECT NOT BLANK AND NOT IN ('UNKNOWN', 'N/A') ON FAILURE QUARANTINE,
    RawAmount  EXPECT CASTABLE AS DECIMAL(10,2) ON FAILURE QUARANTINE,
    PostalCode EXPECT LENGTH BETWEEN 5 AND 10 ON FAILURE QUARANTINE,
    Notes      EXPECT NOT MATCHES '<script[^>]*>' ON FAILURE QUARANTINE
INTO #clean_orders
FROM #raw_orders
ON FAILURE QUARANTINE TO #diverted WITH (HANDLING = SCRIPT);

PRINT 'Rows that passed every rule:';
SELECT TenantId, CustomerId, Status, RawAmount, PostalCode FROM #clean_orders;

-- ── Remediating in the same run ─────────────────────────────────────────────
-- The capture table carries the pre-projection row plus the __dq_* evidence, so
-- the script can route each cause differently rather than treating "bad" as one bucket.
PRINT 'What was diverted, and why:';
SELECT __dq_column, __dq_rule, COUNT(*) AS DivertedRows
FROM #diverted
GROUP BY __dq_column, __dq_rule;

-- Recoverable: the unsafe markup is strippable, so those orders still load.
PRINT 'Recovered by stripping unsafe content:';
INSERT INTO #clean_orders (TenantId, CustomerId, Status, RawAmount, PostalCode, Notes)
SELECT TenantId, CustomerId, Status, RawAmount, PostalCode, 'redacted'
FROM #diverted
WHERE __dq_column = 'Notes';

-- Not recoverable here: a cross-tenant customer reference is a real upstream
-- defect, so it is routed to a durable table for the owning team rather than
-- guessed at.
CREATE TABLE #upstream_defects (TenantId INT, CustomerId INT, Reason VARCHAR(400));
INSERT INTO #upstream_defects (TenantId, CustomerId, Reason)
SELECT TenantId, CustomerId, __dq_reason
FROM #diverted
WHERE __dq_column = 'TenantId';

PRINT 'Referred upstream:';
SELECT TenantId, CustomerId, Reason FROM #upstream_defects;

PRINT 'Final clean row count:';
SELECT COUNT(*) AS CleanRows FROM #clean_orders;

-- The run still records how many rows were diverted -- counts only, never sample
-- values. What HANDLING = SCRIPT removed is the hand-off: no replay manifest, so
-- REPLAY QUARANTINE cannot target #diverted, and no Portal steward-queue item
-- asking someone to fix rows this script already dealt with.
