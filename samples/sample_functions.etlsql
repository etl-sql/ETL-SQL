-- Comprehensive function test for ETL-SQL
DROP TABLE IF EXISTS #func_test;
CREATE TABLE #func_test (
    category VARCHAR(50),
    test_case VARCHAR(100),
    result VARCHAR(200)
);

-- String Functions
INSERT INTO #func_test VALUES ('STRING', 'UPPER', UPPER('hello'));
INSERT INTO #func_test VALUES ('STRING', 'LOWER', LOWER('HELLO'));
INSERT INTO #func_test VALUES ('STRING', 'CONCAT', CONCAT('a', 'b', 'c'));
INSERT INTO #func_test VALUES ('STRING', 'TRIM', '[' + TRIM('  spaced  ') + ']');
INSERT INTO #func_test VALUES ('STRING', 'LTRIM', '[' + LTRIM('  spaced  ') + ']');
INSERT INTO #func_test VALUES ('STRING', 'RTRIM', '[' + RTRIM('  spaced  ') + ']');
INSERT INTO #func_test VALUES ('STRING', 'REVERSE', REVERSE('abcde'));
INSERT INTO #func_test VALUES ('STRING', 'REPLACE', REPLACE('abc', 'b', 'X'));
INSERT INTO #func_test VALUES ('STRING', 'LEN', CAST(LEN('abcde') AS VARCHAR(10)));
INSERT INTO #func_test VALUES ('STRING', 'LEFT', LEFT('abcdef', 3));
INSERT INTO #func_test VALUES ('STRING', 'RIGHT', RIGHT('abcdef', 3));
INSERT INTO #func_test VALUES ('STRING', 'CHARINDEX', CAST(CHARINDEX('c', 'abcde') AS VARCHAR(10)));
INSERT INTO #func_test VALUES ('STRING', 'INSTR', CAST(INSTR('abcde', 'c') AS VARCHAR(10)));

-- SUBSTRING (T-SQL style)
INSERT INTO #func_test VALUES ('SUBSTRING', 'Normal (1,3)', SUBSTRING('abcdef', 1, 3));
INSERT INTO #func_test VALUES ('SUBSTRING', 'Offset (0,2)', SUBSTRING('abc', 0, 2)); -- 'a'
INSERT INTO #func_test VALUES ('SUBSTRING', 'Negative Start (-1, 3)', SUBSTRING('abc', -1, 3)); -- 'a'
INSERT INTO #func_test VALUES ('SUBSTRING', 'Out of range', SUBSTRING('abc', 5, 2));

-- SUBSTR (Oracle style)
INSERT INTO #func_test VALUES ('SUBSTR', 'Normal (1,3)', SUBSTR('abcdef', 1, 3));
INSERT INTO #func_test VALUES ('SUBSTR', 'Negative (-3)', SUBSTR('abcdef', -3)); -- 'def'
INSERT INTO #func_test VALUES ('SUBSTR', 'Negative with Len (-3, 2)', SUBSTR('abcdef', -3, 2)); -- 'de'
INSERT INTO #func_test VALUES ('SUBSTR', 'Zero start', SUBSTR('abc', 0, 2)); -- 'ab'

-- Math Functions
INSERT INTO #func_test VALUES ('MATH', 'ROUND', CAST(ROUND(12.345, 2) AS VARCHAR(10)));
INSERT INTO #func_test VALUES ('MATH', 'ABS', CAST(ABS(-5.5) AS VARCHAR(10)));
INSERT INTO #func_test VALUES ('MATH', 'CEILING', CAST(CEILING(1.1) AS VARCHAR(10)));
INSERT INTO #func_test VALUES ('MATH', 'FLOOR', CAST(FLOOR(1.9) AS VARCHAR(10)));
INSERT INTO #func_test VALUES ('MATH', 'POWER', CAST(POWER(2, 4) AS VARCHAR(10)));
INSERT INTO #func_test VALUES ('MATH', 'SQRT', CAST(SQRT(25) AS VARCHAR(10)));

-- Date Functions
INSERT INTO #func_test VALUES ('DATE', 'YEAR', CAST(YEAR('2026-03-14') AS VARCHAR(4)));
INSERT INTO #func_test VALUES ('DATE', 'MONTH', CAST(MONTH('2026-03-14') AS VARCHAR(2)));
INSERT INTO #func_test VALUES ('DATE', 'DAY', CAST(DAY('2026-03-14') AS VARCHAR(2)));
INSERT INTO #func_test VALUES ('DATE', 'DATENAME Month', DATENAME(MONTH, '2026-03-14'));
INSERT INTO #func_test VALUES ('DATE', 'DATENAME Weekday', DATENAME(WEEKDAY, '2026-03-14'));
INSERT INTO #func_test VALUES ('DATE', 'EOMONTH', CAST(EOMONTH('2026-02-10') AS VARCHAR(20)));
INSERT INTO #func_test VALUES ('DATE', 'ISDATE (valid)', CAST(ISDATE('2026-03-14') AS VARCHAR(1)));
INSERT INTO #func_test VALUES ('DATE', 'ISDATE (invalid)', CAST(ISDATE('not-a-date') AS VARCHAR(1)));

-- General Functions
INSERT INTO #func_test VALUES ('GENERAL', 'COALESCE', COALESCE(NULL, NULL, 'found it'));
INSERT INTO #func_test VALUES ('GENERAL', 'ISNULL', ISNULL(NULL, 'fallback'));
INSERT INTO #func_test VALUES ('GENERAL', 'NULLIF (equal)', COALESCE(NULLIF('a', 'a'), 'NULL'));
INSERT INTO #func_test VALUES ('GENERAL', 'NULLIF (unequal)', NULLIF('a', 'b'));

SELECT * FROM #func_test ORDER BY category, test_case;
