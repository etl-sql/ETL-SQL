-- @expected-exit-code: 1
-- @expected-error: Decryption error
-- Run as shipped, this template must fail: the SMTP password is still the
-- ENC: placeholder. A placeholder credential being rejected rather than quietly used
-- is the property worth asserting; replace it and the script runs.
-- =============================================================================
--  Daily Job-Failure Digest  (administrator template — run as-is or adapt)
-- =============================================================================
--  Reads the orchestrator job history, finds runs in the last 24 hours that did
--  NOT succeed (FAILURE / BLOCKED / QUARANTINED), and emails a summary.
--
--  Intended use: schedule this as a daily orchestrator job. It is a safety net
--  BENEATH per-job failure emails, not a replacement — SLA-bearing jobs (e.g.
--  outbound vendor SFTP) should also email immediately on failure from the job
--  itself, because a next-morning digest is already too late for those.
--
--  IMPORTANT: this digest runs *inside* the orchestrator, so it cannot report
--  that its own host is down. Pair it with an external /healthz dead-man's-switch
--  and alert if the digest email does not arrive. See Administrators_Guide §9.1.
--
--  ADAPT the three placeholders below: SMTP connection, recipient, lookback.
-- =============================================================================

-- 1. SMTP connection. Replace host/user and encrypt the password:
--    ETL-SQL encrypt "your-smtp-password" --pass "YourMasterKey"
CREATE CONNECTION Mailer AS SMTP(
    HOST     = 'smtp.example.com',
    PORT     = 587,
    USER     = 'etl-alerts@example.com',
    PASSWORD = 'ENC:REPLACE_WITH_ENCRYPTED_PASSWORD'
);

DECLARE @recipient STRING = 'ops-team@example.com';
DECLARE @sender    STRING = 'etl-alerts@example.com';

-- 2. Capture job history into a queryable temp table, then keep only recent
--    non-successful runs. 'RUNNING' rows are in-flight jobs (excluded); jobs the
--    orchestrator abandoned in a crash surface as 'INTERRUPTED' and ARE included.
--    Widen the window (e.g. DATEADD(HOUR, -25, ...)) to overlap the schedule.
SELECT * INTO #jobhist FROM eng.job_history;

SELECT job_name, start_time, end_time, status, error_message
INTO #failures
FROM #jobhist
WHERE status NOT IN ('SUCCESS', 'RUNNING')
  AND start_time >= DATEADD(DAY, -1, GETDATE());

DECLARE @failCount INT = (SELECT COUNT(*) FROM #failures);
PRINT CONCAT('Job failures in the last 24h: ', @failCount);

-- 3. Only email when something actually failed.
IF @failCount > 0
BEGIN
    -- One line per failed job: "job_name [STATUS]: error message".
    DECLARE @detail STRING = (
        SELECT STRING_AGG(CONCAT(job_name, ' [', status, ']: ', ISNULL(error_message, '(no message)')), CHAR(10))
        FROM #failures
    );

    SEND EMAIL
        TO @recipient
        FROM @sender
        SUBJECT CONCAT('[ETL-SQL] ', @failCount, ' job failure(s) in the last 24h')
        BODY CONCAT(
            'The following scheduled jobs did not complete successfully in the last 24 hours:', CHAR(10), CHAR(10),
            @detail, CHAR(10), CHAR(10),
            'Review them in the orchestrator (SELECT * FROM eng.job_history) or the Portal.')
        AT Mailer;

    PRINT 'Failure digest sent.';
END;
