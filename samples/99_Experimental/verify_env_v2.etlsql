-- Verification of AllowedEnvVars stabilization (v2)
PRINT 'Authorized (TEMP):';
PRINT ENV('TEMP');

PRINT '--- Trying Unauthorized (USERPROFILE) ---';
BEGIN TRY
    PRINT ENV('USERPROFILE');
    PRINT 'FAILED: USERPROFILE was allowed but shouldn''t be!';
END TRY
BEGIN CATCH
    PRINT 'SUCCESS: Security violation caught.';
    PRINT ERROR_MESSAGE();
END CATCH
