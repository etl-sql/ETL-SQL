PRINT 'Starting Big Data Stress Test (1M rows)...';

CREATE CONNECTION BigData AS FLATFILE('testdata/test_large_1M.csv', HEADER = 'ON');
CREATE CONNECTION SmallData AS FLATFILE('testdata/test_stress_SmallTable.csv', HEADER = 'ON');
CREATE CONNECTION ResultOut AS FLATFILE('samples/output/test_StressResult.csv', HEADER = 'ON');

-- Perform a large scale join
-- Using HASH JOIN to test the optimized streaming hash join
SELECT b.ID, s.Name, b.Value, b.Data
INTO ResultOut.Main
FROM BigData.Main b
INNER HASH JOIN SmallData.Main s ON b.ID = s.ID;

PRINT 'Stress Test Completed.';
