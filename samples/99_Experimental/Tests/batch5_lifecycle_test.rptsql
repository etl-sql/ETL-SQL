-- Batch 5 Lifecycle & Hardening Test

-- 1. Setup sample data
SELECT 'A' as Category, 10 as Val INTO #data;

-- 2. CREATE VISUAL
CREATE VISUAL V1 AS BAR (
    SOURCE = (SELECT * FROM #data),
    MAPPINGS (X = Category, Y = Val),
    TOOLTIP = 'Initial Tooltip'
);

-- 3. CREATE OR ALTER VISUAL (should overwrite)
CREATE OR ALTER VISUAL V1 AS LINE (
    SOURCE = (SELECT * FROM #data),
    MAPPINGS (X = Category, Y = Val),
    TOOLTIP = 'Updated Tooltip via OR ALTER'
);

-- 4. ALTER VISUAL (patching)
ALTER VISUAL V1 (
    TITLE = 'Patched Title',
    TOOLTIP = 'Final Patched Tooltip'
);

-- 5. CREATE BUTTON
CREATE BUTTON RefreshBtn AS REFRESH (
    TITLE = 'Refresh Data',
    TOOLTIP = 'Re-executes the script',
    ACTIONS (ON_CLICK = SET_PARAMETER(@refresh, '1'))
);

-- 6. DROP VISUAL (should remove it)
-- We will create V2 then drop it
CREATE VISUAL V2 AS CARD (
    SOURCE = (SELECT 100 as v),
    MAPPINGS (VALUE = v)
);
DROP VISUAL V2;

-- 7. Verification Page
CREATE PAGE Main AS (
    STRUCTURE = 'A B',
    MAP (
        'A' = V1,
        'B' = RefreshBtn
    )
);

PRINT 'Batch 5 Lifecycle test script completed.';
