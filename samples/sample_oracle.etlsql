-- Demonstrates database connectivity and metadata discovery via Docker
-- Note: Requires Docker Desktop running

USE DOCKER('postgres:15-alpine') AS dpg;
DECLARE @conn varchar(500) = dpg.CONNECTION_STRING;

CREATE CONNECTION db ON POSTGRES(@conn);

-- Execute table creation
EXECUTE db
BEGIN
  DROP TABLE IF EXISTS Employee;
  CREATE TABLE Employee (id INT, name VARCHAR(100));
  INSERT INTO Employee (id, name) VALUES (1, 'Postgres User');
END;

-- Standard SELECT
SELECT * FROM db.Employee;

-- Metadata discovery
HELP CONNECTION POSTGRES;

DOCKER CLOSE dpg;
