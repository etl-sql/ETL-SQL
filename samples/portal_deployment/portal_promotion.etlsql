-- Portal promotion script
-- @requires: portal
-- Update the literal paths/folders for each environment, then run with the
-- desired USE SETS statement active. Portal object names intentionally remain
-- string literals so deployments are reviewable before they touch the portal.

DECLARE @PortalEnvironment STRING = 'DEV';

CREATE SETS !DEV
BEGIN
    @PortalEnvironment = 'DEV'
END;

CREATE SETS !PROD
BEGIN
    @PortalEnvironment = 'PROD';
    SET WITH_PROMPT ON;
END;

-- Change this to !DEV for a non-production rehearsal and update the target
-- folder/script literals below before replaying the promotion.
USE SETS !DEV;

CREATE CONNECTION portal AS PORTAL(
    HOST = 'http://localhost:5000',
    USER = 'admin',
    PASSWORD = 'Admin12345!Password'
);

CREATE CONNECTION orch AS ORCHESTRATOR(
    HOST = 'localhost',
    PORT = 5001,
    API_KEY = 'LocalDevApiKey_32CharsMinimumRequiredForSecurity!'
);

EXECUTE portal
BEGIN
    CREATE GROUP 'FinanceAnalysts';
    CREATE GROUP 'FinanceAdmins';

    CREATE FOLDER '/Finance';
    GRANT EXECUTE ON FOLDER '/Finance' TO GROUP 'FinanceAnalysts';
    GRANT MANAGE ON FOLDER '/Finance' TO GROUP 'FinanceAdmins';

    PUBLISH REPORT 'Monthly Sales'
        FROM '08_Reporting/sales_report.rptsql'
        IN FOLDER '/Finance'
        WITH (DESCRIPTION = 'Certified monthly revenue by region');

    ALTER REPORT 'Monthly Sales'
        SET DESCRIPTION = 'Certified monthly revenue by region';
END;

EXECUTE orch
BEGIN
    CREATE OR ALTER SCHEDULE MonthlySalesMorning ON '0 6 * * *' AT TIME ZONE 'UTC';
    CREATE OR ALTER JOB RefreshMonthlySales FOR REPORT 'Monthly Sales';
    ALTER JOB RefreshMonthlySales ADD SCHEDULE MonthlySalesMorning;
END;

EXECUTE portal
BEGIN
    REFRESH REPORT 'Monthly Sales';
END;
