CREATE CONNECTION source_data AS FLATFILE('data.csv', HEADER = ON);
CREATE CONNECTION smallDict AS FLATFILE('TestData/categories.csv');

SELECT s.category_name, COUNT(*) AS TotalCount, SUM(l.value) AS TotalValue
INTO #havingResults
FROM source_data l
INNER JOIN smallDict s ON l.category = s.id
GROUP BY s.category_name
HAVING TotalCount > 9000 AND TotalCount < 11000;
