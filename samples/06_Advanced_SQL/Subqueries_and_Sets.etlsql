CREATE TABLE #t1 (id INT, name VARCHAR(10));
CREATE TABLE #t2 (id INT, ref_id INT, val VARCHAR(10));

INSERT INTO #t1 VALUES (1, 'A'), (2, 'B'), (3, 'C');
INSERT INTO #t2 VALUES (10, 1, 'X'), (20, 2, 'Y');

PRINT '--- Testing EXISTS Correlated ---';
SELECT name FROM #t1 WHERE EXISTS (SELECT 1 FROM #t2 WHERE ref_id = #t1.id);

PRINT '--- Testing IN Correlated (usually weird but possible) ---';
SELECT name FROM #t1 WHERE id IN (SELECT ref_id FROM #t2 WHERE ref_id = #t1.id);
