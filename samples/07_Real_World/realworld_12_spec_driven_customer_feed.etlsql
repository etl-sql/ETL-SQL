-- Spec-driven customer feed example.
-- This is the completed script after running:
--   etl-sql gen-script -s samples/07_Real_World/realworld_12_spec_driven_customer_feed.json -o Scripts/load_vendor_customer_feed.etlsql
-- and replacing the generated EXTRACT PHASE placeholder with the mock source rows below.

-- 1. Mock the vendor file rows so this cookbook sample runs as-is.
CREATE TABLE #vendor_file (
    customer_id INT,
    email_address VARCHAR(150),
    customer_status VARCHAR(20),
    signup_date VARCHAR(20)
);

INSERT INTO #vendor_file VALUES (1001, 'alice@example.com', 'ACTIVE', '2026-06-01');
INSERT INTO #vendor_file VALUES (1002, 'bad-email', 'ACTIVE', '2026-06-02');
INSERT INTO #vendor_file VALUES (1003, 'carol@example.com', 'UNKNOWN', '2026-06-03');

-- 2. Completed extraction block. In production this SELECT would read from the
-- generated src_file connection instead of #vendor_file.
SELECT
    customer_id AS CustomerId,
    email_address AS Email,
    customer_status AS Status,
    signup_date AS SignupDate
INTO #staging
FROM #vendor_file;

BEGIN TRY
    -- 3. Schema gate generated from the vendor JSON contract.
    EXPECT SCHEMA #staging (
        CustomerId                INT,
        Email                     VARCHAR(150),
        Status                    VARCHAR(20),
        SignupDate                DATE
    );

    -- 4. Cast, trim, and attach governance tags.
    SELECT
        TRY_CAST(CustomerId AS INT) AS CustomerId /*@d: Vendor customer identifier.; @pii*/,
        SUBSTRING(TRY_CAST(Email AS VARCHAR), 1, 150) AS Email /*@d: Customer email address.; @pii*/,
        SUBSTRING(ISNULL(TRY_CAST(Status AS VARCHAR), ''), 1, 20) AS Status /*@d: Customer lifecycle status.*/,
        TRY_CAST(SignupDate AS DATE) AS SignupDate /*@d: Date the customer first registered.*/
    INTO #cleaned_data
    FROM #staging;

    -- 5. Review gates generated from validation_regex and allowed_values.
    CREATE TABLE #spec_validation_issues (column_name VARCHAR(128), issue_type VARCHAR(40), issue_count INT);
    INSERT INTO #spec_validation_issues
    SELECT 'Email', 'REGEX_FORMAT', COUNT(*) FROM #cleaned_data
    WHERE Email IS NOT NULL AND REGEXP_LIKE(Email, '^[^@]+@[^@]+\.[^@]+$') = 0;

    INSERT INTO #spec_validation_issues
    SELECT 'Status', 'ALLOWED_VALUES', COUNT(*) FROM #cleaned_data
    WHERE Status IS NOT NULL AND Status NOT IN ('ACTIVE', 'INACTIVE', 'PENDING');

    -- 6. Quarantine invalid rows because source.reject_policy = 'quarantine'.
    SELECT * INTO #rejected_data FROM #cleaned_data
    WHERE (Email IS NOT NULL AND REGEXP_LIKE(Email, '^[^@]+@[^@]+\.[^@]+$') = 0)
       OR (Status IS NOT NULL AND Status NOT IN ('ACTIVE', 'INACTIVE', 'PENDING'));

    SELECT * INTO #valid_data FROM #cleaned_data
    WHERE NOT (
        (Email IS NOT NULL AND REGEXP_LIKE(Email, '^[^@]+@[^@]+\.[^@]+$') = 0)
        OR (Status IS NOT NULL AND Status NOT IN ('ACTIVE', 'INACTIVE', 'PENDING'))
    );

    -- 7. Pipeline-level lineage tag.
    INSERT TAG FOR TABLE #cleaned_data (
        pipeline_source = 'realworld_12_spec_driven_customer_feed.json',
        owner = 'Customer Data Team',
        classification = 'confidential'
    );

    -- 8. Runnable sample output. A production script generated by gen-script
    -- would write #valid_data into the outbound_dest flat-file connection.
    SELECT * INTO #vendor_customer_export FROM #valid_data;

    PRINT 'Spec-driven customer feed completed. Review #spec_validation_issues and #rejected_data.';
END TRY
BEGIN CATCH
    PRINT 'Spec-driven customer feed failed: ' + ERROR_MESSAGE();
    THROW;
END CATCH;
