-- Sample: Advanced ANSI SQL Features
-- Demonstrates positional ORDER BY and enhanced TOP clauses.

-- 1. Preparation: Virtual dataset
CREATE TABLE #Employees (
    Id INT,
    Name VARCHAR(100),
    Salary DECIMAL(18, 2),
    Department VARCHAR(50)
);

INSERT INTO #Employees (Id, Name, Salary, Department) VALUES 
(1, 'Alice', 95000, 'Eng'),
(2, 'Bob', 80000, 'Sales'),
(3, 'Charlie', 95000, 'Eng'), -- Tie with Alice
(4, 'David', 70000, 'Sales'),
(5, 'Eve', 120000, 'Admin'),
(6, 'Frank', 85000, 'Eng');

-- 2. Positional ORDER BY (1-based index)
-- Sort by Department (4th col) then Salary DESC (3rd col)
PRINT 'Positional Sort: Department (4), Salary DESC (3)';
SELECT Name, Department, Salary, Id
FROM #Employees
ORDER BY 2 ASC, 3 DESC;

-- 3. TOP PERCENT
-- Get the top 50% of earners
PRINT 'TOP 50 PERCENT by Salary';
SELECT TOP (50) PERCENT Name, Salary
FROM #Employees
ORDER BY Salary DESC;

-- 4. TOP WITH TIES
-- Get top 1 earner, but include ties
PRINT 'TOP 1 WITH TIES by Salary';
SELECT TOP (1) WITH TIES Name, Salary
FROM #Employees
ORDER BY Salary DESC;

-- 5. Combined: TOP PERCENT WITH TIES
-- Get top 25% of earners, including ties if they occur at the threshold
PRINT 'TOP 25 PERCENT WITH TIES by Salary';
SELECT TOP (25) PERCENT WITH TIES Name, Salary
FROM #Employees
ORDER BY Salary DESC;
