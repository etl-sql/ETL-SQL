-- ==========================================
-- Sample 20: Data Lineage Tracking
-- Demonstrates how ETL-SQL tracks the flow of data
-- across multiple transformations.
-- ==========================================

-- 1. Setup Sample Data
SELECT ID, Name, Sales
INTO @RawData
FROM (
    SELECT 1 AS ID, 'Alice' AS Name, 100 AS Sales
    UNION ALL SELECT 2 AS ID, 'Bob' AS Name, 200 AS Sales
    UNION ALL SELECT 3 AS ID, 'Charlie' AS Name, 150 AS Sales
) src;

-- 2. First Transformation: Filter and Calculate Tax
SELECT 
    ID, 
    Name, 
    Sales, 
    Sales * 0.1 AS Tax
INTO @TaxedSales
FROM @RawData
WHERE Sales > 120;

-- 3. Second Transformation: Aggregation
SELECT 
    SUM(Sales) AS TotalSales,
    SUM(Tax) AS TotalTax
INTO @Summary
FROM @TaxedSales;

-- 4. Final Output with Lineage (Engine captures this internally)
SELECT * FROM @Summary;

-- 5. Query Lineage Metadata (Virtual Table)
-- eng.lineage is provided by the engine.
SELECT
    source_tables,
    target_table,
    target_column,
    operation
FROM eng.lineage;
