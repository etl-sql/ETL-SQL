-- Lineage_Tag_Import.etlsql
-- Importing lineage and tags that were curated elsewhere, instead of re-deriving them:
--   * INSERT TAG          — seed table/column metadata from your own catalog (loop-friendly)
--   * INSERT LINEAGE FROM — re-import a previously exported OpenLineage document
-- Imports are a starting point: any lineage the script produces afterwards accrues on top
-- (last-writer-wins).

-- ───────────────────────────────────────────────────────────────────────────
-- 1. INSERT TAG — project a custom / in-house metadata catalog into the engine.
--    Pretend these rows live in your own data-catalog tables. Loop over them and
--    seed tags BEFORE the transforms run, so derived columns inherit them.
-- ───────────────────────────────────────────────────────────────────────────
CREATE TABLE #column_docs (tbl VARCHAR(50), col VARCHAR(50), descr VARCHAR(200), owner VARCHAR(50));
INSERT INTO #column_docs VALUES
    ('Orders', 'Amount',    'Gross sale amount in USD',      'Finance'),
    ('Orders', 'OrderDate', 'Timestamp the sale was placed', 'Sales');

FOR @r IN (SELECT tbl, col, descr, owner FROM #column_docs)
BEGIN
    INSERT TAG FOR TABLE @r.tbl COLUMN @r.col (d = @r.descr, owner = @r.owner);
END

-- ───────────────────────────────────────────────────────────────────────────
-- 2. Run a normal transform. The tags seeded above flow onto the derived
--    columns via lineage inheritance — no re-tagging required.
-- ───────────────────────────────────────────────────────────────────────────
CREATE TABLE Orders (OrderId INT, Amount INT, OrderDate DATETIME);
INSERT INTO Orders VALUES (1, 100, '2024-01-01'), (2, 250, '2024-01-02');

SELECT Amount AS Revenue, OrderDate INTO #daily FROM Orders;

PRINT 'Inherited tags on the derived #daily.Revenue column:';
SELECT TagName, TagValue
FROM eng.tags
WHERE TargetTable = '#daily' AND TargetColumn = 'Revenue';

-- ───────────────────────────────────────────────────────────────────────────
-- 3. INSERT LINEAGE ... FROM — re-import a previously exported OpenLineage doc.
--    Export the current lineage, then import it back. In a real pipeline the file
--    would come from a prior run or an upstream system.
-- ───────────────────────────────────────────────────────────────────────────
SHOW LINEAGE EXPORT AS OPENLINEAGE TO 'output/daily_lineage.json';

INSERT LINEAGE FOR TABLE #daily FROM 'output/daily_lineage.json';

PRINT 'Lineage for #daily after import:';
SHOW LINEAGE FOR #daily TO 'output/daily_lineage_report.md';

PRINT 'Done. See samples/04_Orchestration/output/ for the exported artifacts.';
