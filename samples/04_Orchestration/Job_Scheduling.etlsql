-- This script demonstrates Job Scheduling and History

-- 1. Create a reusable schedule, create the script job, then link them
CREATE SCHEDULE EveryMinute ON '*/1 * * * *' AT TIME ZONE 'UTC';
CREATE JOB CleanupTask FOR SCRIPT 'samples/cleanup.etlsql';
ALTER JOB CleanupTask ADD SCHEDULE EveryMinute;

SELECT * FROM eng.jobs;

-- Cleanup
DROP JOB CleanupTask;
DROP SCHEDULE EveryMinute;

-- 2. View current jobs and their status
-- Note: This requires the scheduler service to be running
SELECT * FROM eng.jobs;

-- 3. View job execution history
SELECT * FROM eng.job_history;

-- 4. View history for a specific job
SELECT * FROM eng.job_history WHERE JobName = 'CleanupTask';
