-- Define Database Connections
CREATE CONNECTION my_oracle AS ORACLE('Server=OracleDemo;');
CREATE CONNECTION my_mssql AS MSSQL('Server=SqlDemo;Database=DemoDb;');
CREATE CONNECTION my_csv AS FLATFILE('TestData/test_source.csv');

-- Create Temporary Table via INSERT INTO
INSERT INTO #hr
SELECT ID, UPPER(first_name) AS first_name, CONCAT(first_name, last_name) AS full_name 
FROM my_csv;

-- Test pushing temp table back to MSSQL
INSERT INTO my_mssql.DemoDb.dbo.Employee
SELECT * FROM #hr;

-- Test Direct SELECT INTO
SELECT * INTO #hr2 FROM my_mssql.DemoDb.dbo.Employee;
