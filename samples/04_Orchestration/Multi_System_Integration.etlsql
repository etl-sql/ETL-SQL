-- ======================================================================
-- MEGA SAMPLE: Cross-Database Data Flow & Performance Analysis
-- ======================================================================
-- This script demonstrates:
-- 1. Docker-based multi-database orchestration (MSSQL + Postgres).
-- 2. Performance Profiling (SET PROFILING ON).
-- 3. Execution Plan Analysis (EXPLAIN) with Index Visibility.
-- 4. Cross-platform joins and data transformation.
-- ======================================================================

SET PROFILING ON;

PRINT 'Starting Mega Sample Orchestration...';

-- 1. Setup MSSQL via Docker
-- This starts a container if one isn't already running.
USE DOCKER('mcr.microsoft.com/mssql/server:2022-latest') AS dms;
DECLARE @mssql_conn varchar(500) = dms.CONNECTION_STRING;
CREATE CONNECTION mssql_ds AS MSSQL(@mssql_conn);

-- 2. Initialize MSSQL Tables
PRINT 'Initializing MSSQL Tables...';
EXECUTE mssql_ds
BEGIN
  -- Standard SQL within the remote connection context
  DROP TABLE IF EXISTS EmployeePay;
  DROP TABLE IF EXISTS Employee;
  
  CREATE TABLE Employee (id int, name varchar(500));
  CREATE TABLE EmployeePay (emp_id int, pay_date datetime, amount decimal(10,2), deposit_ref varchar(100));
END;

-- 3. Load Employees (Local Loop)
PRINT 'Loading Employees into MSSQL...';
DECLARE @e int = 1;
WHILE @e <= 10
BEGIN
  INSERT INTO mssql_ds.Employee (id, name) VALUES (@e, CONCAT('Employee ', @e));
  SET @e = @e + 1;
END;

-- 4. Setup Postgres via Docker for Deposits
USE DOCKER('postgres:15-alpine') AS dpg;
DECLARE @pg_conn varchar(500) = dpg.CONNECTION_STRING;
CREATE CONNECTION pg_ds AS POSTGRES(@pg_conn);

PRINT 'Initializing Postgres Tables...';
EXECUTE pg_ds
BEGIN
  DROP TABLE IF EXISTS EmployeeDeposits;
  CREATE TABLE EmployeeDeposits (emp_id int, dep_date timestamp, ref_number varchar(100));
END;

-- 5. Data Generation (Local #Temp Tables)
-- We generate raw data locally to simulate an external source like an API or FlatFile.
PRINT 'Generating Local Salary Data in #temp table...';
DROP TABLE IF EXISTS #LocalSalaries;
CREATE TABLE #LocalSalaries (emp_id int, pay_date datetime, amount decimal(10,2));

-- Simulate weekday data for 10 employees over 20 days
DECLARE @day int = 1;
WHILE @day <= 20
BEGIN
   DECLARE @empl int = 1;
   WHILE @empl <= 10
   BEGIN
       -- Construct a date string: 2023-01-[day]
       -- Note: Implicit string conversion for @day
       INSERT INTO #LocalSalaries VALUES (@empl, '2023-01-' + @day, 5000 + (@empl * 10));
       SET @empl = @empl + 1;
   END;
   SET @day = @day + 1;
END;

PRINT 'Total Rows Generated: ' + (SELECT COUNT(*) FROM #LocalSalaries);

-- 6. Performance Optimization: Local Indexing
-- Adding an index to the local #temp table for faster discrepancy analysis later.
PRINT 'Applying Index to #LocalSalaries...';
CREATE INDEX idx_sal_lookup ON #LocalSalaries (emp_id, pay_date);

-- 7. Cross-Platform Transfer: #LocalSalaries -> MSSQL
PRINT 'Pushing data to MSSQL...';
INSERT INTO mssql_ds.EmployeePay (emp_id, pay_date, amount)
SELECT emp_id, pay_date, amount FROM #LocalSalaries;

-- 8. Simulate Deposits in Postgres (with some missing entries)
PRINT 'Syncing simulated deposits to Postgres...';
INSERT INTO pg_ds.EmployeeDeposits (emp_id, dep_date, ref_number)
SELECT emp_id, CAST(pay_date AS TIMESTAMP), CONCAT('DEP-', emp_id, '-', pay_date)
FROM #LocalSalaries
WHERE (emp_id + DATEPART(DAY, pay_date)) % 7 != 0; -- Skips roughly 1/7th of rows

-- 9. Execution Plan Analysis (Index Visibility)
-- Using EXPLAIN to verify that the local index 'idx_sal_lookup' is utilized.
PRINT '--- EXPLAIN: Discrepancy Analysis Plan ---';
EXPLAIN
SELECT 
    s.emp_id, 
    s.pay_date, 
    s.amount
FROM #LocalSalaries s
LEFT JOIN pg_ds.EmployeeDeposits d ON s.emp_id = d.emp_id AND s.pay_date = d.dep_date
WHERE d.emp_id IS NULL;

-- 10. Final Discrepancy Report
-- Joining a local #temp table with a remote Postgres table.
PRINT 'Final Discrepancy Count (Days without deposits): ' + (
    SELECT COUNT(*) 
    FROM #LocalSalaries s
    LEFT JOIN pg_ds.EmployeeDeposits d ON s.emp_id = d.emp_id AND s.pay_date = d.dep_date
    WHERE d.emp_id IS NULL
);

-- 11. Optional: Quick Index Search test for Profile visibility
PRINT 'Testing Index Visibility in Profile...';
SELECT * FROM #LocalSalaries WHERE emp_id = 1;

-- Show Holistic Profiling Results
SHOW PROFILE;

PRINT 'Mega Sample Complete.';
