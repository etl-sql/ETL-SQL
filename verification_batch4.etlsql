-- Verification Script for Batch 4: Advanced Variable Types (IMAGE, MINMAX)

BEGIN TRY
    PRINT '--- Step 1: Testing IMAGE ---';
    DECLARE @img IMAGE = 'C:\Data\test.png';
    PRINT 'Image variable: ' + @img;

    PRINT '--- Step 2: Testing MINMAX Initialization ---';
    DECLARE @range MINMAX(INT) = (10, 500);
    PRINT 'Range variable: ' + @range;
    
    PRINT '--- Step 3: Testing Member Access (Read) ---';
    IF @range.MIN <> 10 THROW 50001, 'MIN read failed', 1;
    IF @range.MAX <> 500 THROW 50002, 'MAX read failed', 1;
    PRINT 'Member access read passed.';

    PRINT '--- Step 4: Testing Member Access (Write) ---';
    SET @range.MIN = 20;
    SET @range.MAX = 450;
    PRINT 'Updated range: ' + @range;

    IF @range.MIN <> 20 THROW 50003, 'MIN write failed', 1;
    IF @range.MAX <> 450 THROW 50004, 'MAX write failed', 1;
    PRINT 'Member access write passed.';

    PRINT '--- Step 5: Testing Parameterized MINMAX ---';
    DECLARE @fRange MINMAX(DECIMAL) = (1.5, 9.9);
    PRINT 'Decimal range: ' + @fRange;

    PRINT '--- All Batch 4 Tests Passed ---';
END TRY
BEGIN CATCH
    PRINT 'FAILED Batch 4: ' + ERROR_MESSAGE();
    THROW;
END CATCH
