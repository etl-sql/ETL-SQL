# ─── ETL-SQL High Availability (HA) Cluster Environment ─────────────────────────
# Copy this file to create your environment config (e.g. ha-prod.env) and edit every value.
# Two environments MUST NOT share a project name, port block, volume, key, or data root.
# Apply with:
#   docker compose --env-file ha-prod.env -f docker-compose.ha.yml up -d --scale portal=3 --scale orchestrator=2

# Environment id — short, lowercase, DNS-safe. Drives every isolated name below.
ETLSQL_ENV=ha

# Compose project name — namespaces containers, network, and volumes. Keep as etlsql-<env>.
COMPOSE_PROJECT_NAME=etlsql-ha

# Container image tag (pin to a release in production, e.g. v0.12.0).
ETLSQL_IMAGE_TAG=latest

# ─── Load Balancer Exposed Ports ───────────────────────────────────────────────
# The HAProxy load balancer binds to these ports on the host and routes to the services.
PORT_PORTAL=5000
PORT_ORCH=5001
PORT_PG=5032

# ─── Shared data root (host path) ───────────────────────────────────────────────
# Distinct directory per environment. This folder stores the reports, snapshots,
# datasets, maps, and Data Protection key ring shared across all scaled instances.
ENV_DATA_ROOT=./envs/ha

# ─── PostgreSQL (dedicated instance for shared state) ─────────────────────────
PG_USER=etlsql_ha
PG_PASSWORD=CHANGE_ME_strong_unique_password
PG_DB_PORTAL=portal
PG_DB_ORCH=orch

# ─── Keys — UNIQUE PER ENVIRONMENT (never reuse across environments) ─────────────
# Generate with:  ETL-SQL config setup-jwt   /   openssl rand -base64 32
# Crucial: These must be identical across all Portal instances in the HA cluster.
PORTAL_JWT_SECRET=CHANGE_ME_unique_32char_minimum_secret_value
PORTAL_DATASET_KEY=CHANGE_ME_base64_32_byte_key
ORCH_API_KEY=CHANGE_ME_unique_orchestrator_api_key

# ─── Portal first-run admin ──────────────────────────────────────────────────────
PORTAL_ADMIN_USERNAME=admin
