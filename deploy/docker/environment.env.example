# ─── ETL-SQL isolated departmental environment ───────────────────────────────────
# Copy this file once per environment (e.g. dev.env, finance.env) and edit every value.
# Two environments MUST NOT share a project name, port block, volume, key, or data root.
# Apply with:
#   docker compose --env-file finance.env -f docker-compose.environment.yml up -d

# Environment id — short, lowercase, DNS-safe. Drives every isolated name below.
ETLSQL_ENV=dev

# Compose project name — namespaces containers, network, and volumes. Keep as etlsql-<env>.
COMPOSE_PROJECT_NAME=etlsql-dev

# Container image tag (pin to a release in production, e.g. v0.12.0).
ETLSQL_IMAGE_TAG=latest

# ─── Ports ───────────────────────────────────────────────────────────────────────
# Give each environment a distinct PORT_BASE at least 10 apart (dev=5000, test=5010, …).
# Portal=base+0, Orchestrator=base+1, Postgres(published)=base+32.
PORT_PORTAL=5000
PORT_ORCH=5001
PORT_PG=5032

# ─── Per-environment data root (host path) ───────────────────────────────────────
# Distinct directory per environment. Owned by this environment's service account only.
ENV_DATA_ROOT=./envs/dev

# ─── PostgreSQL (dedicated instance per environment) ─────────────────────────────
PG_USER=etlsql_dev
PG_PASSWORD=CHANGE_ME_strong_unique_password
PG_DB_PORTAL=portal
PG_DB_ORCH=orch

# ─── Keys — UNIQUE PER ENVIRONMENT (never reuse across environments) ─────────────
# Generate with:  ETL-SQL config setup-jwt   /   openssl rand -base64 32
PORTAL_JWT_SECRET=CHANGE_ME_unique_32char_minimum_secret_value
PORTAL_DATASET_KEY=CHANGE_ME_base64_32_byte_key
ORCH_API_KEY=CHANGE_ME_unique_orchestrator_api_key

# ─── Portal first-run admin ──────────────────────────────────────────────────────
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=CHANGE_ME_strong_first_run_admin_password
PORTAL_ADMIN_MUST_CHANGE_PASSWORD=true
