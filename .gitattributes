# Shell scripts and systemd unit files MUST use LF line endings — CRLF breaks bash
# (`bad interpreter`) and systemd unit parsing on Linux. Pin them regardless of core.autocrlf.
*.sh        text eol=lf
*.service   text eol=lf

# Shared browser/runtime assets are copied verbatim from
# src/ETL-SQL.ReportRuntime/Resources/Shared/ to host copies (VS Code, Player, Portal). Pin them to
# LF so the canonical and host copies stay byte-identical on every platform — otherwise a Windows CI
# checkout (core.autocrlf=true) converts them to CRLF and the `sync-assets.js -Check` drift gate fails.
*.min.js            text eol=lf
*.min.css           text eol=lf
*.geojson           text eol=lf

# Shared browser/runtime assets are copied verbatim from
# src/ETL-SQL.ReportRuntime/Resources/Shared/ to host copies (VS Code, Player, Portal, Workstation).
# Pin them to LF by path rather than by filename: these directories gain files routinely, and a
# file missed by a per-name pin fails `sync-assets.js --check` only on a fresh clone with
# core.autocrlf=true, where the cause is invisible.
src/ETL-SQL.ReportRuntime/Resources/Shared/**   text eol=lf
src/ETL-SQL.Portal/wwwroot/**/*.js              text eol=lf
src/ETL-SQL.Portal/wwwroot/**/*.css             text eol=lf
src/ETL-SQL.Portal/wwwroot/**/*.html            text eol=lf
src/ETL-SQL.ReportPlayer/wwwroot/**             text eol=lf
src/ETL-SQL.WorkstationEditor/wwwroot/**        text eol=lf
src/etl-sql-vscode/media/**                     text eol=lf

# Reporting golden artifacts are compared and hashed byte for byte across Windows and Linux runners.
# Pin them to LF so a Windows checkout (core.autocrlf=true) cannot change what the lane is comparing.
tests/fixtures/reporting/goldens/**  text eol=lf

# Designer round-trip byte-preservation fixtures. The lane asserts the patcher returns the file
# byte for byte, so the checkout must not touch the bytes either. Everything is pinned to LF except
# the deliberate CRLF fixture, which pins CRLF so both line-ending shapes are actually exercised.
tests/fixtures/reporting/designer-round-trip/**            text eol=lf
tests/fixtures/reporting/designer-round-trip/line-endings-crlf.rptsql  text eol=crlf

# Binary images must retain their bytes even inside LF-pinned browser asset folders.
*.png -text
