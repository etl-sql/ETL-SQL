DECLARE @str STRING = '  ANSI SQL Standard  ';
DECLARE @overlay_target STRING = 'Hello World';
DECLARE @dt DATETIME;

PRINT 'Testing SUBSTRING:';
PRINT 'SUBSTRING(''ABCDEFG'' FROM 2 FOR 3): ' + SUBSTRING('ABCDEFG' FROM 2 FOR 3);
PRINT 'SUBSTRING(''ABCDEFG'' FROM 4): ' + SUBSTRING('ABCDEFG' FROM 4);

PRINT 'Testing POSITION:';
PRINT 'POSITION(''SQL'' IN ''ANSI SQL Standard''): ' + CAST(POSITION('SQL' IN 'ANSI SQL Standard') AS STRING);

PRINT 'Testing TRIM:';
PRINT 'TRIM(BOTH '' '' FROM ''  ANSI SQL  ''): [' + TRIM(BOTH ' ' FROM '  ANSI SQL  ') + ']';
PRINT 'TRIM(LEADING '' '' FROM ''  ANSI SQL  ''): [' + TRIM(LEADING ' ' FROM '  ANSI SQL  ') + ']';
PRINT 'TRIM(TRAILING '' '' FROM ''  ANSI SQL  ''): [' + TRIM(TRAILING ' ' FROM '  ANSI SQL  ') + ']';
PRINT 'Simple TRIM(''  ANSI SQL  ''): [' + TRIM('  ANSI SQL  ') + ']';

PRINT 'Testing EXTRACT:';
SET @dt = CAST('2024-04-07 15:30:45' AS DATETIME);
PRINT 'EXTRACT(YEAR FROM @dt): ' + CAST(EXTRACT(YEAR FROM @dt) AS STRING);
PRINT 'EXTRACT(MONTH FROM @dt): ' + CAST(EXTRACT(MONTH FROM @dt) AS STRING);
PRINT 'EXTRACT(DAY FROM @dt): ' + CAST(EXTRACT(DAY FROM @dt) AS STRING);

PRINT 'Testing OVERLAY:';
PRINT 'OVERLAY(''Hello World'' PLACING ''SQL'' FROM 7 FOR 5): ' + OVERLAY('Hello World' PLACING 'SQL' FROM 7 FOR 5);
PRINT 'OVERLAY(''Hello World'' PLACING ''SQL'' FROM 7): ' + OVERLAY('Hello World' PLACING 'SQL' FROM 7);

PRINT 'Testing LENGTH aliases:';
PRINT 'CHARACTER_LENGTH(''ABC''): ' + CAST(CHARACTER_LENGTH('ABC') AS STRING);
PRINT 'CHAR_LENGTH(''ABC''): ' + CAST(CHAR_LENGTH('ABC') AS STRING);
PRINT 'OCTET_LENGTH(''ABC''): ' + CAST(OCTET_LENGTH('ABC') AS STRING);
