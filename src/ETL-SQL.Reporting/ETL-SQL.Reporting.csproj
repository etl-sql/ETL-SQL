<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ETL_SQL.Reporting</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ETL-SQL.Core\ETL-SQL.Core.csproj" />
    <ProjectReference Include="..\ETL-SQL.Reporting.Contracts\ETL-SQL.Reporting.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="MiniExcel" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="Svg.Skia" />
    <!-- Linux native libSkiaSharp.so for the Docker images (Svg.Skia omits it). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- GeoJSON for native MAP rendering. -->
    <EmbeddedResource Include="..\ETL-SQL.ReportRuntime\Resources\Shared\maps\*.geojson">
      <LogicalName>maps.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ETL-SQL.Tests, PublicKey=$(AssemblyPublicKey)" />
    <InternalsVisibleTo Include="ETL-SQL.Portal.Tests, PublicKey=$(AssemblyPublicKey)" />
  </ItemGroup>

</Project>
