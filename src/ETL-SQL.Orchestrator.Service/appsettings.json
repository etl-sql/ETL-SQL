{
  "Urls": "http://localhost:5100",
  "Logging": {
    "AppLog": {
      "Directory": "logs/orchestrator",
      "RetentionDays": 30,
      "FileSizeLimitMb": 10
    },
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Jobs": {
    "UseProcessSpawning": false,
    "ExecutablePath": "",
    "TimeoutSeconds": 3600,
    "MaxConcurrentJobs": 0
  },
  "Connectors": {
    "Ftp": { "Host": "localhost", "Username": "anonymous", "Password": "" },
    "Sftp": { "Host": "localhost", "Username": "user", "Password": "" },
    "AzureBlob": { "ConnectionString": "UseDevelopmentStorage=true", "Container": "test" }
  }
}
