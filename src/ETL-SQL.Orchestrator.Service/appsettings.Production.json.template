{
  "Orchestrator": {
    "ApiKey": "ENC:GENERATED_API_KEY_HERE",
    "IdentitySigningSecret": "ENC:GENERATED_IDENTITY_SIGNING_SECRET_HERE",
    "RequireFederatedIdentity": true
  },
  "Jobs": {
    "UseProcessSpawning": true,
    "UseWarmRunner": false,
    "WarmRunnerPoolSize": 2,
    "WarmRunnerStartupTimeoutSeconds": 10,
    "WarmRunnerBatchSize": 10000,
    "MaxConcurrentJobs": 8
  },
  "Orchestration": {
    "SandboxAdmission": {
      "Enabled": false,
      "PoolCapacities": {},
      "LeaseSeconds": 120,
      "ActivationPollMilliseconds": 100,
      "ReconciliationSeconds": 30
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5001"
      },
      "Https": {
        "Url": "https://*:5003",
        "Certificate": {
          "Path": "cert.pfx",
          "Password": "ENC:PFX_PASSWORD"
        }
      }
    }
  },
  "Logging": {
    "AppLog": {
      "Directory": "logs/orchestrator",
      "RetentionDays": 30
    }
  }
}
