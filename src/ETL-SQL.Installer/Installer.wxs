<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product Id="*" Name="ETL-SQL" Language="1033" Version="$(var.ProductVersion)" Manufacturer="Charles Clemens" UpgradeCode="7e3da743-19a2-463e-a794-b9fb9a1757e1">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />

        <!-- Close running applications to avoid locked files during upgrade/install -->
        <util:CloseApplication Id="CloseLSP" Target="ETL-SQL-LSP.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />
        <util:CloseApplication Id="CloseCLI" Target="ETL-SQL.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />
        <util:CloseApplication Id="CloseReport" Target="ETL-SQL-Report.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />
        <util:CloseApplication Id="ClosePlayer" Target="ETL-SQL-Player.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />
        <util:CloseApplication Id="CloseService" Target="ETL-SQL-Service.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />
        <util:CloseApplication Id="ClosePortal" Target="ETL-SQL-Portal.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />
        <!-- Publish the resolved folder in Add/Remove Programs so upgrade certification and
             operators can locate the installed binaries without assuming Program Files. -->
        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

        <!-- ═══════════════════════════════════════════════════════════════
             Deployment-profile presets.

             DEPLOY_PROFILE drives the default checkbox values on the
             ChooseFeaturesDlg when selected.  The values are written back
             to the individual INSTALL_* properties so the feature-level
             Condition logic is unchanged.

             DEPLOY_PROFILE values:
               "" (empty)   — Custom / manual selection (default)
               "SOLO"       — Workstation authoring only (CLI + LSP + Player)
               "TEAM"       — Orchestrator + Admin Portal + Workstation tools
               "ENTERPRISE" — Full install: Orchestrator + Report Portal + Workstation tools

             The preset only sets the checkboxes; the user can still
             change individual selections before clicking Install.
        ══════════════════════════════════════════════════════════════════ -->
        <Property Id="DEPLOY_PROFILE" Value="ENTERPRISE" Secure="yes" />

        <!-- ═══════════════════════════════════════════════════════════════
             Component-selection properties.
             These are the authoritative on/off switches consumed by each
             Feature's Condition element.  Default: everything on.

             INSTALL_WORKSTATION    — CLI (etl-sql), LSP, Report CLI, Player
             INSTALL_ORCHESTRATOR   — Job runner Windows Service (:5001)
             INSTALL_ADMIN_PORTAL   — Admin & orchestration surfaces of the Portal
                                      (default-on when Orchestrator is selected;
                                       Team and above require a Portal for identity)
             INSTALL_REPORT_PORTAL  — Reporting catalog, designer, and data-steward
                                      surfaces; can be hosted on a separate server
             PORTAL_SURFACE         — Runtime flag written to appsettings.json controlling
                                      which surfaces the installed Portal binary activates.
                                      Values: "All" | "AdminOnly" | "ReportOnly"
                                      Decided here so the installer feature and the
                                      runtime flag are one decision.
        ══════════════════════════════════════════════════════════════════ -->
        <Property Id="INSTALL_WORKSTATION"   Value="1" Secure="yes" />
        <Property Id="INSTALL_ORCHESTRATOR"  Value="1" Secure="yes" />
        <Property Id="INSTALL_ADMIN_PORTAL"  Value="1" Secure="yes" />
        <Property Id="INSTALL_REPORT_PORTAL" Value="1" Secure="yes" />

        <!-- Admin Portal sub-surface selectors (both default on when Admin Portal is selected).
             These let an operator install only the Orchestrator job-management UI, only the
             Data Steward / governance UI, or both — without changing which binary is installed.
             The PORTAL_SURFACE value is derived from these in configure-portal-jwt.ps1.

             INSTALL_PORTAL_ORCH_SURFACE    — Orchestrator tab: job table, triage board, DAG,
                                              run history, schedule management, watermarks.
             INSTALL_PORTAL_STEWARD_SURFACE — Data Steward tab: data-quality queue, quarantine,
                                              lineage, governance policies.
        -->
        <Property Id="INSTALL_PORTAL_ORCH_SURFACE"   Value="1" Secure="yes" />
        <Property Id="INSTALL_PORTAL_STEWARD_SURFACE" Value="1" Secure="yes" />

        <!-- PORTAL_SURFACE — written to Portal:Surface in appsettings.json.
             Derived from the four selectors above; set by configure-portal-jwt.ps1.
             Valid values (all combinations):
               "All"                    — Report + Orchestrator + DataSteward
               "OrchestratorOnly"       — Orchestrator job UI only, no reports or steward
               "DataStewardOnly"        — Data Steward / governance only, no reports or orch
               "OrchestratorAndSteward" — Both admin surfaces; no reports  (= former AdminOnly)
               "ReportOnly"             — Report catalog and designer only
               "OrchestratorAndReports" — Orchestrator + Reports; no steward
               "StewardAndReports"      — Data Steward + Reports; no orchestrator
        -->
        <Property Id="PORTAL_SURFACE" Value="All" Secure="yes" />

        <!-- Legacy aliases for the JWT custom action — kept so configure-portal-jwt.ps1
             continues to receive familiar flag names in its CustomActionData string. -->
        <Property Id="INSTALL_PORTAL_REPORTING"  Value="1" Secure="yes" />
        <Property Id="INSTALL_PORTAL_DESIGNER"   Value="1" Secure="yes" />
        <Property Id="INSTALL_PORTAL_SCHEDULING" Value="1" Secure="yes" />
        <Property Id="INSTALL_PORTAL_OPERATIONS" Value="1" Secure="yes" />

        <!-- ═══════════════════════════════════════════════════════════════
             Feature tree.

             Everything installs into a single flat folder (the executables
             + appsettings.json).  Sub-features set Level=0 when their
             controlling property is not "1".

             Hierarchy
             ─────────
             ProductFeature
               Feature_Workstation   (was Feature_SDK)
               Feature_Orchestrator
                 Feature_AdminPortal   (default-on sub-feature; Team+ need Portal for identity)
               Feature_ReportPortal  (independent; can go on its own server)
        ══════════════════════════════════════════════════════════════════ -->
        <Feature Id="ProductFeature" Title="ETL-SQL" Level="1" ConfigurableDirectory="INSTALLFOLDER" Display="expand">
            <ComponentRef Id="LicenseDoc" />
            <ComponentRef Id="NoticeDoc" />
            <ComponentRef Id="ThirdPartyNoticesDoc" />

            <!-- ── Workstation Authoring ──────────────────────────────────────
                 The TUI (ETL-SQL.exe), Language Server (ETL-SQL-LSP.exe), Report
                 CLI (ETL-SQL-Report.exe), and Desktop Player (ETL-SQL-Player.exe).
                 Adds INSTALLFOLDER to the system PATH so scripts, VS Code, and
                 notebooks can find the tools without a full path.

                 Renamed from Feature_SDK: "SDK" only described one of the four
                 binaries.  "Workstation" matches the Solo / Workstation deployment
                 profile and is unambiguous on a machine that also runs services.
            ──────────────────────────────────────────────────────────────── -->
            <Feature Id="Feature_Workstation" Title="Workstation Authoring" Level="1" Absent="allow" AllowAdvertise="no"
                     Description="Script editor (TUI), Language Server (LSP), Report CLI, and Desktop Player — the workstation authoring toolkit. Adds the install folder to the system PATH.">
                <Condition Level="0"><![CDATA[INSTALL_WORKSTATION <> "1"]]></Condition>
                <ComponentGroupRef Id="WorkstationComponents" />
                <ComponentRef Id="PathEnvironment" />
                <ComponentRef Id="AppSettings" />
            </Feature>

            <!-- ── Orchestrator Service ───────────────────────────────────────
                 Background job scheduler and engine coordinator.  Installed as a
                 Windows Service on port 5001.

                 The Admin Portal sub-feature is default-on: Team and above require
                 a Portal for identity (the Orchestrator federates identity to the
                 Portal and never grows its own principal registry).  A Solo install
                 can deselect it; the Orchestrator then runs with
                 RequireFederatedIdentity=false and no per-object grants.
            ──────────────────────────────────────────────────────────────── -->
            <Feature Id="Feature_Orchestrator" Title="Orchestrator Service" Level="1" Absent="allow" AllowAdvertise="no"
                     Description="Background job scheduler and engine coordinator, installed as a Windows Service (http://localhost:5001). The Admin Portal sub-feature is included by default — Team and above require a Portal for identity.">
                <Condition Level="0"><![CDATA[INSTALL_ORCHESTRATOR <> "1"]]></Condition>
                <ComponentRef Id="Orchestrator_EXE" />
                <ComponentRef Id="AppSettings" />

                <!-- ── Admin Portal (sub-feature of Orchestrator) ─────────────
                     The orchestration, data-steward, and admin surfaces of the
                     Portal — installed together with the Orchestrator so that
                     the identity exchange path (Portal issues Orchestrator
                     assertions) works out of the box on Team installs.

                     A team can put the Report Portal on a separate server by
                     deselecting Feature_ReportPortal here and installing
                     Feature_ReportPortal separately on the report server.

                     PORTAL_SURFACE is set to "AdminOnly" when only this
                     sub-feature is selected (not Feature_ReportPortal).
                ─────────────────────────────────────────────────────────── -->
                <Feature Id="Feature_AdminPortal" Title="Admin Portal" Level="1" Absent="allow" AllowAdvertise="no"
                         Description="Orchestrator administration, job triage, data-steward, and governance surfaces of the Portal, co-located with the Orchestrator for identity exchange. Installed as a Windows Service (http://localhost:5002).">
                    <Condition Level="0"><![CDATA[INSTALL_ADMIN_PORTAL <> "1"]]></Condition>
                    <ComponentRef Id="Portal_EXE" />
                    <ComponentRef Id="PortalJwtScript" />
                    <ComponentRef Id="AppSettings" />
                    <ComponentGroupRef Id="PortalWwwroot" />
                </Feature>
            </Feature>

            <!-- ── Report Portal ─────────────────────────────────────────────
                 The reporting catalog, visual designer, and end-user report
                 surfaces of the Portal.  Independent of Feature_AdminPortal so
                 a team can host reporting on a dedicated server, separate from
                 the Orchestrator and admin surfaces.

                 When both Feature_AdminPortal and Feature_ReportPortal are
                 selected, PORTAL_SURFACE is set to "All".
                 When only Feature_ReportPortal is selected (without
                 Feature_AdminPortal), PORTAL_SURFACE is set to "ReportOnly".
            ──────────────────────────────────────────────────────────────── -->
            <Feature Id="Feature_ReportPortal" Title="Report Portal" Level="1" Absent="allow" AllowAdvertise="no"
                     Description="Report catalog, visual designer, subscriptions, and end-user reporting surfaces, installed as a Windows Service (http://localhost:5002). Can be installed on a separate server from the Orchestrator and Admin Portal.">
                <Condition Level="0"><![CDATA[INSTALL_REPORT_PORTAL <> "1"]]></Condition>
                <!-- If AdminPortal is not selected, we still need the Portal binary and assets. -->
                <ComponentRef Id="Portal_EXE" />
                <ComponentRef Id="PortalJwtScript" />
                <ComponentRef Id="AppSettings" />
                <ComponentGroupRef Id="PortalWwwroot" />
            </Feature>
        </Feature>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="ETL-SQL" />
            </Directory>
        </Directory>

        <!-- ── Workstation Authoring components (was SDKComponents) ────────── -->
        <ComponentGroup Id="WorkstationComponents" Directory="INSTALLFOLDER">
            <Component Id="ETL_SQL_EXE" Guid="*" Win64="yes">
                <File Source="$(var.PublishDir)\ETL-SQL.exe" KeyPath="yes" />
            </Component>
            <Component Id="ETL_SQL_LSP_EXE" Guid="*" Win64="yes">
                <File Source="$(var.PublishDir)\ETL-SQL-LSP.exe" KeyPath="yes" />
            </Component>
            <Component Id="ETL_SQL_REPORT_EXE" Guid="*" Win64="yes">
                <File Source="$(var.PublishDir)\ETL-SQL-Report.exe" KeyPath="yes" />
            </Component>
            <Component Id="ETL_SQL_PLAYER_EXE" Guid="*" Win64="yes">
                <File Source="$(var.PublishDir)\ETL-SQL-Player.exe" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <DirectoryRef Id="INSTALLFOLDER">
            <!-- One file per component: WiX auto-GUID (Guid="*") is only valid on a multi-file
                 component when the keypath is a versioned PE file. These are unversioned markdown
                 docs, so each gets its own single-file component (LGHT0367 otherwise). -->
            <Component Id="LicenseDoc" Guid="*" Win64="yes">
                <File Id="license_md" Source="..\..\LICENSE.md" KeyPath="yes" />
            </Component>
            <Component Id="NoticeDoc" Guid="*" Win64="yes">
                <File Id="notice_md" Source="..\..\NOTICE.md" KeyPath="yes" />
            </Component>
            <Component Id="ThirdPartyNoticesDoc" Guid="*" Win64="yes">
                <File Id="third_party_notices_md" Source="..\..\THIRD-PARTY-NOTICES.md" KeyPath="yes" />
            </Component>

            <!-- Single shared configuration file -->
            <Component Id="AppSettings" Guid="*" Win64="yes">
                <File Id="appsettings_json" Source="$(var.PublishDir)\appsettings.json" KeyPath="yes" />
            </Component>

            <!-- Orchestrator service (pinned to port 5001 via the urls argument) -->
            <Component Id="Orchestrator_EXE" Guid="*" Win64="yes">
                <File Source="$(var.PublishDir)\ETL-SQL-Service.exe" KeyPath="yes" />
                <ServiceInstall Id="ServiceInstaller_Orchestrator"
                                Type="ownProcess"
                                Name="ETL-SQL-Orchestrator"
                                DisplayName="ETL-SQL Orchestrator"
                                Description="Coordinates distributed ETL-SQL jobs."
                                Start="auto"
                                Account="LocalSystem"
                                ErrorControl="normal"
                                Arguments=" --urls http://localhost:5001" />
                <ServiceControl Id="StartService_Orchestrator" Start="install" Stop="both" Remove="uninstall" Name="ETL-SQL-Orchestrator" Wait="yes" />
            </Component>

            <!-- Portal service (pinned to port 5002 via the urls argument).
                 Shared by both Feature_AdminPortal and Feature_ReportPortal. -->
            <Component Id="Portal_EXE" Guid="*" Win64="yes">
                <File Source="$(var.PublishDir)\ETL-SQL-Portal.exe" KeyPath="yes" />
                <ServiceInstall Id="ServiceInstaller_Portal"
                                Type="ownProcess"
                                Name="ETL-SQL-Portal"
                                DisplayName="ETL-SQL Portal"
                                Description="Web interface for ETL-SQL reports, orchestration, and administration."
                                Start="auto"
                                Account="LocalSystem"
                                ErrorControl="normal"
                                Arguments=" --urls http://localhost:5002" />
                <ServiceControl Id="StartService_Portal" Start="install" Stop="both" Remove="uninstall" Name="ETL-SQL-Portal" Wait="yes" />
            </Component>

            <!-- JWT bootstrap script (used by the deferred WriteJwt custom action) -->
            <Component Id="PortalJwtScript" Guid="*" Win64="yes">
                <File Id="configure_portal_jwt_ps1" Source="configure-portal-jwt.ps1" KeyPath="yes" />
            </Component>

            <!-- PATH entry for the workstation authoring tools -->
            <Component Id="PathEnvironment" Guid="dc70ead1-c4db-42f1-a8e1-7a35cc06cf3f" Win64="yes">
                <RegistryValue Root="HKLM" Key="Software\ETL-SQL" Name="PathConfigured" Value="1" Type="integer" KeyPath="yes" />
                <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
            </Component>
        </DirectoryRef>

        <!-- Opt-in: delete runtime data (reports/db/logs) on uninstall. Default off (data preserved). -->
        <Property Id="CLEANDATA" Value="0" Secure="yes" />

        <!-- Custom actions (JScript). Deferred actions only see CustomActionData, so the install
             folder path is marshaled in via the matching type-51 SetWriteJwtData/SetCleanDataDir.

             PORTAL_SURFACE is forwarded so configure-portal-jwt.ps1 can write the correct
             Portal:Surface value in appsettings.json. -->
        <Binary Id="InstallerActionsJs" SourceFile="installer-actions.js" />
        <CustomAction Id="SetWriteJwtData" Property="WriteJwt"
                      Value="[INSTALLFOLDER]|INSTALL_PORTAL=[INSTALL_ADMIN_PORTAL]|REPORTING=[INSTALL_PORTAL_REPORTING]|DESIGNER=[INSTALL_PORTAL_DESIGNER]|SCHEDULING=[INSTALL_PORTAL_SCHEDULING]|OPERATIONS=[INSTALL_PORTAL_OPERATIONS]|ORCH_SURFACE=[INSTALL_PORTAL_ORCH_SURFACE]|STEWARD_SURFACE=[INSTALL_PORTAL_STEWARD_SURFACE]|REPORT_PORTAL=[INSTALL_REPORT_PORTAL]"
                      Execute="immediate" />
        <CustomAction Id="WriteJwt" BinaryKey="InstallerActionsJs" JScriptCall="ConfigureJwt" Execute="deferred" Impersonate="no" Return="ignore" />
        <CustomAction Id="PromptCleanData" BinaryKey="InstallerActionsJs" JScriptCall="PromptCleanData" Execute="immediate" Return="ignore" />
        <CustomAction Id="SetCleanDataDir" Property="CleanData" Value="[INSTALLFOLDER]" Execute="immediate" />
        <CustomAction Id="CleanData" BinaryKey="InstallerActionsJs" JScriptCall="CleanData" Execute="deferred" Impersonate="no" Return="ignore" />

        <!-- Apply Solo preset defaults: Workstation only -->
        <CustomAction Id="ApplySoloPreset" Property="INSTALL_WORKSTATION"   Value="1"  Execute="immediate" />
        <CustomAction Id="SoloNoOrch"      Property="INSTALL_ORCHESTRATOR"  Value="0"  Execute="immediate" />
        <CustomAction Id="SoloNoAdmin"     Property="INSTALL_ADMIN_PORTAL"  Value="0"  Execute="immediate" />
        <CustomAction Id="SoloNoReport"    Property="INSTALL_REPORT_PORTAL" Value="0"  Execute="immediate" />

        <!-- Apply Team preset defaults: Workstation + Orchestrator + Admin Portal -->
        <CustomAction Id="ApplyTeamPreset"    Property="INSTALL_WORKSTATION"   Value="1"  Execute="immediate" />
        <CustomAction Id="TeamOrch"           Property="INSTALL_ORCHESTRATOR"  Value="1"  Execute="immediate" />
        <CustomAction Id="TeamAdmin"          Property="INSTALL_ADMIN_PORTAL"  Value="1"  Execute="immediate" />
        <CustomAction Id="TeamNoReport"       Property="INSTALL_REPORT_PORTAL" Value="0"  Execute="immediate" />
        <CustomAction Id="TeamSurface"        Property="PORTAL_SURFACE"        Value="AdminOnly" Execute="immediate" />

        <!-- Apply Enterprise preset defaults: everything on -->
        <CustomAction Id="ApplyEnterprisePreset" Property="INSTALL_WORKSTATION"   Value="1"   Execute="immediate" />
        <CustomAction Id="EntOrch"               Property="INSTALL_ORCHESTRATOR"  Value="1"   Execute="immediate" />
        <CustomAction Id="EntAdmin"              Property="INSTALL_ADMIN_PORTAL"  Value="1"   Execute="immediate" />
        <CustomAction Id="EntReport"             Property="INSTALL_REPORT_PORTAL" Value="1"   Execute="immediate" />
        <CustomAction Id="EntSurface"            Property="PORTAL_SURFACE"        Value="All" Execute="immediate" />

        <InstallExecuteSequence>
            <!-- Apply profile presets (immediate, before CostFinalize) so the checkbox
                 dialog inherits the correct default selections when it opens. -->
            <Custom Action="ApplySoloPreset" After="AppSearch"><![CDATA[DEPLOY_PROFILE = "SOLO"]]></Custom>
            <Custom Action="SoloNoOrch"      After="ApplySoloPreset"><![CDATA[DEPLOY_PROFILE = "SOLO"]]></Custom>
            <Custom Action="SoloNoAdmin"     After="SoloNoOrch"><![CDATA[DEPLOY_PROFILE = "SOLO"]]></Custom>
            <Custom Action="SoloNoReport"    After="SoloNoAdmin"><![CDATA[DEPLOY_PROFILE = "SOLO"]]></Custom>

            <Custom Action="ApplyTeamPreset" After="AppSearch"><![CDATA[DEPLOY_PROFILE = "TEAM"]]></Custom>
            <Custom Action="TeamOrch"        After="ApplyTeamPreset"><![CDATA[DEPLOY_PROFILE = "TEAM"]]></Custom>
            <Custom Action="TeamAdmin"       After="TeamOrch"><![CDATA[DEPLOY_PROFILE = "TEAM"]]></Custom>
            <Custom Action="TeamNoReport"    After="TeamAdmin"><![CDATA[DEPLOY_PROFILE = "TEAM"]]></Custom>
            <Custom Action="TeamSurface"     After="TeamNoReport"><![CDATA[DEPLOY_PROFILE = "TEAM"]]></Custom>

            <Custom Action="ApplyEnterprisePreset" After="AppSearch"><![CDATA[DEPLOY_PROFILE = "ENTERPRISE"]]></Custom>
            <Custom Action="EntOrch"               After="ApplyEnterprisePreset"><![CDATA[DEPLOY_PROFILE = "ENTERPRISE"]]></Custom>
            <Custom Action="EntAdmin"              After="EntOrch"><![CDATA[DEPLOY_PROFILE = "ENTERPRISE"]]></Custom>
            <Custom Action="EntReport"             After="EntAdmin"><![CDATA[DEPLOY_PROFILE = "ENTERPRISE"]]></Custom>
            <Custom Action="EntSurface"            After="EntReport"><![CDATA[DEPLOY_PROFILE = "ENTERPRISE"]]></Custom>

            <!-- On install: generate the JWT secret + approve the install folder as a safe zone. -->
            <Custom Action="SetWriteJwtData" After="CostFinalize"><![CDATA[&Feature_AdminPortal=3 OR &Feature_ReportPortal=3 OR &Feature_Orchestrator=3]]></Custom>
            <Custom Action="WriteJwt" After="InstallFiles"><![CDATA[&Feature_AdminPortal=3 OR &Feature_ReportPortal=3 OR &Feature_Orchestrator=3]]></Custom>
            <!-- On a real (non-upgrade), interactive uninstall: prompt, then remove data if the user
                 said yes. The OS-level Yes/No box works even when Settings > Apps runs basic UI;
                 UILevel >= 3 skips fully-silent (/qn) uninstalls so automation never hangs. -->
            <Custom Action="PromptCleanData" After="CostFinalize"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND UILevel >= 3]]></Custom>
            <Custom Action="SetCleanDataDir" After="PromptCleanData"><![CDATA[REMOVE="ALL" AND CLEANDATA="1" AND NOT UPGRADINGPRODUCTCODE]]></Custom>
            <Custom Action="CleanData" After="RemoveFiles"><![CDATA[REMOVE="ALL" AND CLEANDATA="1" AND NOT UPGRADINGPRODUCTCODE]]></Custom>
        </InstallExecuteSequence>

        <!-- Connection hint shown on the final installer page -->
        <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
                  Value="Once the services start, the components are reachable at:&#13;&#10;&#13;&#10;Portal (Admin &amp; Reports):  http://localhost:5002&#13;&#10;Orchestrator API:            http://localhost:5001" />

        <!-- ═══════════════════════════════════════════════════════════════
             UI: standard WiX feature-tree flow.  The icon-tree CustomizeDlg
             is replaced with:
               1. DeployProfileDlg  — preset selector (Solo / Team / Enterprise / Custom)
               2. ChooseFeaturesDlg — checkbox fine-tuning after the preset is applied
        ══════════════════════════════════════════════════════════════════ -->
        <UI>
            <UIRef Id="WixUI_FeatureTree" />

            <!-- ── Deployment-profile preset selector ────────────────────── -->
            <Dialog Id="DeployProfileDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.CustomizeDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Choose a deployment profile" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="Select the profile that matches how you will use ETL-SQL, then click Next to review or adjust components." />

                <!-- Solo -->
                <Control Id="SoloRadio" Type="RadioButton" X="20" Y="60" Width="12" Height="12" Property="DEPLOY_PROFILE" Text="SOLO" />
                <Control Id="SoloLabel" Type="Text" X="36" Y="60" Width="310" Height="12" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title_sm}Solo / Workstation" />
                <Control Id="SoloDesc"  Type="Text" X="36" Y="74" Width="310" Height="20" Transparent="yes" NoPrefix="yes" Text="Script editor, Language Server, and Desktop Player. No services installed. Best for individual developers and analysts." />

                <!-- Team -->
                <Control Id="TeamRadio" Type="RadioButton" X="20" Y="100" Width="12" Height="12" Property="DEPLOY_PROFILE" Text="TEAM" />
                <Control Id="TeamLabel" Type="Text" X="36" Y="100" Width="310" Height="12" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title_sm}Team / SME" />
                <Control Id="TeamDesc"  Type="Text" X="36" Y="114" Width="310" Height="20" Transparent="yes" NoPrefix="yes" Text="Workstation tools + Orchestrator Service + Admin Portal. Shared job scheduling, per-object security, and orchestration UI. No Report Portal." />

                <!-- Enterprise -->
                <Control Id="EntRadio" Type="RadioButton" X="20" Y="140" Width="12" Height="12" Property="DEPLOY_PROFILE" Text="ENTERPRISE" />
                <Control Id="EntLabel" Type="Text" X="36" Y="140" Width="310" Height="12" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title_sm}Enterprise / Full Install" />
                <Control Id="EntDesc"  Type="Text" X="36" Y="154" Width="310" Height="20" Transparent="yes" NoPrefix="yes" Text="All components: Workstation tools + Orchestrator + Admin Portal + Report Portal. Use on a dedicated server or HA node." />

                <!-- Custom -->
                <Control Id="CustomRadio" Type="RadioButton" X="20" Y="180" Width="12" Height="12" Property="DEPLOY_PROFILE" Text="CUSTOM" />
                <Control Id="CustomLabel" Type="Text" X="36" Y="180" Width="310" Height="12" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title_sm}Custom" />
                <Control Id="CustomDesc"  Type="Text" X="36" Y="194" Width="310" Height="12" Transparent="yes" NoPrefix="yes" Text="Select individual components on the next screen." />

                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <Publish Event="NewDialog" Value="ChooseFeaturesDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <!-- ── Component fine-tuning (always shown after preset selection) ── -->
            <Dialog Id="ChooseFeaturesDlg" Width="370" Height="310" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.CustomizeDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Select components to install" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="Check the components you want. All install into the same folder." />

                <!-- Workstation Authoring (was "Client Tools") -->
                <Control Id="WorkstationCheckBox" Type="CheckBox" X="20" Y="55" Width="335" Height="15" Property="INSTALL_WORKSTATION" CheckBoxValue="1" Text="Workstation Authoring" />
                <Control Id="WorkstationDesc" Type="Text" X="34" Y="69" Width="325" Height="12" Transparent="yes" NoPrefix="yes" Text="Script editor (TUI), Language Server, Report CLI, and Desktop Player — adds folder to PATH" />

                <!-- Orchestrator Service -->
                <Control Id="OrchestratorCheckBox" Type="CheckBox" X="20" Y="87" Width="335" Height="15" Property="INSTALL_ORCHESTRATOR" CheckBoxValue="1" Text="Orchestrator Service" />
                <Control Id="OrchestratorDesc" Type="Text" X="34" Y="101" Width="325" Height="12" Transparent="yes" NoPrefix="yes" Text="Job scheduler — Windows Service — http://localhost:5001" />

                <!-- Admin Portal (sub-option under Orchestrator, indented) -->
                <Control Id="AdminPortalCheckBox" Type="CheckBox" X="35" Y="118" Width="310" Height="15" Property="INSTALL_ADMIN_PORTAL" CheckBoxValue="1" Text="Admin Portal (recommended with Orchestrator)">
                    <Condition Action="disable"><![CDATA[INSTALL_ORCHESTRATOR <> "1"]]></Condition>
                    <Condition Action="enable"><![CDATA[INSTALL_ORCHESTRATOR = "1"]]></Condition>
                </Control>
                <Control Id="AdminPortalDesc" Type="Text" X="50" Y="132" Width="300" Height="10" Transparent="yes" NoPrefix="yes" Text="Identity, governance, and admin surfaces — http://localhost:5002">
                    <Condition Action="disable"><![CDATA[INSTALL_ORCHESTRATOR <> "1"]]></Condition>
                    <Condition Action="enable"><![CDATA[INSTALL_ORCHESTRATOR = "1"]]></Condition>
                </Control>

                <!-- Admin Portal sub-surface selectors (indented under Admin Portal) -->
                <Control Id="OrchSurfaceCheckBox" Type="CheckBox" X="52" Y="145" Width="140" Height="13" Property="INSTALL_PORTAL_ORCH_SURFACE" CheckBoxValue="1" Text="Orchestrator UI">
                    <Condition Action="disable"><![CDATA[INSTALL_ADMIN_PORTAL <> "1" OR INSTALL_ORCHESTRATOR <> "1"]]></Condition>
                    <Condition Action="enable"><![CDATA[INSTALL_ADMIN_PORTAL = "1" AND INSTALL_ORCHESTRATOR = "1"]]></Condition>
                </Control>
                <Control Id="OrchSurfaceDesc" Type="Text" X="68" Y="158" Width="130" Height="10" Transparent="yes" NoPrefix="yes" Text="Jobs, triage, DAG, history">
                    <Condition Action="disable"><![CDATA[INSTALL_ADMIN_PORTAL <> "1" OR INSTALL_ORCHESTRATOR <> "1"]]></Condition>
                    <Condition Action="enable"><![CDATA[INSTALL_ADMIN_PORTAL = "1" AND INSTALL_ORCHESTRATOR = "1"]]></Condition>
                </Control>

                <Control Id="StewardSurfaceCheckBox" Type="CheckBox" X="200" Y="145" Width="145" Height="13" Property="INSTALL_PORTAL_STEWARD_SURFACE" CheckBoxValue="1" Text="Data Steward UI">
                    <Condition Action="disable"><![CDATA[INSTALL_ADMIN_PORTAL <> "1" OR INSTALL_ORCHESTRATOR <> "1"]]></Condition>
                    <Condition Action="enable"><![CDATA[INSTALL_ADMIN_PORTAL = "1" AND INSTALL_ORCHESTRATOR = "1"]]></Condition>
                </Control>
                <Control Id="StewardSurfaceDesc" Type="Text" X="216" Y="158" Width="130" Height="10" Transparent="yes" NoPrefix="yes" Text="Quality queue, quarantine">
                    <Condition Action="disable"><![CDATA[INSTALL_ADMIN_PORTAL <> "1" OR INSTALL_ORCHESTRATOR <> "1"]]></Condition>
                    <Condition Action="enable"><![CDATA[INSTALL_ADMIN_PORTAL = "1" AND INSTALL_ORCHESTRATOR = "1"]]></Condition>
                </Control>

                <!-- Report Portal (independent) -->
                <Control Id="ReportPortalCheckBox" Type="CheckBox" X="20" Y="175" Width="335" Height="15" Property="INSTALL_REPORT_PORTAL" CheckBoxValue="1" Text="Report Portal" />
                <Control Id="ReportPortalDesc" Type="Text" X="34" Y="189" Width="325" Height="10" Transparent="yes" NoPrefix="yes" Text="Report catalog, visual designer, and end-user surfaces — http://localhost:5002. Can be on a separate server." />

                <!-- Informational: surface flag summary -->
                <Control Id="SurfaceNote" Type="Text" X="20" Y="206" Width="335" Height="28" Transparent="yes" NoPrefix="yes" Text="Portal:Surface is computed automatically from your selections (e.g. Orchestrator + Steward + Reports = All; Orchestrator only = OrchestratorOnly; Steward + Reports = StewardAndReports)." />

                <Control Id="BottomLine" Type="Line" X="0" Y="270" Width="370" Height="0" />
                <Control Id="Back" Type="PushButton" X="180" Y="279" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="DeployProfileDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="279" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="279" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <!-- Route: License → DeployProfileDlg → ChooseFeaturesDlg → VerifyReady -->
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="DeployProfileDlg" Order="10">LicenseAccepted = "1"</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ChooseFeaturesDlg" Order="10">NOT Installed</Publish>
            <!-- The "delete all data on uninstall" choice is handled by the PromptCleanData custom
                 action (Yes/No message box) rather than an authored dialog, so it also works when
                 Settings > Apps runs the uninstall in basic UI with no wizard. -->
        </UI>
        <!-- Apache License 2.0; overrides WiX's placeholder License.rtf -->
        <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    </Product>
</Wix>
