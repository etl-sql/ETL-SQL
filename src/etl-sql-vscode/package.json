{
  "name": "etl-sql-vscode",
  "displayName": "ETL-SQL Tools",
  "description": "SQL-like scripting for multi-source data pipelines. Run scripts against MSSQL, Postgres, Snowflake, BigQuery, SFTP, REST APIs, flat files, and more — with IntelliSense, linting, live results, and interactive report authoring.",
  "version": "0.13.0",
  "publisher": "etl-sql",
  "license": "Apache-2.0",
  "author": "Charles Clemens <etlsqlsoftware@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/etl-sql/ETL-SQL"
  },
  "bugs": {
    "url": "https://github.com/etl-sql/ETL-SQL/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e2a3a",
    "theme": "dark"
  },
  "keywords": [
    "sql",
    "etl",
    "data pipeline",
    "database",
    "data engineering",
    "mssql",
    "postgres",
    "postgresql",
    "snowflake",
    "bigquery",
    "oracle",
    "sftp",
    "rest api",
    "flatfile",
    "csv",
    "data orchestration",
    "notebook",
    "reporting",
    "lineage",
    "zero-trust"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Notebooks",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:etlsql",
    "onNotebook:etl-sql-notebook",
    "onView:etlsql-sidebar",
    "onView:etlsql-results-view",
    "onCommand:etlsql.previewReport",
    "onCommand:etlsql.openReportDesigner",
    "onCommand:etlsql.runScript",
    "onCommand:etlsql.runSelection",
    "onCommand:etlsql.showLineage",
    "onCommand:etlsql.publishToPortal",
    "onCommand:etlsql.exportNotebook",
    "onCommand:etlsql.generateScriptFromSpec",
    "onCommand:etlsql.reportIssue"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "notebooks": [
      {
        "type": "etl-sql-notebook",
        "displayName": "ETL-SQL Notebook",
        "selector": [
          {
            "filenamePattern": "*.etlnb"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "etlsql-explorer",
          "title": "ETL-SQL",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "etlsql-panel",
          "title": "ETL-SQL Results",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "etlsql-explorer": [
        {
          "type": "webview",
          "id": "etlsql-sidebar",
          "name": "Metadata Explorer",
          "visibility": "visible"
        }
      ],
      "etlsql-panel": [
        {
          "type": "webview",
          "id": "etlsql-results-view",
          "name": "Pipeline & Results"
        }
      ]
    },
    "languages": [
      {
        "id": "etlsql",
        "aliases": [
          "ETL-SQL",
          "etlsql"
        ],
        "extensions": [
          ".etlsql",
          ".rptsql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "etlsql",
        "scopeName": "source.etlsql",
        "path": "./syntaxes/etlsql.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "etlsql",
        "path": "./snippets/etlsql.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "ETL-SQL",
      "properties": {
        "etlsql.executable.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "**(Advanced Override)** Path or command for a custom `ETL-SQL` CLI runner. Leave blank to automatically use the bundled executable or system `PATH` version (recommended)."
        },
        "etlsql.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "**(Advanced Override)** Path to a custom `ETL-SQL` Language Server (LSP) executable (`ETL-SQL-LSP.exe`). Leave blank to automatically use the bundled/system version (recommended)."
        },
        "etlsql.report.executable.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "**(Advanced Override)** Path or command for a custom `ETL-SQL` Report CLI runner (`ETL-SQL-Report.exe`). Leave blank to automatically use the bundled/system version (recommended)."
        },
        "etlsql.report.autoOpenPreview": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Automatically open the interactive split-screen **Report Preview** pane when opening a `.rptsql` file."
        },
        "etlsql.portal.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "The base URL of your hosted **ETL-SQL Report Portal** (e.g. `http://localhost:5001`). Used to publish dashboards directly from VS Code."
        },
        "etlsql.format.keywordCasing": {
          "type": "string",
          "enum": ["upper", "lower", "pascal", "preserve"],
          "default": "upper",
          "markdownDescription": "Casing style for SQL keywords. *Note: Ignored if a workspace `.etlsqlformat.json` configuration file is present.*"
        },
        "etlsql.format.indentSize": {
          "type": "integer",
          "default": 4,
          "markdownDescription": "Number of spaces per indentation level. *Note: Ignored if a workspace `.etlsqlformat.json` configuration file is present.*"
        },
        "etlsql.format.commaPlacement": {
          "type": "string",
          "enum": ["trailing", "leading"],
          "default": "leading",
          "markdownDescription": "Position of list commas (leading or trailing). *Note: Ignored if a workspace `.etlsqlformat.json` configuration file is present.*"
        },
        "etlsql.format.indentJoins": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Indent JOIN statements relative to the FROM clause. *Note: Ignored if a workspace `.etlsqlformat.json` configuration file is present.*"
        },
        "etlsql.format.onClauseOnNewLine": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Place the ON clause of a JOIN statement on a new line. *Note: Ignored if a workspace `.etlsqlformat.json` configuration file is present.*"
        },
        "etlsql.format.caseWhenThenNewLine": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Place the THEN clause of a CASE WHEN statement on a new line. *Note: Ignored if a workspace `.etlsqlformat.json` configuration file is present.*"
        },
        "etlsql.format.breakoutWindowFunctions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Break out window function parameters (PARTITION BY, ORDER BY) onto separate lines. *Note: Ignored if a workspace `.etlsqlformat.json` configuration file is present.*"
        },
        "etlsql.ai.provider": {
          "type": "string",
          "enum": ["Gemini", "OpenAI", "Anthropic", "OpenRouter", "VS Code Chat Extensions (Copilot/Claude/etc.)", "Custom"],
          "default": "Gemini",
          "markdownDescription": "The AI provider to use for parsing specifications. Gemini and Anthropic support direct PDF analysis; OpenAI supports text files; VS Code Chat Extensions uses your installed VS Code chat model provider (no API key required)."
        },
        "etlsql.ai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API Key for the selected AI provider. Not required if using VS Code Chat Extensions."
        },
        "etlsql.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "The specific AI model to run (e.g. `gemini-1.5-flash`, `gpt-4o`, `claude-3-5-sonnet-latest`). If blank, standard defaults are used based on the provider."
        },
        "etlsql.ai.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "**(Advanced)** Override the default API endpoint URL. Required when using `Custom` provider (e.g., local Ollama, LocalAI, or custom OpenAI gateway)."
        }
      }
    },
    "commands": [
      {
        "command": "etlsql.previewReport",
        "title": "ETL-SQL: Preview Report",
        "icon": "$(graph)"
      },
      {
        "command": "etlsql.openReportDesigner",
        "title": "ETL-SQL: Open Report Designer",
        "icon": "$(edit)"
      },
      {
        "command": "etlsql.runScript",
        "title": "ETL-SQL: Run Script",
        "icon": "$(play)"
      },
      {
        "command": "etlsql.runSelection",
        "title": "ETL-SQL: Run Selection",
        "icon": "$(run-above)"
      },
      {
        "command": "etlsql.showLineage",
        "title": "ETL-SQL: Show Visual Lineage"
      },
      {
        "command": "etlsql.refreshConnections",
        "title": "ETL-SQL: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "etlsql.copyConnection",
        "title": "ETL-SQL: Copy CREATE CONNECTION",
        "icon": "$(clippy)"
      },
      {
        "command": "etlsql.browseFile",
        "title": "ETL-SQL: Browse for Flat File...",
        "icon": "$(file-add)"
      },
      {
        "command": "etlsql.stopScript",
        "title": "ETL-SQL: Stop Script",
        "icon": "$(primitive-square)"
      },
      {
        "command": "etlsql.launchInBrowser",
        "title": "ETL-SQL: Open Report in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "etlsql.launchReportFile",
        "title": "Launch current report only",
        "icon": "$(file)"
      },
      {
        "command": "etlsql.launchReportDirectory",
        "title": "Launch all reports in directory",
        "icon": "$(file-directory)"
      },
      {
        "command": "etlsql.launchReportManifest",
        "title": "Launch using reports.json",
        "icon": "$(list-unordered)"
      },
      {
        "command": "etlsql.publishToPortal",
        "title": "ETL-SQL: Publish to Report Portal"
      },
      {
        "command": "etlsql.exportMarkdown",
        "title": "ETL-SQL: Export Markdown"
      },
      {
        "command": "etlsql.exportPdf",
        "title": "ETL-SQL: Export PDF"
      },
      {
        "command": "etlsql.exportText",
        "title": "ETL-SQL: Export Text"
      },
      {
        "command": "etlsql.rollbackTransactions",
        "title": "ETL-SQL: Rollback All Transactions",
        "icon": "$(history)"
      },
      {
        "command": "etlsql.showWelcome",
        "title": "ETL-SQL: Show Welcome Page",
        "category": "ETL-SQL"
      },
      {
        "command": "etlsql.exportNotebook",
        "title": "ETL-SQL: Export Notebook to .etlsql",
        "icon": "$(export)"
      },
      {
        "command": "etlsql.generateScriptFromSpec",
        "title": "ETL-SQL: Generate Script from Spec"
      },
      {
        "command": "etlsql.reportIssue",
        "title": "ETL-SQL: Report Issue & Export Logs",
        "category": "ETL-SQL"
      }
    ],
    "keybindings": [
      {
        "command": "etlsql.runScript",
        "key": "f5",
        "when": "resourceLangId == etlsql && !editorHasSelection"
      },
      {
        "command": "etlsql.runSelection",
        "key": "f5",
        "when": "resourceLangId == etlsql && editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "etlsql.runScript",
          "group": "etlsql",
          "when": "resourceLangId == etlsql && !etlsql.isRunning"
        },
        {
          "command": "etlsql.stopScript",
          "group": "etlsql",
          "when": "resourceLangId == etlsql && etlsql.isRunning"
        },
        {
          "command": "etlsql.runSelection",
          "group": "etlsql",
          "when": "resourceLangId == etlsql && editorHasSelection && !etlsql.isRunning"
        },
        {
          "command": "etlsql.browseFile",
          "group": "etlsql",
          "when": "resourceLangId == etlsql"
        },
        {
          "command": "etlsql.previewReport",
          "group": "etlsql",
          "when": "resourceLangId == etlsql"
        },
        {
          "command": "etlsql.openReportDesigner",
          "group": "etlsql",
          "when": "resourceLangId == etlsql"
        }
      ],
      "editor/title": [
        {
          "command": "etlsql.runScript",
          "group": "navigation@10",
          "when": "resourceLangId == etlsql && !etlsql.isRunning"
        },
        {
          "command": "etlsql.stopScript",
          "group": "navigation@10",
          "when": "resourceLangId == etlsql && etlsql.isRunning"
        },
        {
          "command": "etlsql.runSelection",
          "group": "navigation@11",
          "when": "resourceLangId == etlsql && editorHasSelection && !etlsql.isRunning"
        },
        {
          "command": "etlsql.previewReport",
          "group": "navigation@12",
          "when": "resourceLangId == etlsql"
        },
        {
          "command": "etlsql.openReportDesigner",
          "group": "navigation@13",
          "when": "resourceLangId == etlsql"
        },
        {
          "submenu": "etlsql.launchMenu",
          "group": "navigation@14",
          "when": "resourceLangId == etlsql"
        },
        {
          "command": "etlsql.exportNotebook",
          "group": "navigation@15",
          "when": "notebookEditorFocused && notebookType == etl-sql-notebook"
        }
      ],
      "view/title": [
        {
          "command": "etlsql.refreshConnections",
          "when": "view == etlsql-sidebar",
          "group": "navigation@1"
        },
        {
          "command": "etlsql.runScript",
          "when": "view == etlsql-sidebar",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "etlsql.copyConnection",
          "when": "view == etlsql-sidebar && viewItem == connection-script",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "etlsql.generateScriptFromSpec",
          "group": "etlsql",
          "when": "resourceFilename =~ /\\.(pdf|xlsx|xls|csv|tsv|json|txt|docx|doc)$/i"
        }
      ],
      "etlsql.launchMenu": [
        {
          "command": "etlsql.launchReportFile"
        },
        {
          "command": "etlsql.launchReportDirectory"
        },
        {
          "command": "etlsql.launchReportManifest"
        }
      ]
    },
    "submenus": [
      {
        "id": "etlsql.launchMenu",
        "label": "Launch Options",
        "icon": "$(rocket)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run sync-assets && tsc -p ./",
    "sync-assets": "node ../../scripts/sync-assets.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^25.9.4",
    "@types/vscode": "^1.91.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.6.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "jsdom": "^29.0.2",
    "mocha": "^11.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "diff": ">=8.0.3",
    "brace-expansion": ">=5.0.6",
    "undici": ">=7.28.0"
  }
}
