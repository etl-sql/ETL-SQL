{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "ETL-SQL",
    "scopeName": "source.etlsql",
    "patterns": [
        {
            "include": "#native-sql-pushdown"
        },
        {
            "include": "#tags"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "native-sql-pushdown": {
            "begin": "(?i)\\b(EXECUTE|EXEC)\\s+([a-zA-Z0-9_#@]+|'[^']+')\\s+(BEGIN)\\b",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.etlsql"
                },
                "2": {
                    "name": "variable.other.etlsql"
                },
                "3": {
                    "name": "keyword.control.etlsql"
                }
            },
            "end": "(?i)\\b(END)\\b",
            "endCaptures": {
                "0": {
                    "name": "keyword.control.etlsql"
                }
            },
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        "tags": {
            "patterns": [
                {
                    "name": "comment.block.etlsql",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "match": "(@[a-zA-Z0-9_]+):\\s*([^;]+);",
                            "captures": {
                                "1": {
                                    "name": "storage.type.etlsql"
                                },
                                "2": {
                                    "name": "variable.parameter.etlsql"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.etlsql",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.line.double-dash.etlsql",
                    "match": "--.*"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "(?i)\\b(AS)\\s+([a-zA-Z0-9_]+)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.etlsql"
                        },
                        "2": {
                            "name": "variable.other.alias.etlsql"
                        }
                    }
                },
                {
                    "name": "keyword.control.etlsql",
                    "match": "(?i)\\b(SELECT|INSERT|UPDATE|DELETE|MERGE|SET|SHOW|FROM|WHERE|GROUP\\s+BY|ORDER\\s+BY|HAVING|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|ON|CROSS|APPLY|UNION|ALL|INTERSECT|EXCEPT|TRUNCATE|INTO|CREATE|TABLE|CONNECTION|ON|TYPE|TARGET|DROP|DECLARE|PRINT|IF|ELSE|WHILE|FOR|FOREACH|EACH|BEGIN|END|TRY|CATCH|THROW|RAISEERROR|EXEC|EXECUTE|RETURN|BREAK|CONTINUE|JOB|STEP|ORCHESTRATE|LOAD|BULK|OUTPUT|LINEAGE|DOCKER|START|STOP|PAUSE|CLOSE|PARALLEL|RUN|SCRIPT|USE|LINT|WITH|WITHIN|PROFILING|PROFILE|ON|OFF|EXPLAIN|AS|WAITFOR|DELAY|TIME)\\b"
                },
                {
                    "name": "support.class.etlsql",
                    "match": "(?i)\\b(FLATFILE|CSV|MSSQL|POSTGRES|ORACLE|ODBC|EXCEL|JSON|XML|MOCKDB)\\b"
                },
                {
                    "name": "storage.type.etlsql",
                    "match": "(?i)\\b(INT|INTEGER|DECIMAL|MONEY|NUMERIC|FLOAT|DOUBLE|BIT|BOOLEAN|BOOL|TINYINT|BIGINT|DATETIME|DATE|TIMESTAMP|TIME|STRING|VARCHAR|TEXT|CHAR|JSON|XML|PATH|ENCRYPTED|VARBINARY|IMAGE|BLOB|LOB|UNIQUEIDENTIFIER|VECTOR)\\b"
                },
                {
                    "name": "variable.other.etlsql",
                    "match": "((@|#)[a-zA-Z_][a-zA-Z0-9_]*)"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.etlsql",
                    "match": "(?i)\\b(GETDATE|GET_DATE|DATEADD|DATEDIFF|CAST|CONVERT|JSON_VALUE|JSON_QUERY|ISNULL|COALESCE|SUM|COUNT|AVG|MIN|MAX|HASHBYTES|NEWID|CHECKSUM|AT\\s+TIME\\s+ZONE|FILE_EXISTS|DIRECTORY_EXISTS|FILE_LIST|REGEXP_LIKE|REGEXP_SUBSTR|REGEXP_REPLACE|REGEXP_INSTR|REGEXP_COUNT|REGEXP_MATCHES|REGEXP_SPLIT_TO_TABLE|STUFF|STRING_ESCAPE|STRING_SPLIT|ASCII|CHAR|FORMAT|PATINDEX|STR|QUOTENAME|TRANSLATE|UNICODE|DATALENGTH|TO_STR|REPLICATE|TRY_CAST|SIN|COS|TAN|ASIN|ACOS|ATAN|ATAN2|SIGN)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.single.etlsql",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.etlsql",
                            "match": "''"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.etlsql",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.etlsql",
                    "match": "(=|<>|<|>|<=|>=|\\+|\\-|\\*|/|%|&|\\||\\^|~)"
                }
            ]
        }
    }
}