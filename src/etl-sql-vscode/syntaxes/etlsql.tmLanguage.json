{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "ETL-SQL",
    "scopeName": "source.etlsql",
    "patterns": [
        {
            "include": "#native-sql-pushdown"
        },
        {
            "include": "#tags"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "native-sql-pushdown": {
            "begin": "(?i)\\b(EXECUTE|EXEC)\\s+([a-zA-Z0-9_#@]+|'[^']+')\\s+(BEGIN)\\b",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.etlsql"
                },
                "2": {
                    "name": "variable.other.etlsql"
                },
                "3": {
                    "name": "keyword.control.etlsql"
                }
            },
            "end": "(?i)\\b(END)\\b",
            "endCaptures": {
                "0": {
                    "name": "keyword.control.etlsql"
                }
            },
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        "tags": {
            "patterns": [
                {
                    "name": "comment.block.etlsql",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "match": "(@[a-zA-Z0-9_]+):\\s*([^;]+);",
                            "captures": {
                                "1": {
                                    "name": "storage.type.etlsql"
                                },
                                "2": {
                                    "name": "variable.parameter.etlsql"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.etlsql",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.line.double-dash.etlsql",
                    "match": "--.*"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "(?i)\\b(AS)\\s+([a-zA-Z0-9_]+)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.etlsql"
                        },
                        "2": {
                            "name": "variable.other.alias.etlsql"
                        }
                    }
                },
                {
                    "name": "keyword.control.etlsql",
                    "match": "(?i)\\b(SELECT|INSERT|UPDATE|DELETE|MERGE|SET|SHOW|FROM|WHERE|GROUP\\s+BY|ORDER\\s+BY|HAVING|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|ON|CROSS|APPLY|UNION|ALL|INTERSECT|EXCEPT|TRUNCATE|INTO|CREATE|TABLE|CONNECTION|TYPE|TARGET|DROP|DECLARE|PRINT|IF|ELSE|WHILE|FOR|FOREACH|EACH|BEGIN|END|TRY|CATCH|THROW|RAISEERROR|EXEC|EXECUTE|RETURN|BREAK|CONTINUE|JOB|JOBS|JOB\\s+HISTORY|ACTIVE\\s+JOBS|DATASETS|CONNECTIONS|TABLES|COLUMNS|VARIABLES|SCRIPT\\s+TAGS|TAGS|PROFILE|VERSION|LINEAGE|ORCHESTRATE|ORCHESTRATOR|REPORTPORTAL|REPORT_PORTAL|ORCH|LOAD|BULK|OUTPUT|DOCKER|START|STOP|PAUSE|CLOSE|PARALLEL|RUN|SCRIPT|USE|LINT|WITH|WITHIN|PROFILING|PROFILE|SHOW_PASSWORD|SHOW_SECRETS|ALLOW_PLAINTEXT_SECRETS|NO_SAVE_SENSITIVE|NO_SAVE_CONNECTION|CONNECTION_ENCRYPTION|ON|OFF|EXPLAIN|AS|WAITFOR|DELAY|TIME|PUBLISH|VALIDATE|EXPORT|BUNDLE|BUNDLES|PUBLISHED|VERSIONS|FILES|DEPENDENCIES|ANALYZE|WHAT_IF|FAVORITE|UNFAVORITE|CATALOG|RECENT|PERMISSIONS|EFFECTIVE|USAGE|METRICS|SHARE|LINK|LINKS|EMBED|TOKEN|TOKENS|SAVED|VIEW|VIEWS|ALERT|ALERTS|DISCONNECT|RESTART|SHUTDOWN|PORTAL|REPORT|REPORTS|ACTIVE|DELIVER|FORMAT|SMTP|EXPIRES|DASHBOARD|PAGINATED|FETCH|ON_LOAD|ON_RUN)\\b"
                },
                {
                    "name": "support.class.etlsql",
                    "match": "(?i)\\b(FLATFILE|CSV|MSSQL|POSTGRES|ORACLE|ODBC|EXCEL|JSON|XML|MOCKDB|ORCHESTRATOR|REPORTPORTAL|REPORT_PORTAL|ORCH|SFTP|FTP|FTP_CONN|AZURE_BLOB|SMTP|DIRECTORY|SNOWFLAKE|BIGQUERY|PARQUET|AVRO|API|REST)\\b"
                },
                {
                    "name": "storage.type.etlsql",
                    "match": "(?i)\\b(INT|INTEGER|DECIMAL|MONEY|NUMERIC|FLOAT|DOUBLE|BIT|BOOLEAN|BOOL|TINYINT|BIGINT|DATETIME|DATE|TIMESTAMP|TIME|STRING|VARCHAR|TEXT|CHAR|JSON|XML|PATH|ENCRYPTED|VARBINARY|IMAGE|BLOB|LOB|UNIQUEIDENTIFIER|VECTOR)\\b"
                },
                {
                    "name": "variable.other.etlsql",
                    "match": "((@|#)[a-zA-Z_][a-zA-Z0-9_]*)"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.etlsql",
                    "match": "(?i)\\b(GETDATE|GET_DATE|RELDATE|DATEADD|DATEDIFF|DATEPART|CAST|CONVERT|TRY_CAST|JSON_VALUE|JSON_QUERY|JSON_MODIFY|ISJSON|JSON_EXISTS|JSON_OBJECT|JSON_ARRAY|JSON_TABLE|JSON_EXTRACT|OPENJSON|ISNULL|COALESCE|NVL|NVL2|NULLIF|DECODE|LEAST|GREATEST|SUM|COUNT|AVG|MIN|MAX|DENSE_RANK|ROW_NUMBER|RANK|HASHBYTES|BINARY_CHECKSUM|NEWID|NEWSEQUENTIALID|CHECKSUM|AT\\s+TIME\\s+ZONE|FILE_EXISTS|DIRECTORY_EXISTS|FILE_LIST|REGEXP_LIKE|REGEXP_SUBSTR|REGEXP_REPLACE|REGEXP_INSTR|REGEXP_COUNT|REGEXP_MATCHES|REGEXP_SPLIT_TO_TABLE|STUFF|STRING_ESCAPE|STRING_SPLIT|ASCII|CHAR|CHARINDEX|FORMAT|PATINDEX|STR|QUOTENAME|TRANSLATE|UNICODE|DATALENGTH|TO_STR|REPLICATE|SIN|COS|TAN|ASIN|ACOS|ATAN|ATAN2|SIGN|ABS|ROUND|CEILING|FLOOR|LPAD|RPAD|INITCAP|SUBSTR|SUBSTRING|LEN|POWER|SQRT|EXP|LOG|LN|MOD|TRUNC|APPEND_TO_LIST|REMOVE_FROM_LIST|LENGTH|SORT_LIST|DATETIMEFROMPARTS|TIMEFROMPARTS|DATETIMEOFFSETSFROMPARTS|XMLVALUE|XMLEXISTS|XMLQUERY|XMLTABLE|XMLELEMENT|XMLATTRIBUTES|XMLFOREST|EXTRACTVALUE|SEQUENCE|RANDOM|RANDOM_INT|RANDOM_DECIMAL|GET_TAGS|GET_TAG_VALUE|HAS_TAG|NORMALIZE|SIMILARITY|LEVENSHTEIN|SOUNDEX|METAPHONE|DMETAPHONE|DMETAPHONE_ALT|NGRAMS|NGRAM_TOKENS)\\b"
                },
                {
                    "name": "support.function.etlsql",
                    "match": "(?i)\\b([A-Z_][A-Z0-9_]{1,})\\s*(?=\\()"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.single.etlsql",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.etlsql",
                            "match": "''"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.etlsql",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.etlsql",
                    "match": "(=|<>|<|>|<=|>=|\\+|\\-|\\*|/|%|&|\\||\\^|~)"
                }
            ]
        }
    }
}
