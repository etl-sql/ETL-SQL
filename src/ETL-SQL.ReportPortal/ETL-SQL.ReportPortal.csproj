<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ETL_SQL.ReportPortal</RootNamespace>
    <AssemblyName>ETL-SQL-Portal</AssemblyName>
    <!-- Disable automatic static web assets to prevent duplicate conflicts with referenced projects -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ETL-SQL.Engine\ETL-SQL.Engine.csproj" />
    <ProjectReference Include="..\ETL-SQL.Connectors\ETL-SQL.Connectors.csproj" />
    <ProjectReference Include="..\ETL-SQL.ReportBuilder\ETL-SQL.ReportBuilder.csproj" />
    <ProjectReference Include="..\ETL-SQL.ReportPlayer\ETL-SQL.ReportPlayer.csproj" />
    <ProjectReference Include="..\ETL-SQL.Orchestrator\ETL-SQL.Orchestrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
    <PackageReference Include="Cronos" Version="0.12.0" />
  </ItemGroup>

  <!-- Manual asset copy since we disabled StaticWebAssets -->
  <Target Name="CopyManualAssets" BeforeTargets="Build">
    <ItemGroup>
      <_PlayerRuntime Include="..\ETL-SQL.ReportPlayer\wwwroot\report-runtime.js" />
      <_PlayerMaps Include="..\ETL-SQL.ReportPlayer\wwwroot\maps\*.geojson" />
      <_PlayerCss Include="..\ETL-SQL.ReportPlayer\wwwroot\report-runtime.css" />
    </ItemGroup>
    <Copy SourceFiles="@(_PlayerRuntime)" DestinationFolder="wwwroot\js" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PlayerMaps)" DestinationFolder="wwwroot\maps" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PlayerCss)" DestinationFolder="wwwroot\css" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyManualAssetsOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_PortalRoot Include="wwwroot\**\*" />
      <_PlayerRuntimePub Include="..\ETL-SQL.ReportPlayer\wwwroot\report-runtime.js" />
      <_PlayerMapsPub Include="..\ETL-SQL.ReportPlayer\wwwroot\maps\*.geojson" />
      <_PlayerCssPub Include="..\ETL-SQL.ReportPlayer\wwwroot\report-runtime.css" />
    </ItemGroup>
    <Copy SourceFiles="@(_PortalRoot)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PlayerRuntimePub)" DestinationFolder="$(PublishDir)wwwroot\js" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PlayerMapsPub)" DestinationFolder="$(PublishDir)wwwroot\maps" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PlayerCssPub)" DestinationFolder="$(PublishDir)wwwroot\css" SkipUnchangedFiles="true" />
  </Target>

</Project>
