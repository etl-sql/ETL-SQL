{
  "Portal": {
    "DatabasePath": "data/portal.db",
    "MapRootPath": "data/maps",
    "Jwt": {
      "Secret": "ENC:GENERATED_SECRET_HERE",
      "ExpiryMinutes": 60
    },
    "FirstRun": {
      "AdminUsername": "admin",
      "MustChangePassword": true
    },
    "PolicyAuthority": {
      "SigningCertThumbprint": "0123456789ABCDEF0123456789ABCDEF01234567"
    }
  },
  "ConnectionStrings": {
    "Default": "ENC:ENCRYPTED_CONNECTION_STRING"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      },
      "Https": {
        "Url": "https://*:5002",
        "Certificate": {
          "Path": "cert.pfx",
          "Password": "ENC:PFX_PASSWORD"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
