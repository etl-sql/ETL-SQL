    "Ftp": { "Host": "localhost", "Username": "anonymous", "Password": "" },
    "Sftp": { "Host": "localhost", "Username": "user", "Password": "pass" },
    "AzureBlob": { "ConnectionString": "UseDevelopmentStorage=true", "Container": "test" }
