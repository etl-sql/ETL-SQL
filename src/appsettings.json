    "MaxConcurrentJobs": 0
  },
  "ReportPlayer": {
    "Port": 5200,
    "ExecutionTimeoutSeconds": 300
  },
  "Session": {
    "StaleSessionRetentionDays": 7,
    "PersistentSessionTTLHours": 24,
    "PersistenceDefault": true,
    "Root": null
  },
  "Connectors": {
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelaySeconds": 1.0
    },
    "DataWarehouse": {
      "DefaultCommandTimeoutSeconds": 1800,
      "SchemaCacheTtlSeconds": 300
