<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Portal state model: PortalDbContext, entities, and the SQLite EF migration set. Extracted from
    the (Web SDK) ETL-SQL.ReportPortal app so a provider-specific PostgreSQL migrations assembly can
    reference the DbContext without a project-reference cycle (EF multi-provider migrations). The
    namespace stays ETL_SQL.ReportPortal.Data so no consumer code changes.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ETL-SQL.Core\ETL-SQL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
