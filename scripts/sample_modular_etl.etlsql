-- Test Procedure
CREATE PROCEDURE SayHello(@Name STRING) AS
BEGIN
    PRINT 'Hello, ' + @Name;
END;

EXECUTE SayHello 'Chuck';

-- Test Function
CREATE FUNCTION AddTen(@Val NUMERIC) RETURNS NUMERIC AS
BEGIN
    RETURN @Val + 10;
END;

SELECT AddTen(5) AS Result;

-- Test Scope Isolation
DECLARE @X INT = 100;

CREATE PROCEDURE ChangeX(@NewVal INT) AS
BEGIN
    DECLARE @X INT = @NewVal;
    PRINT 'Inside SP, @X = ' + CAST(@X AS STRING);
END;

EXECUTE ChangeX 500;
PRINT 'Outside SP, @X = ' + CAST(@X AS STRING); -- Should still be 100

-- Test Recursion
CREATE FUNCTION Factorial(@N NUMERIC) RETURNS NUMERIC AS
BEGIN
    IF @N <= 1 RETURN 1;
    RETURN @N * Factorial(@N - 1);
END;

SELECT Factorial(5) AS Res; -- Should be 120
