-- Verification of AllowedEnvVars stabilization
-- Authorized variable
PRINT 'Authorized (TEMP): ' + ENV('TEMP');

-- Unauthorized variable
BEGIN TRY
    PRINT 'Unauthorized (USERPROFILE): ' + ENV('USERPROFILE');
END TRY
BEGIN CATCH
    PRINT 'SECURITY_VIOLATION_CAUGHT: ' + ERROR_MESSAGE();
END CATCH
