#!/bin/sh
# Run the impact-selected pre-push validation (AGENTS.md section 19). Its source preflight alone
# would have stopped release candidate f5c4fd62a, which every hosted workflow then failed on.

set -eu

# Pushed from a worktree, Git hands the hook GIT_DIR and friends. Fixtures that `git init` a temp
# repo inherited them and rewrote the shared repository's config and refs (2026-11-04). The hook
# runs at the worktree root, so Git finds the right repository without them.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

# Git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per updated ref. A
# deletion has an all-zero local SHA and pushes no content, so there is nothing to validate.
zero=0000000000000000000000000000000000000000
content=no
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] || content=yes
done
[ "$content" = yes ] || exit 0

# The browser asset toolchain and several fixtures require Node.js 22; other majors fail them
# with unrelated-looking errors.
case "$(node --version 2>/dev/null)" in
    v22.*) ;;
    *)
        echo "pre-push: Node.js 22 is required on PATH (found: $(node --version 2>/dev/null || echo none))." >&2
        exit 1
        ;;
esac

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File ./scripts/Test-PrePush.ps1
else
    echo "pre-push: PowerShell 7 (pwsh) is required to run scripts/Test-PrePush.ps1." >&2
    exit 1
fi
