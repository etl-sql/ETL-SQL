-- Sample ETL-SQL script showing advanced functions
CREATE CONNECTION source_data ON FLATFILE('source.csv');
CREATE CONNECTION report_data ON FLATFILE('report.csv');

INSERT INTO report_data
SELECT 
    UPPER(column1) AS type_uppercase, 
    CONCAT(column2, '_processed') AS val_formatted,
    column3 * 2 + 50 AS calculated_metric
FROM source_data 
WHERE (column1 = 'Test' OR column1 = 'Other') AND column3 >= 50;
