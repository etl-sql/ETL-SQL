-- Test script for Hyper-Scale Spilling (Window & Grouping Sets)
-- We'll generate a large dataset using cross joins from MOCKDB

CREATE CONNECTION src ON MOCKDB();

-- 1. Generate ~100k rows
SELECT 
    U1.UserId, 
    U2.UserName, 
    U3.Email, 
    (U1.UserId % 10) as CategoryId
INTO #LargeSet
FROM src.Users U1 
CROSS JOIN (SELECT TOP 40 * FROM src.Users) U2
CROSS JOIN (SELECT TOP 40 * FROM src.Users) U3;

PRINT 'Generated ' + CAST(@@ROWCOUNT AS STRING) + ' rows for hyper-scale testing.';

-- 2. Verify Window Spilling
-- Trigger ExternalWindowEngine (Threshold is 100,000 in this task, but JoinSpillThreshold is context dependent)
SET JOIN_SPILL_THRESHOLD = 50000; -- Lower it to ensure spilling triggers

SELECT 
    UserId, 
    UserName,
    ROW_NUMBER() OVER(PARTITION BY CategoryId ORDER BY UserId) as RowNum,
    SUM(UserId) OVER(PARTITION BY CategoryId) as RunningSum
INTO #WindowResult
FROM #LargeSet;

PRINT 'Window function processing complete.';

-- 3. Verify Grouping Set Spilling (ROLLUP)
SELECT 
    CategoryId, 
    COUNT(*) as RowCount, 
    SUM(UserId) as TotalId
INTO #RollupResult
FROM #LargeSet
GROUP BY ROLLUP(CategoryId);

PRINT 'ROLLUP aggregation complete.';

-- Validate results
SELECT * FROM #RollupResult ORDER BY CategoryId;
