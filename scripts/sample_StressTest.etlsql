PRINT 'Starting Big Data Stress Test (1M rows)...';

-- Explicitly define connections for the files with correct TARGET syntax
CREATE CONNECTION BigData TYPE FLATFILE TARGET 'TestData/test_stress_BigTable.csv' WITH (HEADER = 'ON');
CREATE CONNECTION SmallData TYPE FLATFILE TARGET 'TestData/test_stress_SmallTable.csv' WITH (HEADER = 'ON');
CREATE CONNECTION ResultOut TYPE FLATFILE TARGET 'TestData/test_StressResult.csv' WITH (HEADER = 'ON');

-- Perform a large scale join
-- Using HASH JOIN to test the optimized streaming hash join
SELECT b.ID, s.Name, b.Value, b.Data
INTO ResultOut.Main
FROM BigData.Main b
INNER HASH JOIN SmallData.Main s ON b.ID = s.ID;

PRINT 'Stress Test Completed.';
