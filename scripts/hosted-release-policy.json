{
  "schemaVersion": 1,
  "maximumAgeHours": 168,
  "workflows": [
    {
      "file": "release-certification.yml",
      "events": [
        "workflow_dispatch"
      ],
      "jobPrefix": "Full CI / ",
      "fallback": {
        "file": "ci.yml",
        "events": [
          "push"
        ],
        "jobPrefix": ""
      },
      "nightlyFallback": {
        "file": "nightly-release.yml",
        "events": ["workflow_dispatch"],
        "jobPrefix": "Full CI / ",
        "releaseBranchesOnly": true
      },
      "jobs": [
        "Source preflight",
        "Build & Test",
        "Build Verification",
        "Portal Smoke & Security",
        "Engine Coverage (1/3)",
        "Engine Coverage (2/3)",
        "Engine Coverage (3/3)",
        "Browser and Consumer Contracts",
        "Build VS Code Extension",
        "Sample Scripts (windows)",
        "Sample Scripts (linux)",
        "Portal Browser Journey (1/3)",
        "Portal Browser Journey (2/3)",
        "Portal Browser Journey (3/3)",
        "Portal Browser Journey",
        "Studio Performance Budgets (windows)",
        "Studio Performance Budgets (linux)",
        "Studio Performance Budgets (macos)",
        "Enterprise Certification (windows)",
        "Enterprise Certification (linux)",
        "Docker Integration Tests"
      ]
    },
    {
      "file": "codeql.yml",
      "events": [
        "push",
        "workflow_dispatch"
      ],
      "jobs": [
        "Analyze (csharp)",
        "Analyze (javascript-typescript)"
      ]
    }
  ]
}
