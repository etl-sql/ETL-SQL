#!/bin/sh
# Pre-commit hook to format staged C# files automatically.

set -eu

# Find staged C# files.
STAGED_CS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')

if [ -z "$STAGED_CS_FILES" ]; then
    exit 0
fi

printf '%s\n' "$STAGED_CS_FILES" | while IFS= read -r file; do
    if ! git diff --quiet -- "$file"; then
        echo "Refusing to format partially staged file with unstaged edits: $file" >&2
        echo "Stage or stash the unstaged edits, then commit again." >&2
        exit 1
    fi
done

echo "Formatting staged C# files..."
printf '%s\n' "$STAGED_CS_FILES" | while IFS= read -r file; do
    dotnet format ETL-SQL.slnx --no-restore --include "$file"
    git add -- "$file"
done

exit 0
