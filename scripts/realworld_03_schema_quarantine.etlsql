/* 
    REAL-WORLD SCENARIO 3: Strict Schema Validation & Quarantine
    ------------------------------------------------------------
    Self-contained to create the inbound bad file first, then process it.
*/

CREATE TABLE #FileSpec (TransactionID VARCHAR(50), Amount DECIMAL(18,2), Status VARCHAR(10), CreatedAt DATETIME);

CREATE CONNECTION MockGenerator ON FLATFILE('TestData/inbound/partner_feed.csv') WITH (HEADER='ON');
INSERT INTO MockGenerator.Main (TransactionID, Amount, Status, CreatedAt) VALUES ('TXN100', 50.00, 'PAID', GETDATE());
INSERT INTO MockGenerator.Main (TransactionID, Amount, Status, CreatedAt) VALUES ('TXN101', -15.00, 'FAILED', GETDATE());
INSERT INTO MockGenerator.Main (TransactionID, Amount, Status, CreatedAt) VALUES ('TXN102', 0.00, 'INVALID', GETDATE());
INSERT INTO MockGenerator.Main (TransactionID, Amount, Status, CreatedAt) VALUES ('TXN103', 100.00, 'PENDING', GETDATE());

-- Force the file to adhere to strict schema
CREATE CONNECTION InboundFeed ON FLATFILE('TestData/inbound/partner_feed.csv') 
    WITH (HEADER = 'ON', STRICT_SCHEMA = 'ON', ERROR_POLICY = 'IGNORE');

SELECT * INTO #RawStage FROM InboundFeed.Main;

SELECT TransactionID, Amount, Status, CreatedAt INTO #CleanData FROM #RawStage
WHERE Amount > 0 AND STATUS IN ('PAID', 'PENDING', 'FAILED');

CREATE CONNECTION QuarantineFile ON FLATFILE('TestData/out/quarantine_log.csv') WITH(HEADER='ON');

SELECT TransactionID, Amount, Status, CreatedAt, 'Validation Failure' AS Reason INTO QuarantineFile.Main
FROM #RawStage
WHERE Amount <= 0 OR Amount IS NULL OR STATUS NOT IN ('PAID', 'PENDING', 'FAILED');

DECLARE @cleanCount INT = (SELECT COUNT(*) FROM #CleanData);
DECLARE @quarantineCount INT = (SELECT COUNT(*) FROM QuarantineFile.Main);

PRINT 'Ingestion Complete.';
PRINT CONCAT('Clean Records: ', @cleanCount);
PRINT CONCAT('Quarantined Records: ', @quarantineCount);

IF @quarantineCount > 0
BEGIN
    PRINT 'WARNING: Action required on quarantined records.';
END;
