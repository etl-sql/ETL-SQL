{
  "schemaVersion": 1,
  "lanes": [
    "source-preflight",
    "build-and-test",
    "browser-consumer-contracts",
    "build-vscode",
    "sample-scripts",
    "portal-browser-journey",
    "studio-performance-budgets",
    "enterprise-certification",
    "docker-integration-tests",
    "msi-upgrade"
  ],
  "always": ["source-preflight"],
  "rules": [
    {
      "name": "Planning and release documentation",
      "pattern": "^(?:(?:TODO|ROADMAP|CHANGELOG|AGENTS|CLAUDE|GEMINI)\\.md|docs/(?:releases|architecture)/.+\\.md)$",
      "lanes": [],
      "nativePackages": false
    },
    {
      "name": "VS Code extension source and tests",
      "pattern": "^src/etl-sql-vscode/(?:src|test|tests)/",
      "lanes": ["build-vscode"],
      "nativePackages": true
    },
    {
      "name": "VS Code UI source and browser consumers",
      "pattern": "^src/etl-sql-vscode/ui/src/",
      "lanes": ["browser-consumer-contracts", "build-vscode", "portal-browser-journey", "studio-performance-budgets"],
      "nativePackages": true
    },
    {
      "name": "Portal browser tests and their performance consumers",
      "pattern": "^tests/ETL-SQL\\.Portal\\.BrowserTests/.*\\.cs$",
      "lanes": ["portal-browser-journey", "studio-performance-budgets"],
      "nativePackages": false
    },
    {
      "name": "Core, runtime, shared UI, dependencies and unclassified files",
      "pattern": "^",
      "lanes": "*",
      "nativePackages": true
    }
  ]
}
