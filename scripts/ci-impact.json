{
  "schemaVersion": 1,
  "lanes": [
    "source-preflight",
    "build-and-test",
    "browser-consumer-contracts",
    "build-vscode",
    "sample-scripts",
    "portal-browser-journey",
    "studio-performance-budgets",
    "enterprise-certification",
    "docker-integration-tests",
    "engine-certification",
    "msi-upgrade"
  ],
  "testProjects": [
    "engine",
    "portal",
    "language-server"
  ],
  "always": ["source-preflight"],
  "rules": [
    {
      "name": "Planning and release documentation",
      "pattern": "^(?:(?:TODO|ROADMAP|CHANGELOG|AGENTS|CLAUDE|GEMINI)\\.md|docs/(?:releases|architecture)/.+\\.md)$",
      "lanes": [],
      "nativePackages": false
    },
    {
      "name": "Release evidence collectors and release workflow checks",
      "pattern": "^scripts/(?:collect-[\\w-]+\\.mjs|checks/test-(?:release|hosted|operator|collected|certified)[\\w-]*\\.mjs)$",
      "lanes": [],
      "nativePackages": false
    },
    {
      "name": "VS Code extension source and tests",
      "pattern": "^src/etl-sql-vscode/(?:src|test|tests)/",
      "lanes": ["build-vscode"],
      "nativePackages": true
    },
    {
      "name": "VS Code UI source and browser consumers",
      "pattern": "^src/etl-sql-vscode/ui/src/",
      "lanes": ["browser-consumer-contracts", "build-vscode", "portal-browser-journey", "studio-performance-budgets"],
      "nativePackages": true
    },
    {
      "name": "Portal browser tests and their performance consumers",
      "pattern": "^tests/ETL-SQL\\.Portal\\.BrowserTests/.*\\.cs$",
      "lanes": ["portal-browser-journey", "studio-performance-budgets"],
      "nativePackages": false
    },
    {
      "name": "MSI authoring and source validation",
      "pattern": "^(?:src/ETL-SQL\\.Installer/Installer\\.wxs|scripts/(?:Test-InstallerSources\\.ps1|checks/test-installer-sources\\.mjs))$",
      "lanes": ["msi-upgrade"],
      "nativePackages": false
    },
    {
      "name": "MSI certification scripts and focused fixtures",
      "pattern": "^scripts/(?:Test-Msi(?:Portal)?Upgrade\\.ps1|checks/(?:Test-Msi(?:Checkpoint|BackupEvidence)\\.ps1|test-msi-(?:candidate|build-watchdog)\\.mjs))$",
      "lanes": ["msi-upgrade"],
      "nativePackages": false
    },
    {
      "name": "Language server unit tests",
      "pattern": "^tests/ETL-SQL\\.LanguageServer\\.Tests/.*\\.cs$",
      "lanes": ["build-and-test"],
      "nativePackages": false
    },
    {
      "name": "Portal unit and integration tests",
      "pattern": "^tests/ETL-SQL\\.Portal\\.Tests/.*\\.cs$",
      "lanes": [
        "build-and-test",
        "enterprise-certification",
        "docker-integration-tests"
      ],
      "nativePackages": false
    },
    {
      "name": "Engine unit and integration tests",
      "pattern": "^tests/ETL-SQL\\.Tests/.*\\.cs$",
      "lanes": [
        "build-and-test",
        "enterprise-certification",
        "docker-integration-tests",
        "engine-certification"
      ],
      "nativePackages": false
    },
    {
      "name": "Core, runtime, shared UI, dependencies and unclassified files",
      "pattern": "^",
      "lanes": "*",
      "nativePackages": true
    }
  ],
  "testProjectRules": [
    {
      "name": "Language server source and unit tests",
      "pattern": "^(?:src/ETL-SQL\\.LanguageServer/|tests/ETL-SQL\\.LanguageServer\\.Tests/)",
      "projects": ["language-server"]
    },
    {
      "name": "Portal C# host and Portal unit tests",
      "pattern": "^(?:src/ETL-SQL\\.Portal/(?!BrowserSources/|wwwroot/)|tests/ETL-SQL\\.Portal\\.Tests/)",
      "projects": ["portal"]
    },
    {
      "name": "Engine unit tests",
      "pattern": "^tests/ETL-SQL\\.Tests/",
      "projects": ["engine"]
    },
    {
      "name": "Shared runtime, engine, and build inputs",
      "pattern": "^",
      "projects": "*"
    }
  ]
}
